#!/usr/bin/env bash
# macOS ships Bash 3.2, where nounset rejects expansion of a declared empty
# array. This command relies on empty policy/argv arrays as valid states.
set -eo pipefail

MUTAGEN_VERSION=0.18.1
# Mutagen's SSH transport connects with a 5-second ConnectTimeout. The Coder
# stdio proxy routinely needs ~8 s to reach a runner, so a daemon started with
# the default leaves resume in SYNC_FAILED. Mutagen reads this override only at
# daemon start, so ensure_mutagen_daemon restarts a daemon that lacks it.
MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS=${REMOTE_DEV_LOCAL_AGENT_MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS:-45}
LEASE_TTL_SECONDS=${REMOTE_DEV_LOCAL_AGENT_LEASE_TTL_SECONDS:-300}
WATCH_INTERVAL_SECONDS=${REMOTE_DEV_LOCAL_AGENT_WATCH_INTERVAL_SECONDS:-1}
HEARTBEAT_INTERVAL_SECONDS=${REMOTE_DEV_LOCAL_AGENT_HEARTBEAT_INTERVAL_SECONDS:-30}
LOCK_WAIT_ATTEMPTS=${REMOTE_DEV_LOCAL_AGENT_LOCK_WAIT_ATTEMPTS:-1200}
REMOTE_AUDIT_INTERVAL_SECONDS=${REMOTE_DEV_LOCAL_AGENT_REMOTE_AUDIT_INTERVAL_SECONDS:-120}
WATCHER_AUDIT_TIMEOUT_SECONDS=${REMOTE_DEV_LOCAL_AGENT_WATCHER_AUDIT_TIMEOUT_SECONDS:-90}
PREFLIGHT_TIMEOUT_SECONDS=${REMOTE_DEV_LOCAL_AGENT_PREFLIGHT_TIMEOUT_SECONDS:-30}
script_path=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
working_set_helper=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/remote-dev-local-agent-working-set.py
tracked_inventory_helper=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/remote-dev-tracked-inventory.py
workspace_helper=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/remote-dev-workspace
mode_guard=$(cd "$(dirname "${BASH_SOURCE[0]}")/../templates/docker" && pwd)/mode-guard.py

require_mode_authority() {
  python3 "$mode_guard" "$local_root"
}

require_remote_mode_authority() {
  local transport=${1:-remote_bash}
  # Execute the same read-only guard at the runner. Local HOME is not an
  # authority for a runner shared by several clients. Only the exact pending
  # operation may bypass its claim; inactive fences never accept old tokens.
  "$transport" 'exec /usr/bin/env REMOTE_DEV_MODE_OPERATION_ID="$1" REMOTE_DEV_MODE_TOKEN="$2" python3 -c "$3" "$4"' \
    "${REMOTE_DEV_MODE_OPERATION_ID:-}" "${REMOTE_DEV_MODE_TOKEN:-}" "$(cat "$mode_guard")" "$remote_root"
}

STANDARD_REMOTE_SCOPES=(
  node_modules .pnpm-store .yarn/cache .cache dist build coverage .next .nuxt .output target
)
STANDARD_MUTAGEN_IGNORES=(
  node_modules .pnpm-store '**/.yarn/cache' .cache dist build coverage .next .nuxt .output target
)

usage() {
  cat <<'EOF'
Usage: remote-dev-local-agent --profile <name> --coder-url <url> \
  up <workspace> --project-id <id> --local-project <absolute-git-root> \
  [--allow-untracked <path>] [--exclude-tracked <path>] \
  [--remote-writable <path>] [--git-metadata <mode>] \
  [--take-over-stale] [--recover-drift] [--recover-unknown]

       remote-dev-local-agent --profile <name> --coder-url <url> \
  up <workspace> --project-id <id> --working-set <absolute-manifest> \
  [--take-over-stale] [--recover-drift] [--recover-unknown]

       remote-dev-local-agent [--profile <name> --coder-url <url>] \
  <status|resume|exec|start> [<workspace>] [--for-context <absolute-path>] [options]
       remote-dev-local-agent [--profile <name> --coder-url <url>] \
  <logs|stop|restart> [<workspace>] [--for-context <absolute-path>] <handle>
       remote-dev-local-agent [--profile <name> --coder-url <url>] \
  down [<workspace>] [--for-context <absolute-path>]

       remote-dev-local-agent [--profile <name> --coder-url <url>] \
  retire --for-context <absolute-path>

Move a working-set binding onto a new anchor and member set (same runner/project):
       remote-dev-local-agent [--profile <name> --coder-url <url>] \
  reanchor <workspace> --project-id <id> --working-set <absolute-manifest> \
  --confirm-anchor <absolute-new-anchor> \
  (--for-context <absolute-path> | --retired-binding <dir> --confirm-retired <dir>)

Exec options: --timeout-seconds <seconds> [--receipt-fd <fd>] -- <argv...>
Start options: -- <argv...>

Add reviewed source to an existing single-root binding:
  allow-untracked --for-context <absolute-path> --path <exact-file> [--path <exact-file>]

The local Git checkout or explicit multi-repo working set is authoritative.
Commands run only in its dedicated Coder runner workspace and resolve their
remote cwd from the trusted local context. The remote workdir is not a
filesystem sandbox. Exec preserves stdout, stderr, and exit status.
EOF
}

fail() {
  printf '%s\n' "$*" >&2
  return 1
}

usage_error() {
  printf '%s\n' "$*" >&2
  usage >&2
  exit 2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'required local command is missing: %s\n' "$1" >&2
    exit 1
  }
}

validate_single_line() {
  local value=$1 label=$2
  if [[ -z $value || $value == *$'\n'* || $value == *$'\r'* || $value == *$'\t'* ]]; then
    printf '%s must be non-empty single-line text without tabs: %s\n' "$label" "$value" >&2
    return 1
  fi
}

validate_profile() {
  [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
    printf 'invalid profile name: %s\n' "$1" >&2
    return 1
  }
}

validate_workspace() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    printf 'invalid Coder workspace name: %s\n' "$1" >&2
    return 1
  }
}

validate_project_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    printf 'invalid local-agent project ID: %s\n' "$1" >&2
    return 1
  }
}

validate_relative_path() {
  local value=$1 label=$2 segment
  local -a segments=()
  validate_single_line "$value" "$label" || return 1
  if [[ $value = /* || $value = */ || $value = *//* ]]; then
    printf '%s must be a normalized relative path: %s\n' "$label" "$value" >&2
    return 1
  fi
  IFS=/ read -r -a segments <<<"$value"
  for segment in "${segments[@]}"; do
    if [[ -z $segment || $segment == . || $segment == .. ]]; then
      printf '%s contains an unsafe component: %s\n' "$label" "$value" >&2
      return 1
    fi
  done
  if [[ $value == .git || $value == .git/* ]]; then
    printf '%s must not select Git metadata: %s\n' "$label" "$value" >&2
    return 1
  fi
}

sha256_stream() {
  shasum -a 256 | awk '{print $1}'
}

sha256_file() {
  shasum -a 256 "$1" | awk '{print $1}'
}

canonical_git_root() {
  local requested=$1 physical git_root
  [[ $requested = /* ]] || fail "local project must be an absolute path: $requested" || return
  [[ -d $requested && ! -L $requested ]] || fail "local project must be a real directory: $requested" || return
  physical=$(cd "$requested" && pwd -P)
  git_root=$(git -C "$physical" rev-parse --show-toplevel 2>/dev/null) || {
    fail "local project is not a Git worktree: $physical"
    return
  }
  git_root=$(cd "$git_root" && pwd -P)
  [[ $physical == "$git_root" ]] || {
    fail "local project must be the exact Git root: $git_root"
    return
  }
  printf '%s\n' "$git_root"
}

binding_value() {
  local key=$1 file=${2:-$binding_file}
  awk -F '\t' -v key="$key" '$1 == key { sub(/^[^\t]*\t/, ""); print; found = 1; exit } END { if (!found) exit 1 }' "$file"
}

write_atomic() {
  local destination=$1 mode=${2:-0600} parent temp
  parent=$(dirname "$destination")
  mkdir -p "$parent"
  temp=$(mktemp "$parent/.remote-dev-state.XXXXXX")
  cat > "$temp"
  chmod "$mode" "$temp"
  mv "$temp" "$destination"
}

process_start_token() {
  ps -p "$1" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true
}

identity_matches_binding() {
  local file=$1 expected_pid=${2:-} recorded_pid
  [[ -f $file && ! -L $file ]] || return 1
  [[ $(binding_value schema "$file" 2>/dev/null || true) == 1 ]] || return 1
  recorded_pid=$(binding_value pid "$file" 2>/dev/null || true)
  [[ $recorded_pid =~ ^[0-9]+$ ]] || return 1
  [[ -z $expected_pid || $recorded_pid == "$expected_pid" ]] || return 1
  [[ $(binding_value owner_id "$file" 2>/dev/null || true) == "$owner_id" && \
     $(binding_value project_id "$file" 2>/dev/null || true) == "$project_id" && \
     $(binding_value profile "$file" 2>/dev/null || true) == "$profile" && \
     $(binding_value workspace "$file" 2>/dev/null || true) == "$workspace" && \
     $(binding_value root_hash "$file" 2>/dev/null || true) == "$root_hash" && \
     $(binding_value local_root "$file" 2>/dev/null || true) == "$local_root" ]] || return 1
}

live_identity_matches() {
  local file=$1 expected_pid=${2:-} pid expected actual
  identity_matches_binding "$file" "$expected_pid" || return 1
  pid=$(binding_value pid "$file")
  expected=$(binding_value start_token "$file" 2>/dev/null || true)
  [[ -n $expected ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  actual=$(process_start_token "$pid")
  [[ -n $actual && $actual == "$expected" ]]
}

write_local_process_identity() {
  local destination=$1 pid=$2 start_token=$3
  printf 'schema\t1\npid\t%s\nstart_token\t%s\nowner_id\t%s\nproject_id\t%s\nprofile\t%s\nworkspace\t%s\nroot_hash\t%s\nlocal_root\t%s\n' \
    "$pid" "$start_token" "$owner_id" "$project_id" "$profile" "$workspace" \
    "$root_hash" "$local_root" | write_atomic "$destination"
}

state_root=${REMOTE_DEV_LOCAL_AGENT_STATE_ROOT:-$HOME/Library/Application Support/remote-dev/local-agent}
profile=
coder_origin=
workspace=
project_id=
local_root=
remote_root=
ssh_alias=
root_hash=
binding_dir=
binding_file=
policy_file=
managed_manifest=
excluded_manifest=
projection_root=
mutagen_session=
owner_id=
remote_control=
workspace_control=/home/coder/.local/share/remote-dev/local-agent-workspace
current_receipt=
binding_kind=single-root
git_metadata_mode=not-required
declare -a inventory_environment=()
topology_file=
topology_digest=
execution_member=root
member_digests=
resolved_member=root
resolved_local_cwd=
remote_cwd=
coder_config=
declare -a coder_command=()

load_binding_dir() {
  binding_dir=$1
  binding_file=$binding_dir/binding.tsv
  [[ -f $binding_file && ! -L $binding_file ]] || fail "local-agent binding is missing: $binding_file" || return
  [[ $(binding_value schema) == 1 ]] || fail "unsupported local-agent binding schema" || return
  project_id=$(binding_value project_id)
  workspace=$(binding_value workspace)
  local bound_role
  bound_role=$(binding_value workspace_role)
  [[ $bound_role == runner ]] || fail "WORKSPACE_ROLE_MISMATCH: binding role is $bound_role, expected runner" || return
  local bound_profile bound_origin
  bound_profile=$(binding_value profile)
  bound_origin=$(binding_value coder_origin)
  if [[ -n $profile && $profile != "$bound_profile" ]]; then
    fail "binding profile mismatch: expected $bound_profile, got $profile"
    return
  fi
  if [[ -n $coder_origin && $coder_origin != "$bound_origin" ]]; then
    fail "binding Coder origin mismatch: expected $bound_origin, got $coder_origin"
    return
  fi
  profile=$bound_profile
  coder_origin=$bound_origin
  ssh_alias=$(binding_value ssh_alias)
  local_root=$(binding_value local_root)
  remote_root=$(binding_value remote_root)
  root_hash=$(binding_value root_hash)
  mutagen_session=$(binding_value mutagen_session)
  owner_id=$(binding_value owner_id)
  remote_control=$(binding_value remote_control)
  policy_file=$(binding_value projection_policy_path)
  managed_manifest=$(binding_value managed_manifest_path)
  excluded_manifest=$(binding_value excluded_manifest_path)
  current_receipt=$(binding_value current_receipt_path)
  binding_kind=$(binding_value binding_kind 2>/dev/null || printf 'single-root')
  git_metadata_mode=$(binding_value git_metadata_mode 2>/dev/null || printf 'not-required')
  case "$git_metadata_mode" in not-required|explicit-input) ;; *) fail 'BINDING_METADATA_MODE_INVALID'; return 1 ;; esac
  topology_file=$(binding_value topology_path 2>/dev/null || true)
  topology_digest=$(binding_value topology_digest 2>/dev/null || true)
  execution_member=$(binding_value execution_member 2>/dev/null || printf 'root')
  member_digests=$(binding_value member_digests_path 2>/dev/null || printf '%s/member_digests.tsv' "$binding_dir")
  projection_root=$binding_dir/projection
  for required in "$policy_file"; do
    [[ -f $required && ! -L $required ]] || fail "binding policy is missing: $required" || return
  done
  local actual_root actual_hash
  case "$binding_kind" in
    single-root)
      actual_root=$(canonical_git_root "$local_root") || return
      ;;
    working-set)
      [[ -f $topology_file && ! -L $topology_file ]] || fail "working-set snapshot is missing: $topology_file" || return
      actual_root=$(cd "$local_root" 2>/dev/null && pwd -P) || fail "working-set anchor is unavailable: $local_root" || return
      [[ $actual_root == "$local_root" ]] || fail 'working-set anchor no longer resolves to its original directory' || return
      [[ $(binding_value topology_digest "$topology_file" 2>/dev/null || true) == "$topology_digest" ]] || \
        fail 'working-set binding topology digest does not match its stored snapshot' || return
      ;;
    *) fail "unsupported local-agent binding kind: $binding_kind" || return ;;
  esac
  actual_hash=$(printf '%s' "$actual_root" | sha256_stream)
  [[ $actual_root == "$local_root" && $actual_hash == "$root_hash" ]] || {
    fail 'local-agent binding no longer resolves to its original Git root'
    return
  }
}

canonical_context_path() {
  local requested=$1 physical
  [[ $requested = /* ]] || fail "local context must be an absolute path: $requested" || return
  [[ -e $requested && ! -L $requested ]] || fail "local context must exist and not be a symlink: $requested" || return
  [[ -d $requested ]] || requested=$(dirname "$requested")
  physical=$(cd "$requested" && pwd -P) || return
  printf '%s\n' "$physical"
}

load_binding_for_context() {
  local requested=$1 canonical candidate hash claim claimed_dir=
  canonical=$(canonical_context_path "$requested") || return
  candidate=$canonical
  while [[ $candidate == /* ]]; do
    hash=$(printf '%s' "$candidate" | sha256_stream)
    claim=$state_root/bindings/by-context/$hash.claim
    if [[ -e $claim ]]; then
      [[ -f $claim && ! -L $claim ]] || fail "context claim is not a regular file: $claim" || return
      IFS= read -r claimed_dir < "$claim"
      break
    fi
    [[ $candidate != / ]] || break
    candidate=$(dirname "$candidate")
  done
  if [[ -n $claimed_dir && $candidate != "$canonical" ]]; then
    # A Git root nested below the claimed directory (a linked worktree or a
    # separate repository) is never projected by that binding; refuse instead
    # of routing its commands to the enclosing runner.
    local context_root
    context_root=$(git -C "$canonical" rev-parse --show-toplevel 2>/dev/null || true)
    [[ -z $context_root ]] || context_root=$(cd "$context_root" && pwd -P)
    if [[ -n $context_root && $context_root == "$candidate"/* ]]; then
      fail "NESTED_WORKTREE_UNBOUND: $context_root is a separate Git root inside the binding at $candidate; bind it with local-agent up --local-project $context_root"
      return
    fi
  fi
  if [[ -z $claimed_dir ]]; then
    # Backward compatibility for pre-working-set single-root bindings.
    local git_root
    git_root=$(git -C "$canonical" rev-parse --show-toplevel 2>/dev/null || true)
    if [[ -n $git_root ]]; then
      git_root=$(cd "$git_root" && pwd -P)
      hash=$(printf '%s' "$git_root" | sha256_stream)
      [[ -f $state_root/bindings/by-root/$hash/binding.tsv ]] && claimed_dir=$state_root/bindings/by-root/$hash
    fi
  fi
  [[ -n $claimed_dir ]] || fail "local context has no Local Agent binding: $canonical" || return
  load_binding_dir "$claimed_dir" || return
  resolved_local_cwd=$canonical
  if [[ $binding_kind == working-set ]]; then
    local context_output
    context_output=$(python3 "$working_set_helper" context --snapshot "$topology_file" \
      --path "$canonical" --remote-root "$remote_root") || return
    resolved_member=$(printf '%s\n' "$context_output" | awk -F '\t' '$1 == "member" {print $2; exit}')
    remote_cwd=$(printf '%s\n' "$context_output" | awk -F '\t' '$1 == "remote_cwd" {print $2; exit}')
  else
    resolved_member=root
    local relative
    relative=${canonical#"$local_root"}
    [[ $canonical == "$local_root" || $relative == /* ]] || fail 'resolved context escaped its binding root' || return
    remote_cwd=$remote_root$relative
  fi
  [[ $remote_cwd == "$remote_root" || $remote_cwd == "$remote_root"/* ]] || fail 'resolved remote cwd escaped its runner root' || return
}

load_binding_for_root() {
  local requested=$1 canonical hash
  canonical=$(canonical_git_root "$requested") || return
  hash=$(printf '%s' "$canonical" | sha256_stream)
  load_binding_dir "$state_root/bindings/by-root/$hash"
  [[ $local_root == "$canonical" ]] || fail 'binding root hash collision or stale binding detected' || return
}

load_binding_for_workspace() {
  local requested_workspace=$1 claim
  [[ -n $profile ]] || fail 'workspace lookup requires --profile; use --for-root for MCP/root-bound execution' || return
  validate_workspace "$requested_workspace" || return
  claim=$state_root/bindings/by-runner/$profile/$requested_workspace.claim
  [[ -f $claim && ! -L $claim ]] || fail "runner has no local binding: $profile/$requested_workspace" || return
  local claimed_dir
  IFS= read -r claimed_dir < "$claim"
  load_binding_dir "$claimed_dir"
  [[ $workspace == "$requested_workspace" ]] || fail 'runner claim points to a different workspace' || return
  resolved_local_cwd=$local_root
  if [[ $binding_kind == working-set ]]; then
    local context_output
    context_output=$(python3 "$working_set_helper" context --snapshot "$topology_file" \
      --path "$local_root" --remote-root "$remote_root") || return
    resolved_member=$(printf '%s\n' "$context_output" | awk -F '\t' '$1 == "member" {print $2; exit}')
    remote_cwd=$(printf '%s\n' "$context_output" | awk -F '\t' '$1 == "remote_cwd" {print $2; exit}')
  else
    resolved_member=root
    remote_cwd=$remote_root
  fi
}

created_binding_claims=()
claim_lock=
acquire_claim_lock() {
  local lock=$state_root/bindings/claims.lock token attempt
  mkdir -p "$state_root/bindings"
  for attempt in $(seq 1 300); do
    if mkdir "$lock" 2>/dev/null; then
      token=$(process_start_token "$$")
      [[ -n $token ]] || { rmdir "$lock"; fail 'LOCAL_BINDING_CLAIM_LOCK_IDENTITY_UNAVAILABLE'; return 77; }
      printf 'pid\t%s\nstart_token\t%s\n' "$$" "$token" | write_atomic "$lock/owner.tsv"
      claim_lock=$lock
      return 0
    fi
    sleep 0.1
  done
  fail "LOCAL_BINDING_CLAIM_LOCK_BUSY: inspect $lock and confirm no Local Agent binding operation is active"
  return 77
}

release_claim_lock() {
  [[ -n ${claim_lock:-} ]] || return 0
  local owner=$claim_lock/owner.tsv
  if [[ -f $owner && ! -L $owner && $(binding_value pid "$owner" 2>/dev/null || true) == "$$" && \
        $(binding_value start_token "$owner" 2>/dev/null || true) == "$(process_start_token "$$")" ]]; then
    rm -f "$owner"
    rmdir "$claim_lock" 2>/dev/null || true
  fi
  claim_lock=
}

claim_binding_contexts() {
  local runner_claim=$state_root/bindings/by-runner/$profile/$workspace.claim claimed path hash claim legacy claim_index=0
  local -a contexts=("$@") claims=()
  acquire_claim_lock || return
  mkdir -p "$state_root/bindings/by-context" "$state_root/bindings/by-runner/$profile"
  if [[ -e $runner_claim ]]; then
    [[ -f $runner_claim && ! -L $runner_claim ]] || { fail "runner claim is not a regular file: $runner_claim"; return 1; }
    IFS= read -r claimed < "$runner_claim"
    [[ $claimed == "$binding_dir" ]] || { fail 'runner is already claimed by another local binding'; return 1; }
  else
    claims+=("$runner_claim")
  fi
  for path in "${contexts[@]}"; do
    hash=$(printf '%s' "$path" | sha256_stream)
    claim=$state_root/bindings/by-context/$hash.claim
    legacy=$state_root/bindings/by-root/$hash/binding.tsv
    if [[ -e $claim ]]; then
      [[ -f $claim && ! -L $claim ]] || { fail "context claim is not a regular file: $claim"; return 1; }
      IFS= read -r claimed < "$claim"
      [[ $claimed == "$binding_dir" ]] || { fail "LOCAL_CONTEXT_ALREADY_BOUND: $path"; return 1; }
    else
      claims+=("$claim")
    fi
    if [[ -e $legacy && $(dirname "$legacy") != "$binding_dir" ]]; then
      fail "LOCAL_CONTEXT_ALREADY_BOUND: existing single-root binding owns $path"
      return 1
    fi
  done
  for claim in "${claims[@]}"; do
    printf '%s\n' "$binding_dir" | write_atomic "$claim"
    created_binding_claims+=("$claim")
    claim_index=$((claim_index + 1))
    if [[ ${REMOTE_DEV_LOCAL_AGENT_TEST_FAIL_CLAIM_AFTER:-0} == "$claim_index" ]]; then
      fail 'LOCAL_BINDING_CLAIM_TEST_FAILURE'
      return 97
    fi
  done
  release_claim_lock
}

retire_working_set_binding() {
  [[ $binding_kind == working-set ]] || return 0
  retire_binding WORKING_SET
}

# Release a down binding's context and runner claims and move its directory
# aside. Both topology retirement and an explicit re-anchor need this: the
# runner claim names one binding directory, so a second one cannot take the
# workspace until the first releases it.
retire_binding() {
  local prefix=${1:-BINDING}
  local runner_claim=$state_root/bindings/by-runner/$profile/$workspace.claim path hash claim claimed retired
  local -a contexts=("$local_root")
  if [[ $binding_kind == working-set ]]; then
    while IFS=$'\t' read -r key member_id member_root member_remote member_mode; do
      [[ $key == member ]] || continue
      contexts+=("$member_root")
    done < "$topology_file"
  fi
  acquire_claim_lock || return
  for path in "${contexts[@]}"; do
    hash=$(printf '%s' "$path" | sha256_stream)
    claim=$state_root/bindings/by-context/$hash.claim
    [[ -f $claim && ! -L $claim ]] || { fail "${prefix}_RETIRE_CLAIM_INVALID: $claim"; return 77; }
    IFS= read -r claimed < "$claim"
    [[ $claimed == "$binding_dir" ]] || { fail "${prefix}_RETIRE_CLAIM_MISMATCH: $path"; return 77; }
  done
  [[ -f $runner_claim && ! -L $runner_claim ]] || { fail "${prefix}_RETIRE_RUNNER_CLAIM_INVALID: $runner_claim"; return 77; }
  IFS= read -r claimed < "$runner_claim"
  [[ $claimed == "$binding_dir" ]] || { fail "${prefix}_RETIRE_RUNNER_CLAIM_MISMATCH"; return 77; }
  for path in "${contexts[@]}"; do
    hash=$(printf '%s' "$path" | sha256_stream)
    rm -f "$state_root/bindings/by-context/$hash.claim"
  done
  rm -f "$runner_claim"
  retired=$state_root/retired/$(date +%Y%m%dT%H%M%S)-${root_hash:0:16}
  mkdir -p "$state_root/retired"
  [[ $binding_dir == "$state_root/bindings/by-root/"* && ! -e $retired ]] || {
    fail "${prefix}_RETIRE_PATH_INVALID"
    return 77
  }
  mv "$binding_dir" "$retired"
  release_claim_lock
  printf 'Retired       %s\n' "$retired"
}

assert_topology_current() {
  [[ $binding_kind == working-set ]] || return 0
  python3 "$working_set_helper" verify --snapshot "$topology_file" >/dev/null
}

ensure_platform() {
  [[ $(uname -s) == Darwin || ${REMOTE_DEV_LOCAL_AGENT_ALLOW_NON_DARWIN:-false} == true ]] || {
    fail 'local-agent currently supports the macOS operator client.'
    return
  }
  for required in coder git mutagen python3 shasum ssh mktemp gzip; do
    require_command "$required"
  done
  local mutagen_output
  mutagen_output=$(mutagen version 2>/dev/null) || {
    fail 'Mutagen is unavailable. Install Remote Dev Mutagen 0.18.1 and retry.'
    return
  }
  mutagen_output=${mutagen_output//$'\r'/}
  mutagen_output=${mutagen_output%$'\n'}
  [[ $mutagen_output == "$MUTAGEN_VERSION" ]] || {
    fail "unsupported Mutagen version: $mutagen_output (required $MUTAGEN_VERSION)"
    return
  }
  ensure_mutagen_daemon
}

mutagen_daemon_pid() {
  pgrep -u "$(id -u)" -f '(^|/)mutagen daemon run$' 2>/dev/null | head -1
}

mutagen_daemon_connect_timeout() {
  # Print the MUTAGEN_SSH_CONNECT_TIMEOUT the running daemon was started with.
  local pid=$1
  if [[ -r /proc/$pid/environ ]]; then
    tr '\0' '\n' < "/proc/$pid/environ"
  else
    ps -E -o command= -p "$pid" 2>/dev/null | tr ' ' '\n'
  fi | awk -F= '$1 == "MUTAGEN_SSH_CONNECT_TIMEOUT" {value = $2} END {print value}'
}

ensure_mutagen_daemon() {
  local marker=$state_root/mutagen-daemon.tsv pid= observed= recorded_pid= recorded_timeout=
  [[ $MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS =~ ^[0-9]+$ && $MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS -ge 5 ]] || {
    fail "REMOTE_DEV_LOCAL_AGENT_MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS must be an integer of at least 5: $MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS"
    return
  }
  pid=$(mutagen_daemon_pid || true)
  if [[ -n $pid ]]; then
    observed=$(mutagen_daemon_connect_timeout "$pid")
    if [[ -z $observed && -f $marker && ! -L $marker ]]; then
      # The process environment is unreadable here; trust only a marker written
      # for this exact daemon so an unreadable environment cannot restart it
      # on every command.
      recorded_pid=$(awk -F '\t' '$1 == "pid" {print $2}' "$marker")
      recorded_timeout=$(awk -F '\t' '$1 == "ssh_connect_timeout" {print $2}' "$marker")
      [[ $recorded_pid == "$pid" ]] && observed=$recorded_timeout
    fi
    if [[ $observed != "$MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS" ]]; then
      mutagen daemon stop >/dev/null 2>&1 || {
        fail "Mutagen daemon (pid $pid) runs with SSH connect timeout '${observed:-default}' and could not be stopped. Run \`mutagen daemon stop\` and retry."
        return
      }
      # `daemon stop` returns before the daemon exits. Starting immediately
      # would report the old daemon as already running, and the next Mutagen
      # command would autostart a daemon without the override.
      for (( attempt = 0; attempt < 50; attempt++ )); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
      done
      ! kill -0 "$pid" 2>/dev/null || {
        fail "Mutagen daemon (pid $pid) did not exit after \`mutagen daemon stop\`. Stop it and retry."
        return
      }
    fi
  fi
  MUTAGEN_SSH_CONNECT_TIMEOUT=$MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS mutagen daemon start >/dev/null 2>&1 || {
    fail 'Mutagen daemon did not start. Run `mutagen daemon start`, inspect its diagnostics, and retry.'
    return
  }
  pid=$(mutagen_daemon_pid || true)
  [[ -n $pid ]] || return 0
  observed=$(mutagen_daemon_connect_timeout "$pid")
  [[ -z $observed || $observed == "$MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS" ]] || {
    fail "Mutagen daemon (pid $pid) started with SSH connect timeout '$observed' instead of $MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS. Run \`mutagen daemon stop\` and retry."
    return
  }
  mkdir -p "$state_root"
  printf 'pid\t%s\nssh_connect_timeout\t%s\n' "$pid" "$MUTAGEN_SSH_CONNECT_TIMEOUT_SECONDS" > "$marker"
}

ensure_coder_context() {
  validate_profile "$profile" || return
  # HTTPS for a published Coder, or the Mac end of an SSH forward.
  [[ $coder_origin == https://* || $coder_origin =~ ^http://127\.0\.0\.1:[0-9]+$ ]] || \
    fail "local-agent requires an HTTPS or SSH-forward Coder URL: $coder_origin" || return
  local coder_bin config_root url_file temp
  coder_bin=$(command -v coder)
  config_root=${REMOTE_DEV_CODEX_DESKTOP_CONFIG_ROOT:-$HOME/Library/Application Support/remote-dev/coder}
  coder_config=$config_root/$profile
  url_file=$coder_config/url
  umask 077
  mkdir -p "$coder_config"
  chmod 0700 "$coder_config"
  if [[ -L $url_file || ( -e $url_file && ! -f $url_file ) ]]; then
    fail "refusing non-regular Coder URL state: $url_file"
    return
  fi
  if [[ ! -f $url_file || $(<"$url_file") != "$coder_origin" ]]; then
    temp=$(mktemp "$coder_config/.url.XXXXXX")
    printf '%s\n' "$coder_origin" > "$temp"
    chmod 0600 "$temp"
    mv "$temp" "$url_file"
  fi
  coder_command=("$coder_bin" --no-version-warning --global-config "$coder_config")
  local context_status=0
  bounded_command "$PREFLIGHT_TIMEOUT_SECONDS" "${coder_command[@]}" \
    --url "$coder_origin" whoami >/dev/null 2>&1 || context_status=$?
  if (( context_status != 0 )); then
    cat >&2 <<EOF
CODER_CONTEXT_UNAVAILABLE: could not verify $coder_origin (exit $context_status).
Recovery: check network access to this Coder deployment, then retry status.
If the session expired, sign in from an interactive Mac Terminal:
  coder --global-config "$coder_config" login "$coder_origin"
EOF
    return "$context_status"
  fi
  prepare_ssh_transport
}

ssh_transport_dir=
ssh_transport_command=()
prepare_ssh_transport() {
  case ${REMOTE_DEV_LOCAL_AGENT_TRANSPORT:-multiplex} in
    direct) return 0 ;;
    multiplex) ;;
    *) fail 'TRANSPORT_INVALID: expected multiplex or direct'; return 2 ;;
  esac
  [[ -z $ssh_transport_dir ]] || return 0
  # Keep the Unix socket below the macOS path limit and private to this process.
  # A connection is reused, never role, lease, recovery or manifest evidence.
  ssh_transport_dir=$(mktemp -d /tmp/remote-dev-ssh.XXXXXX) || return
  chmod 0700 "$ssh_transport_dir"
  local proxy_command
  proxy_command=$(python3 -c 'import shlex,sys; print(shlex.join(sys.argv[1:]).replace("%", "%%"))' \
    "${coder_command[@]}" --url "$coder_origin" ssh --stdio --disable-autostart --wait=no "$workspace") || return
  ssh_transport_command=(ssh -F /dev/null -T -o BatchMode=yes
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR
    -o "ProxyCommand=$proxy_command" -o ControlMaster=auto -o ControlPersist=60
    -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -S "$ssh_transport_dir/control")
  # Host authentication is supplied by the authenticated Coder stdio proxy,
  # matching Coder's generated OpenSSH contract; user SSH config is not read.
}

cleanup_ssh_transport() {
  [[ -n $ssh_transport_dir ]] || return 0
  ssh -F /dev/null -S "$ssh_transport_dir/control" -O exit "$workspace" >/dev/null 2>&1 || true
  rm -f "$ssh_transport_dir/control"
  rmdir "$ssh_transport_dir" 2>/dev/null || true
  ssh_transport_dir=
  ssh_transport_command=()
}

ensure_ssh_alias() {
  local config_root ssh_dir ssh_config ssh_fragment include_line temp
  config_root=${REMOTE_DEV_CODEX_DESKTOP_CONFIG_ROOT:-$HOME/Library/Application Support/remote-dev/coder}
  ssh_dir=$HOME/.ssh
  ssh_config=$ssh_dir/config
  ssh_fragment=$ssh_dir/remote-dev-$profile.conf
  include_line="Include \"$ssh_fragment\""
  mkdir -p "$ssh_dir"
  chmod 0700 "$ssh_dir"
  if [[ -L $ssh_config || ( -e $ssh_config && ! -f $ssh_config ) || \
        -L $ssh_fragment || ( -e $ssh_fragment && ! -f $ssh_fragment ) ]]; then
    fail 'refusing non-regular SSH configuration state'
    return
  fi
  "${coder_command[@]}" --url "$coder_origin" config-ssh \
    --disable-autostart --wait=no \
    --no-wildcard \
    --ssh-host-prefix "$profile." \
    --hostname-suffix "$profile.coder" \
    --ssh-config-file "$ssh_fragment" \
    --yes >/dev/null
  if grep -Eq '^[[:space:]]*ProxyCommand .*coder --global-config([[:space:]]|$)' "$ssh_fragment"; then
    temp=$(mktemp "$ssh_dir/.remote-dev-coder-proxy.XXXXXX")
    awk '{ sub(/coder --global-config/, "coder --no-version-warning --global-config"); print }' \
      "$ssh_fragment" > "$temp"
    chmod 0600 "$temp"
    mv "$temp" "$ssh_fragment"
  fi
  chmod 0600 "$ssh_fragment"
  grep -Fxq "Host $ssh_alias" "$ssh_fragment" || {
    fail "Coder SSH configuration omitted concrete runner alias: $ssh_alias"
    return
  }
  if [[ ! -e $ssh_config ]]; then
    : > "$ssh_config"
    chmod 0600 "$ssh_config"
  fi
  if ! grep -Fxq "$include_line" "$ssh_config"; then
    temp=$(mktemp "$ssh_dir/.remote-dev-ssh.XXXXXX")
    awk -v include_line="$include_line" '
      BEGIN { inserted = 0 }
      !inserted && /^[[:space:]]*(Host|Match)[[:space:]]/ {
        print include_line; print ""; inserted = 1
      }
      { print }
      END { if (!inserted) { if (NR > 0) print ""; print include_line } }
    ' "$ssh_config" > "$temp"
    chmod 0600 "$temp"
    mv "$temp" "$ssh_config"
  fi
  ssh -F "$ssh_config" -G "$ssh_alias" >/dev/null
}

coder_ssh() {
  local remote_command
  printf -v remote_command ' %q' "$@"
  if [[ -n $ssh_transport_dir ]]; then
    "${ssh_transport_command[@]}" "$workspace" "$remote_command"
    return $?
  fi
  "${coder_command[@]}" --url "$coder_origin" ssh \
    --disable-autostart --wait=no "$workspace" -- "$remote_command"
}

bounded_transport_pid=
cancel_bounded_transport() {
  local pid=${bounded_transport_pid:-} attempt
  [[ $pid =~ ^[0-9]+$ ]] || { bounded_transport_pid=; return 0; }
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    for attempt in $(seq 1 100); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.05
    done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
  fi
  wait "$pid" 2>/dev/null || true
  bounded_transport_pid=
}

bounded_command() {
  local timeout_seconds=$1 status
  shift
  [[ $timeout_seconds =~ ^[1-9][0-9]*$ ]] || {
    fail 'TRANSPORT_TIMEOUT_INVALID: expected a positive integer number of seconds'
    return 2
  }
  python3 -c '
import os
import signal
import subprocess
import sys

timeout = int(sys.argv[1])
process = subprocess.Popen(sys.argv[2:], start_new_session=True)

def stop(signum, _frame):
    try:
        os.killpg(process.pid, signum)
        process.wait(timeout=5)
    except ProcessLookupError:
        pass
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()
    raise SystemExit(128 + signum)

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
try:
    raise SystemExit(process.wait(timeout=timeout))
except subprocess.TimeoutExpired:
    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=5)
    except ProcessLookupError:
        pass
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()
    raise SystemExit(124)
' "$timeout_seconds" "$@" <&0 &
  bounded_transport_pid=$!
  if wait "$bounded_transport_pid"; then status=0; else status=$?; fi
  bounded_transport_pid=
  return "$status"
}

coder_ssh_bounded() {
  local timeout_seconds=$1 remote_command
  shift
  printf -v remote_command ' %q' "$@"
  if [[ -n $ssh_transport_dir ]]; then
    bounded_command "$timeout_seconds" "${ssh_transport_command[@]}" "$workspace" "$remote_command"
    return $?
  fi
  bounded_command "$timeout_seconds" "${coder_command[@]}" --url "$coder_origin" ssh \
    --disable-autostart --wait=no "$workspace" -- "$remote_command"
}

coder_workspace_is_stopped() {
  local status_file status=1
  status_file=$(mktemp "$binding_dir/.workspace-status.XXXXXX") || return 1
  projection_temps+=("$status_file")
  if bounded_command "$PREFLIGHT_TIMEOUT_SECONDS" "${coder_command[@]}" --url "$coder_origin" \
      list --search "owner:me name:$workspace" --output json > "$status_file" 2>/dev/null; then
    python3 -c '
import json, sys
with open(sys.argv[2]) as stream:
    rows = json.load(stream)
matches = [row for row in rows if isinstance(row, dict) and row.get("name") == sys.argv[1]]
raise SystemExit(0 if len(matches) == 1 and matches[0].get("latest_build", {}).get("status") == "stopped" else 1)
' "$workspace" "$status_file" 2>/dev/null && status=0
  fi
  rm -f "$status_file"
  return "$status"
}

require_runner_role() {
  local output status=0
  if output=$(coder_ssh_bounded "$PREFLIGHT_TIMEOUT_SECONDS" /usr/local/bin/remote-dev-workspace-role require runner 2>&1); then
    :
  else
    status=$?
  fi
  if (( status != 0 )) && [[ $output != *WORKSPACE_ROLE_MISMATCH* && $output != *WORKSPACE_ROLE_INVALID* ]] &&
      { [[ $output == *'workspace must be started'* || $output == *'Workspace must be started'* || $output == *'workspace is stopped'* ]] || coder_workspace_is_stopped; }; then
    cat >&2 <<EOF
WORKSPACE_STOPPED: $profile/$workspace is not running.
Recovery: use runner_resume, or run bin/remote-dev local-agent resume --for-context "$resolved_local_cwd"
EOF
    return 1
  fi
  if (( status != 0 )) && [[ $output != *WORKSPACE_ROLE_MISMATCH* && $output != *WORKSPACE_ROLE_INVALID* ]]; then
    [[ -z $output ]] || printf '%s\n' "$output" >&2
    cat >&2 <<EOF
RUNNER_UNREACHABLE: could not verify $profile/$workspace (exit $status).
Recovery: check Coder connectivity and the workspace agent, then retry status.
Preserve the existing binding; this failure does not establish a role mismatch.
EOF
    return "$status"
  fi
  if [[ $output == *WORKSPACE_ROLE_INVALID* ]]; then
    printf '%s\n' "$output" >&2
    fail 'Recovery: inspect the immutable role marker and workspace startup log before retrying.'
    return 1
  fi
  if (( status != 0 )) || [[ $output != 'workspace_role=runner' ]]; then
    [[ -z $output ]] || printf '%s\n' "$output" >&2
    cat >&2 <<EOF
WORKSPACE_ROLE_MISMATCH: $profile/$workspace is not a verified runner workspace.
Recovery: create a dedicated runner workspace; roles cannot be changed in place.
EOF
    return 1
  fi
}

remote_bash() {
  local script=$1
  shift
  coder_ssh /usr/bin/env bash -c "$script" remote-dev-local-agent "$@"
}

remote_bash_bounded() {
  local script=$1 local_timeout
  shift
  local_timeout=$((WATCHER_AUDIT_TIMEOUT_SECONDS + 10))
  coder_ssh_bounded "$local_timeout" /usr/bin/timeout --signal=TERM --kill-after=5s \
    "${WATCHER_AUDIT_TIMEOUT_SECONDS}s" /usr/bin/env bash -c "$script" \
    remote-dev-local-agent "$@"
}

remote_recovery_gate() {
  local operation=${1:-command} transport=${2:-remote_bash}
  "$transport" '
set -euo pipefail
controls_root=$1 profile=$2 workspace=$3 operation=$4
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
found=false
for record in "$controls_root"/*/processes/recovery/*.tsv; do
  [[ -e $record || -L $record ]] || continue
  handle=$(basename "$record" .tsv)
  [[ $handle =~ ^proc-[0-9]{8}T[0-9]{6}-[0-9]+-[0-9]+$ ]] || continue
  state=identity-pending
  identity=$(dirname "$record")/$handle.identity.tsv
  recovery_argv=$(dirname "$record")/$handle.argv
  recovery_revisions=$(dirname "$record")/$handle.revisions
  if [[ ! -f $record || -L $record || $(field "$record" schema) != 2 || \
        $(field "$record" handle) != "$handle" || $(field "$record" identity_file) != "$identity" || \
        ! -f $recovery_argv || -L $recovery_argv || ! -f $recovery_revisions || -L $recovery_revisions || \
        -z $(field "$record" owner_id) || -z $(field "$record" project_id) || \
        -z $(field "$record" root_hash) || -z $(field "$record" remote_root) || \
        $(field "$record" profile) != "$profile" || $(field "$record" workspace) != "$workspace" ]]; then
    state=binding-invalid
  elif ! recovery_phase=$(field "$record" recovery_phase 2>/dev/null) || \
       ! supervisor_state=$(field "$record" supervisor_state 2>/dev/null) || \
       [[ "$recovery_phase:$supervisor_state" != identity-pending:not-started && \
          "$recovery_phase:$supervisor_state" != identity-pending:launch-requested && \
          "$recovery_phase:$supervisor_state" != active-transition:identity-ready ]]; then
    state=phase-invalid
  elif [[ -e $identity || -L $identity ]]; then
    if [[ ! -f $identity || -L $identity ]]; then
      state=identity-invalid
    else
      pid=$(field "$identity" pid); expected=$(field "$identity" start_token)
      sid=$(field "$identity" session_id); pgid=$(field "$identity" process_group_id)
      if [[ ! $pid =~ ^[0-9]+$ || ! $sid =~ ^[0-9]+$ || ! $pgid =~ ^[0-9]+$ ]]; then
        state=identity-invalid
      elif kill -0 "$pid" 2>/dev/null; then
        actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
        actual_sid=$(ps -p "$pid" -o sid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
        actual_pgid=$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
        if [[ -n $actual && $actual == "$expected" && $actual_sid == "$sid" && $actual_pgid == "$pgid" && $sid == "$pid" ]]; then
          state=live
        else
          state=pid-reused-or-session-mismatch
        fi
      elif pgrep -s "$sid" >/dev/null 2>&1; then
        state=leader-missing-session-live
      else
        state=stale
      fi
    fi
  fi
  project=$(field "$record" project_id 2>/dev/null || true)
  # This gate runs before the local operation lock, so a concurrent launch
  # or teardown transaction may promote or remove this handle while it is
  # inspected. A record that is gone after a short settle finished its
  # transition and is not recovery ownership; the lock-protected path
  # re-checks it.
  sleep 0.3
  [[ -e $record || -L $record ]] || continue
  found=true
  if [[ $operation != stop ]]; then
    printf "PROCESS_RECOVERY_GATE: handle=%s project=%s state=%s\n" \
      "$handle" "${project:-invalid}" "$state" >&2
  fi
done
for identity in "$controls_root"/*/processes/recovery/*.identity.tsv; do
  [[ -e $identity || -L $identity ]] || continue
  handle=$(basename "$identity" .identity.tsv)
  [[ $handle =~ ^proc-[0-9]{8}T[0-9]{6}-[0-9]+-[0-9]+$ ]] || continue
  identity_record=$(dirname "$identity")/$handle.tsv
  [[ -f $identity_record && ! -L $identity_record ]] && continue
  # Cleanup removes the record before the identity; give that removal the
  # same settle before treating the identity as orphaned.
  sleep 0.3
  [[ -e $identity || -L $identity ]] || continue
  [[ -f $identity_record && ! -L $identity_record ]] && continue
  found=true
  [[ $operation == stop ]] || printf "PROCESS_RECOVERY_GATE: handle=%s project=invalid state=orphan-identity\n" "$handle" >&2
done
if [[ $found == true && $operation != stop ]]; then
  echo "Recovery: use the original binding and exact local-agent stop <handle>; takeover/up cannot adopt recovery ownership." >&2
  exit 79
fi
' "${remote_control%/*}" "$profile" "$workspace" "$operation"
}

lock_signal_defer=false
lock_signal_pending=
finish_watcher_lock_window() {
  local status=$1 pending
  lock_signal_defer=false
  pending=${lock_signal_pending:-}
  lock_signal_pending=
  if [[ -n $pending ]]; then
    release_lock
    return "$pending"
  fi
  return "$status"
}

foreground_waiter_file=
register_foreground_waiter() {
  local waiters=$binding_dir/operation.waiters token
  [[ -z ${foreground_waiter_file:-} ]] || return 0
  token=$(process_start_token "$$")
  [[ -n $token ]] || {
    fail 'OPERATION_WAITER_IDENTITY_UNAVAILABLE: refusing an unidentifiable foreground waiter'
    return 77
  }
  mkdir -p "$waiters"
  foreground_waiter_file=$waiters/waiter-$$.tsv
  [[ ! -e $foreground_waiter_file && ! -L $foreground_waiter_file ]] || {
    fail "OPERATION_WAITER_CONFLICT: $foreground_waiter_file"
    return 77
  }
  write_local_process_identity "$foreground_waiter_file" "$$" "$token"
}

clear_foreground_waiter() {
  [[ -n ${foreground_waiter_file:-} ]] || return 0
  if identity_matches_binding "$foreground_waiter_file" "$$"; then
    rm -f "$foreground_waiter_file"
  fi
  foreground_waiter_file=
}

foreground_waiter_exists() {
  local waiters=$binding_dir/operation.waiters waiter pid
  [[ -d $waiters && ! -L $waiters ]] || return 1
  for waiter in "$waiters"/waiter-*.tsv; do
    [[ -e $waiter || -L $waiter ]] || continue
    [[ -f $waiter && ! -L $waiter ]] || {
      [[ ! -e $waiter && ! -L $waiter ]] && continue
      fail "OPERATION_WAITER_INVALID: refusing non-regular waiter $waiter"
      return 77
    }
    pid=$(binding_value pid "$waiter" 2>/dev/null || true)
    if live_identity_matches "$waiter" "$pid"; then
      return 0
    fi
    identity_matches_binding "$waiter" "$pid" || {
      # Foreground acquisition removes its waiter without the watcher lock.
      # Disappearance during the identity reads means it no longer waits.
      [[ ! -e $waiter && ! -L $waiter ]] && continue
      fail "OPERATION_WAITER_INVALID: refusing foreign waiter $waiter"
      return 77
    }
    rm -f "$waiter"
  done
  return 1
}

acquire_lock() {
  local wait_mode=${1:-bounded} lock=$binding_dir/operation.lock attempt=0 existing expected actual invalid_attempts=0 token waiter_status
  if [[ $wait_mode != watcher ]]; then register_foreground_waiter || return $?; fi
  while :; do
    if [[ $wait_mode == watcher ]]; then
      if foreground_waiter_exists; then
        return 82
      else
        waiter_status=$?
        (( waiter_status == 1 )) || return "$waiter_status"
      fi
    fi
    if [[ $wait_mode == watcher ]]; then lock_signal_defer=true; fi
    if mkdir "$lock" 2>/dev/null; then
      if [[ $wait_mode == watcher && -n ${REMOTE_DEV_LOCAL_AGENT_TEST_WATCHER_LOCK_GATE:-} ]]; then
        printf '%s\n' "$$" > "$REMOTE_DEV_LOCAL_AGENT_TEST_WATCHER_LOCK_GATE.ready"
        while [[ ! -e $REMOTE_DEV_LOCAL_AGENT_TEST_WATCHER_LOCK_GATE.release ]]; do sleep 0.02; done
      fi
      token=$(ps -p $$ -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)
      if [[ -z $token ]]; then
        rmdir "$lock" 2>/dev/null || true
        fail 'OPERATION_LOCK_IDENTITY_UNAVAILABLE: refusing an unidentifiable local operation lock'
        finish_watcher_lock_window 77 || return $?
        return 77
      fi
      if ! printf '%s\n' "$token" > "$lock/start_token" || ! printf '%s\n' "$$" > "$lock/pid" || \
         ! printf '%s\n' "${command:-internal}:$wait_mode" > "$lock/operation"; then
        rm -f "$lock/pid" "$lock/start_token" "$lock/operation"
        rmdir "$lock" 2>/dev/null || true
        fail 'OPERATION_LOCK_PUBLICATION_FAILED: refusing an incomplete local operation lock'
        finish_watcher_lock_window 77 || return $?
        return 77
      fi
      operation_lock=$lock
      if [[ $wait_mode != watcher ]]; then clear_foreground_waiter; fi
      finish_watcher_lock_window 0 || return $?
      return 0
    fi
    if [[ $wait_mode == watcher ]]; then
      finish_watcher_lock_window 0 || return $?
    fi
    if [[ $wait_mode == watcher ]]; then
      [[ -f $binding_dir/watcher.pid ]] || return 81
      if [[ -e $binding_dir/REMOTE_DRIFT || -e $binding_dir/UNKNOWN_EXECUTION || \
            -e $binding_dir/PROCESS_ROLLBACK_FAILED ]]; then
        return 74
      fi
    fi
    existing=
    expected=
    if [[ -f $lock/pid ]]; then
      IFS= read -r existing 2>/dev/null < "$lock/pid" || existing=
    fi
    if [[ -f $lock/start_token ]]; then
      IFS= read -r expected 2>/dev/null < "$lock/start_token" || expected=
    fi
    if [[ ! $existing =~ ^[0-9]+$ || -z $expected ]]; then
      invalid_attempts=$((invalid_attempts + 1))
      if (( invalid_attempts >= 10 )); then
        fail "OPERATION_LOCK_INCOMPLETE: refusing an operation lock without a complete PID/start-token identity at $lock"
        fail "Recovery: inspect $lock; after confirming that no Local Agent operation is active, remove only any pid/start_token files present and the exact $lock directory, then retry."
        return 77
      fi
    elif kill -0 "$existing" 2>/dev/null; then
      actual=$(ps -p "$existing" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)
      if [[ -z $actual || $actual != "$expected" ]]; then
        fail 'OPERATION_LOCK_CONFLICT: watcher refuses a reused or unverifiable operation PID'
        return 77
      fi
      invalid_attempts=0
    else
      fail "OPERATION_LOCK_STALE: refusing to remove an unowned local operation lock for dead PID $existing"
      fail "Recovery: inspect $lock/pid and $lock/start_token; after confirming that no Local Agent operation is active, remove those two files and the exact $lock directory, then retry."
      return 77
    fi
    attempt=$((attempt + 1))
    if [[ $wait_mode != watcher && $attempt -ge $LOCK_WAIT_ATTEMPTS ]]; then break; fi
    sleep 0.1
  done
  local owner_operation=unknown
  [[ -f $lock/operation ]] && IFS= read -r owner_operation < "$lock/operation" || true
  fail "OPERATION_LOCK_BUSY: owner_pid=${existing:-unknown} owner_operation=$owner_operation caller=${command:-unknown} wait_mode=$wait_mode lock=$lock"
  fail 'Recovery: wait for the verified owner operation to finish, then retry; do not remove a live lock.'
}

operation_lock=
release_lock() {
  if [[ -n ${operation_lock:-} ]]; then
    rm -f "$operation_lock/pid" "$operation_lock/start_token" "$operation_lock/operation"
    rmdir "$operation_lock" 2>/dev/null || true
    operation_lock=
  fi
}

wait_test_activation_gate() {
  local gate=${REMOTE_DEV_LOCAL_AGENT_TEST_ACTIVATION_GATE:-}
  [[ -n $gate ]] || return 0
  printf '%s\n' "$$" | write_atomic "$gate.ready"
  while [[ ! -e $gate.release ]]; do sleep 0.05; done
}

mark_process_rollback_failed() {
  local handle=$1 reason=$2
  printf 'PROCESS_ROLLBACK_FAILED\nhandle\t%s\nreason\t%s\ndetected_at\t%s\n' \
    "$handle" "$reason" "$(date +%s)" | write_atomic "$binding_dir/PROCESS_ROLLBACK_FAILED"
}

process_rollback_handle() {
  local marker=$binding_dir/PROCESS_ROLLBACK_FAILED handle
  [[ -f $marker && ! -L $marker ]] || {
    fail "PROCESS_ROLLBACK_MARKER_INVALID: refusing recovery from $marker"
    return 77
  }
  handle=$(binding_value handle "$marker" 2>/dev/null || true)
  process_handle_valid "$handle" || {
    fail 'PROCESS_ROLLBACK_MARKER_INVALID: marker has no valid managed handle'
    return 77
  }
  printf '%s\n' "$handle"
}

clear_matching_process_rollback() {
  local handle=$1 marker_handle
  if [[ -e $binding_dir/PROCESS_ROLLBACK_FAILED ]]; then
    marker_handle=$(process_rollback_handle) || return $?
    [[ $marker_handle == "$handle" ]] || {
      fail "PROCESS_ROLLBACK_HANDLE_MISMATCH: recover $marker_handle before operating on $handle"
      return 79
    }
    rm -f "$binding_dir/PROCESS_ROLLBACK_FAILED"
  fi
  if [[ -f $binding_dir/SYNC_FAILED && ! -L $binding_dir/SYNC_FAILED ]] && \
     [[ $(binding_value handle "$binding_dir/SYNC_FAILED" 2>/dev/null || true) == "$handle" ]] && \
     [[ $(binding_value reason "$binding_dir/SYNC_FAILED" 2>/dev/null || true) == activation-rollback-pause-failed ]]; then
    rm -f "$binding_dir/SYNC_FAILED"
  fi
}

pause_after_process_rollback() {
  local handle=$1 reason=$2
  if ! mutagen sync pause "$mutagen_session" >/dev/null; then
    mark_process_rollback_failed "$handle" "$reason-mutagen-pause-failed"
    printf 'SYNC_FAILED\nreason\tactivation-rollback-pause-failed\nhandle\t%s\ndetected_at\t%s\n' \
      "$handle" "$(date +%s)" | write_atomic "$binding_dir/SYNC_FAILED"
    fail "PROCESS_ROLLBACK_FAILED: handle $handle is verified stopped, but synchronization could not be paused."
    fail "Recovery: repair Mutagen, then retry local-agent stop $workspace $handle."
    return 79
  fi
}

rollback_published_handle() {
  local handle=$1 reason=$2
  if ! remote_stop_handle "$handle" >/dev/null; then
    mark_process_rollback_failed "$handle" "$reason-remote-stop-failed"
    fail "PROCESS_ROLLBACK_FAILED: managed handle $handle could not be stopped; its active record was preserved."
    fail "Recovery: inspect local-agent status, then retry local-agent stop $workspace $handle."
    return 79
  fi
  pause_after_process_rollback "$handle" "$reason" || return $?
  clear_matching_process_rollback "$handle"
}

refresh_remote_lease() {
  local operation=$1 transport=${2:-remote_bash}
  require_remote_mode_authority "$transport" || return $?
  remote_recovery_gate "$operation" "$transport" || return $?
  "$transport" '
set -euo pipefail
workspace_control=$1 control=$2 owner=$3 project=$4 profile=$5 workspace=$6 root_hash=$7 remote_root=$8 operation=$9 ttl=${10}
mkdir -p "$workspace_control"
field() { awk -F "\t" -v key="$2" '"'"'$1 == key { sub(/^[^\t]*\t/, ""); print; found=1; exit } END { if (!found) exit 1 }'"'"' "$1"; }
mutex=$workspace_control/claim.lock
acquired=false
for attempt in $(seq 1 300); do
  if mkdir "$mutex" 2>/dev/null; then
    token=$(ps -p $$ -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    [[ -n $token ]] || { rmdir "$mutex"; echo "RUNNER_WORKSPACE_LOCK_IDENTITY_UNAVAILABLE" >&2; exit 1; }
    printf "pid\t%s\nstart_token\t%s\n" "$$" "$token" > "$mutex/owner.tsv"
    acquired=true
    break
  fi
  sleep 0.1
done
if [[ $acquired != true ]]; then
  if [[ -f $mutex/owner.tsv && ! -L $mutex/owner.tsv ]]; then
    lock_pid=$(field "$mutex/owner.tsv" pid)
    expected=$(field "$mutex/owner.tsv" start_token)
    actual=$(ps -p "$lock_pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    if ! kill -0 "$lock_pid" 2>/dev/null || [[ -z $actual || $actual != "$expected" ]]; then
      echo "RUNNER_WORKSPACE_LOCK_STALE: inspect and remove the exact stale lock $mutex before retrying" >&2; exit 1
    fi
  else
    echo "RUNNER_WORKSPACE_LOCK_ORPHANED: inspect and remove the exact orphan lock $mutex before retrying" >&2; exit 1
  fi
  echo "RUNNER_WORKSPACE_LOCK_BUSY" >&2; exit 1
fi
release_mutex() { rm -f "$mutex/owner.tsv"; rmdir "$mutex" 2>/dev/null || true; }
trap release_mutex EXIT
workspace_binding=$workspace_control/binding.tsv
[[ -f $workspace_binding && ! -L $workspace_binding ]] || { echo "RUNNER_WORKSPACE_BINDING_MISSING: run local-agent up" >&2; exit 1; }
[[ $(field "$workspace_binding" project_id) == "$project" && \
   $(field "$workspace_binding" profile) == "$profile" && \
   $(field "$workspace_binding" workspace) == "$workspace" && \
   $(field "$workspace_binding" root_hash) == "$root_hash" && \
   $(field "$workspace_binding" remote_root) == "$remote_root" ]] || {
  echo "RUNNER_WORKSPACE_BINDING_CONFLICT: runner is globally bound to another project/root" >&2; exit 1;
}
workspace_lease=$workspace_control/lease.tsv
lease=$control/lease.tsv
[[ -f $workspace_lease && ! -L $workspace_lease ]] || { echo "RUNNER_WORKSPACE_LEASE_MISSING: run local-agent up" >&2; exit 1; }
[[ -f $lease && ! -L $lease ]] || { echo "LEASE_MISSING: run local-agent up" >&2; exit 1; }
[[ $(field "$workspace_lease" owner_id) == "$owner" && $(field "$workspace_lease" project_id) == "$project" && \
   $(field "$lease" owner_id) == "$owner" && $(field "$lease" project_id) == "$project" ]] || {
  echo "LEASE_CONFLICT: runner is owned by another bridge" >&2; exit 1;
}
now=$(date +%s)
workspace_tmp=$(mktemp "$workspace_control/.lease.XXXXXX")
printf "schema\t1\nowner_id\t%s\nproject_id\t%s\nprofile\t%s\nworkspace\t%s\nroot_hash\t%s\nremote_root\t%s\ncreated_at\t%s\nheartbeat\t%s\nttl\t%s\noperation\t%s\n" \
  "$owner" "$project" "$profile" "$workspace" "$root_hash" "$remote_root" \
  "$(field "$workspace_lease" created_at)" "$now" "$ttl" "$operation" > "$workspace_tmp"
chmod 0600 "$workspace_tmp"
tmp=$(mktemp "$control/.lease.XXXXXX")
printf "schema\t1\nowner_id\t%s\nproject_id\t%s\ncreated_at\t%s\nheartbeat\t%s\nttl\t%s\noperation\t%s\n" \
  "$owner" "$project" "$(field "$lease" created_at)" "$now" "$ttl" "$operation" > "$tmp"
chmod 0600 "$tmp"
mv "$workspace_tmp" "$workspace_lease"
mv "$tmp" "$lease"
' "$workspace_control" "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" \
    "$root_hash" "$remote_root" "$operation" "$LEASE_TTL_SECONDS" >/dev/null
}

materialize_projection() {
  if [[ $binding_kind == working-set ]]; then
    materialize_working_set_projection
    return
  fi
  local tracked_nul untracked_nul ignored_nul stage_tmp manifest_tmp excluded_tmp
  tracked_nul=$(mktemp "$binding_dir/.tracked.XXXXXX")
  untracked_nul=$(mktemp "$binding_dir/.untracked.XXXXXX")
  ignored_nul=$(mktemp "$binding_dir/.ignored.XXXXXX")
  stage_tmp=$(mktemp -d "$binding_dir/.projection.XXXXXX")
  manifest_tmp=$(mktemp "$binding_dir/.managed.XXXXXX")
  excluded_tmp=$(mktemp "$binding_dir/.excluded.XXXXXX")
  projection_temps=("$tracked_nul" "$untracked_nul" "$ignored_nul" "$stage_tmp" "$manifest_tmp" "$excluded_tmp")

  if git -C "$local_root" ls-files --stage | awk '$1 == "160000" { found=1 } END { exit !found }'; then
    fail 'UNSUPPORTED_GIT_METADATA: Git submodules cannot be materialized into a Git-less runner projection.'
    return 1
  fi
  git -C "$local_root" ls-files -z > "$tracked_nul"
  python3 "$working_set_helper" exact-untracked --root "$local_root" --policy "$policy_file" \
    > "$untracked_nul" || return $?
  while IFS=$'\t' read -r policy_kind policy_path; do
    [[ $policy_kind == allowed_untracked ]] || continue
    git -C "$local_root" check-ignore -q -- "$policy_path" && {
      fail "allowed untracked path is ignored by Git: $policy_path"
      return 1
    }
    git -C "$local_root" ls-files --others --exclude-standard -z -- "$policy_path" >> "$untracked_nul"
  done < "$policy_file"
  git -C "$local_root" ls-files --others --ignored --exclude-standard \
    --directory --no-empty-directory -z > "$ignored_nul"

  python3 - "$local_root" "$tracked_nul" "$untracked_nul" "$ignored_nul" \
    "$policy_file" "$stage_tmp" "$manifest_tmp" "$excluded_tmp" <<'PY'
import hashlib
import os
import shutil
import stat
import sys

(root, tracked_file, untracked_file, ignored_file, policy_file, stage,
 manifest_file, excluded_file) = sys.argv[1:]

def nul_paths(path):
    data = open(path, "rb").read()
    if data.endswith(b"\0"):
        data = data[:-1]
    if not data:
        return []
    values = []
    for raw in data.split(b"\0"):
        try:
            values.append(raw.decode("utf-8"))
        except UnicodeDecodeError:
            raise SystemExit("PROJECTION_PATH_INVALID: non-UTF-8 Git path")
    return values

def validate_path(path):
    if (not path or path.startswith("/") or "\t" in path or "\n" in path
            or "\r" in path or "//" in path):
        raise SystemExit(f"PROJECTION_PATH_INVALID: {path!r}")
    parts = path.split("/")
    if any(part in ("", ".", "..") for part in parts):
        raise SystemExit(f"PROJECTION_PATH_INVALID: {path!r}")
    if parts[0] == ".git":
        raise SystemExit("PROJECTION_PATH_INVALID: .git is never projected")

def intersects(left, right):
    return left == right or left.startswith(right + "/") or right.startswith(left + "/")

def within_standard_scope(path, scope):
    framed_path = "/" + path + "/"
    framed_scope = "/" + scope + "/"
    return path == scope or path.startswith(scope + "/") or framed_scope in framed_path

policy = {"allowed_untracked": [], "allowed_untracked_file": [], "tracked_exclusion": [], "remote_writable": []}
with open(policy_file, encoding="utf-8", newline="") as stream:
    for line in stream:
        line = line.rstrip("\n")
        if not line:
            continue
        fields = line.split("\t")
        if len(fields) != 2 or fields[0] not in policy:
            raise SystemExit("PROJECTION_POLICY_INVALID")
        validate_path(fields[1])
        policy[fields[0]].append(fields[1])

standard = [
    "node_modules", ".pnpm-store", ".yarn/cache", ".cache", "dist",
    "build", "coverage", ".next", ".nuxt", ".output", "target",
]
tracked = sorted(set(nul_paths(tracked_file)), key=lambda p: p.encode())
untracked = sorted(set(nul_paths(untracked_file)), key=lambda p: p.encode())
ignored = sorted(set(nul_paths(ignored_file)), key=lambda p: p.encode())
for path in tracked + untracked + ignored:
    validate_path(path.rstrip("/"))

managed = []
for path in tracked:
    if any(intersects(path, excluded) for excluded in policy["tracked_exclusion"]):
        continue
    if any(within_standard_scope(path, item) for item in standard):
        continue
    managed.append((path, "tracked"))
for path in untracked:
    if any(within_standard_scope(path, item) for item in standard):
        continue
    managed.append((path, "untracked"))

seen = {}
unique = []
for path, source in sorted(set(managed), key=lambda item: item[0].encode()):
    folded = path.casefold()
    if folded in seen and seen[folded] != path:
        raise SystemExit(f"PROJECTION_CASE_COLLISION: {seen[folded]} <> {path}")
    seen[folded] = path
    unique.append((path, source))

for path, _ in unique:
    for writable in policy["remote_writable"]:
        if intersects(path, writable):
            raise SystemExit(f"PROJECTION_POLICY_OVERLAP: {path} <> {writable}")

rows = []
for path, source in unique:
    src = os.path.join(root, path)
    dst = os.path.join(stage, path)
    try:
        info = os.lstat(src)
    except FileNotFoundError:
        if source != "tracked":
            raise SystemExit(f"PROJECTION_SOURCE_MISSING: {path}")
        rows.append((path, "missing", "0000", "-", "-", "deleted"))
        continue
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if path in policy["allowed_untracked_file"] and not stat.S_ISREG(info.st_mode):
        raise SystemExit(f"PROJECTION_EXACT_FILE_INVALID: {path}")
    if stat.S_ISREG(info.st_mode):
        mode = "0755" if info.st_mode & stat.S_IXUSR else "0644"
        shutil.copyfile(src, dst)
        os.chmod(dst, int(mode, 8))
        digest = hashlib.sha256(open(src, "rb").read()).hexdigest()
        rows.append((path, "file", mode, digest, "-", "present"))
    elif stat.S_ISLNK(info.st_mode):
        target = os.readlink(src)
        if any(char in target for char in "\t\n\r"):
            raise SystemExit(f"PROJECTION_SYMLINK_INVALID: {path}")
        os.symlink(target, dst)
        digest = hashlib.sha256(target.encode()).hexdigest()
        rows.append((path, "symlink", "0777", digest, target, "present"))
    else:
        raise SystemExit(f"PROJECTION_OBJECT_UNSUPPORTED: {path}")

with open(manifest_file, "w", encoding="utf-8", newline="\n") as stream:
    stream.write("path\ttype\tmode\tdigest\tsymlink_target\tstate\n")
    for row in rows:
        stream.write("\t".join(row) + "\n")

excluded = {(path, "standard") for path in standard}
excluded.update((path, "tracked_exclusion") for path in policy["tracked_exclusion"])
excluded.update((path, "remote-writable") for path in policy["remote_writable"])
excluded.update((path.rstrip("/"), "observed_ignored") for path in ignored)
with open(excluded_file, "w", encoding="utf-8", newline="\n") as stream:
    stream.write("path\treason\n")
    for row in sorted(excluded, key=lambda item: (item[0].encode(), item[1])):
        stream.write("\t".join(row) + "\n")
PY

  mkdir -p "$projection_root"
  find "$projection_root" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  cp -Rp "$stage_tmp/." "$projection_root/"
  mv "$manifest_tmp" "$managed_manifest"
  mv "$excluded_tmp" "$excluded_manifest"
  rm -rf -- "$stage_tmp"
  rm -f -- "$tracked_nul" "$untracked_nul" "$ignored_nul"
  projection_temps=()
  manifest_id=$(sha256_file "$managed_manifest")
}

materialize_working_set_projection() {
  local stage_tmp manifest_tmp excluded_tmp member_digests_tmp projection_result
  stage_tmp=$(mktemp -d "$binding_dir/.projection.XXXXXX")
  manifest_tmp=$(mktemp "$binding_dir/.managed.XXXXXX")
  excluded_tmp=$(mktemp "$binding_dir/.excluded.XXXXXX")
  member_digests_tmp=$(mktemp "$binding_dir/.member-digests.XXXXXX")
  projection_temps=("$stage_tmp" "$manifest_tmp" "$excluded_tmp" "$member_digests_tmp")
  projection_result=$(python3 "$working_set_helper" materialize --snapshot "$topology_file" --policy "$policy_file" \
    --stage "$stage_tmp" --managed "$manifest_tmp" --excluded "$excluded_tmp" \
    --member-digests "$member_digests_tmp" --reuse-stage "$projection_root" \
    --retained "$binding_dir/retained.tsv") || return $?
  if [[ $projection_result != reused ]]; then
    [[ $projection_result == materialized ]] || { fail 'PROJECTION_RESULT_INVALID'; return 1; }
    mkdir -p "$projection_root"
    find "$projection_root" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
    cp -Rp "$stage_tmp/." "$projection_root/"
  fi
  mv "$manifest_tmp" "$managed_manifest"
  mv "$excluded_tmp" "$excluded_manifest"
  mv "$member_digests_tmp" "$member_digests"
  rm -rf -- "$stage_tmp"
  projection_temps=()
  manifest_id=$(sha256_file "$managed_manifest")
}

projection_temps=()
cleanup_projection_temps() {
  local item
  for item in "${projection_temps[@]:-}"; do
    [[ -z $item ]] || rm -rf -- "$item"
  done
  projection_temps=()
}

cleanup_local_agent() {
  stop_execution_heartbeat || true
  rollback_policy_update || { cleanup_ssh_transport; return 79; }
  cleanup_ssh_transport
  cleanup_projection_temps
  release_lock
  clear_foreground_waiter
  release_claim_lock
  local claim claimed
  for claim in "${created_binding_claims[@]:-}"; do
    [[ -n $claim && -f $claim && ! -L $claim ]] || continue
    IFS= read -r claimed < "$claim" || true
    [[ $claimed == "$binding_dir" ]] && rm -f "$claim"
  done
  if [[ -n ${new_binding_cleanup:-} ]]; then
    rm -rf -- "$new_binding_cleanup"
  fi
  if [[ -n ${reanchor_lock:-} ]]; then
    rm -f "$reanchor_lock/pid"
    rmdir "$reanchor_lock" 2>/dev/null || true
  fi
  if [[ -n ${reanchor_cleanup_dir:-} ]]; then
    rm -rf -- "$reanchor_cleanup_dir"
  fi
}

execution_heartbeat_pid=
execution_heartbeat_pid_file=
execution_heartbeat_identity_file=
stop_execution_heartbeat() {
  local expected_pid actual_pid
  if [[ -n ${execution_heartbeat_identity_file:-} ]]; then
    if ! identity_matches_binding "$execution_heartbeat_identity_file" "${execution_heartbeat_pid:-}"; then
      printf 'LEASE_HEARTBEAT_FAILED\nreason\theartbeat-identity-mismatch\ndetected_at\t%s\n' "$(date +%s)" | \
        write_atomic "$binding_dir/LEASE_HEARTBEAT_FAILED"
      fail 'HEARTBEAT_IDENTITY_MISMATCH: refusing to signal an unverified heartbeat PID'
      return 78
    fi
    actual_pid=$(binding_value pid "$execution_heartbeat_identity_file")
    expected_pid=$(binding_value start_token "$execution_heartbeat_identity_file" 2>/dev/null || true)
    if kill -0 "$actual_pid" 2>/dev/null; then
      if [[ -z $expected_pid || $(process_start_token "$actual_pid") != "$expected_pid" ]]; then
        printf 'LEASE_HEARTBEAT_FAILED\nreason\theartbeat-pid-reused\ndetected_at\t%s\n' "$(date +%s)" | \
          write_atomic "$binding_dir/LEASE_HEARTBEAT_FAILED"
        fail 'HEARTBEAT_PID_REUSED: refusing to signal an unverified heartbeat PID'
        return 78
      fi
      kill "$actual_pid" 2>/dev/null || true
      wait "$actual_pid" 2>/dev/null || true
    fi
  fi
  [[ -z ${execution_heartbeat_pid_file:-} ]] || rm -f "$execution_heartbeat_pid_file"
  [[ -z ${execution_heartbeat_identity_file:-} ]] || rm -f "$execution_heartbeat_identity_file"
  execution_heartbeat_pid=
  execution_heartbeat_pid_file=
  execution_heartbeat_identity_file=
}

start_execution_heartbeat() {
  local receipt_id=$1 heartbeat_dir parent_token attempt
  heartbeat_dir=$binding_dir/execution-heartbeats
  mkdir -p "$heartbeat_dir"
  rm -f "$binding_dir/LEASE_HEARTBEAT_FAILED"
  execution_heartbeat_pid_file=$heartbeat_dir/$receipt_id.pid
  execution_heartbeat_identity_file=$heartbeat_dir/$receipt_id.identity.tsv
  rm -f "$execution_heartbeat_pid_file" "$execution_heartbeat_identity_file"
  parent_token=$(process_start_token "$$")
  [[ -n $parent_token ]] || { fail 'EXECUTION_IDENTITY_UNAVAILABLE: refusing heartbeat without parent start token'; return 78; }
  "$script_path" _heartbeat "$binding_dir" "$$" "$parent_token" "$receipt_id" > "$heartbeat_dir/$receipt_id.log" 2>&1 &
  execution_heartbeat_pid=$!
  for attempt in $(seq 1 50); do
    if live_identity_matches "$execution_heartbeat_identity_file" "$execution_heartbeat_pid" && \
       [[ -f $execution_heartbeat_pid_file && ! -L $execution_heartbeat_pid_file ]] && \
       [[ $(<"$execution_heartbeat_pid_file") == "$execution_heartbeat_pid" ]] && \
       [[ $(binding_value parent_pid "$execution_heartbeat_identity_file" 2>/dev/null || true) == "$$" ]] && \
       [[ $(binding_value parent_start_token "$execution_heartbeat_identity_file" 2>/dev/null || true) == "$parent_token" ]]; then
      return 0
    fi
    kill -0 "$execution_heartbeat_pid" 2>/dev/null || break
    sleep 0.1
  done
  stop_execution_heartbeat || true
  fail "HEARTBEAT_START_FAILED: inspect $heartbeat_dir/$receipt_id.log"
  return 78
}

run_heartbeat() {
  binding_dir=$1
  local parent_pid=$2 parent_start_token=$3 receipt_id=$4 heartbeat_dir identity_file self_token
  load_binding_dir "$binding_dir"
  trap 'cancel_bounded_transport; cleanup_ssh_transport' EXIT
  trap 'exit 143' TERM
  trap 'exit 130' INT
  ensure_platform
  ensure_coder_context
  heartbeat_dir=$binding_dir/execution-heartbeats
  identity_file=$heartbeat_dir/$receipt_id.identity.tsv
  self_token=$(process_start_token "$$")
  [[ -n $self_token ]] || exit 78
  {
    printf 'schema\t1\npid\t%s\nstart_token\t%s\nparent_pid\t%s\nparent_start_token\t%s\n' \
      "$$" "$self_token" "$parent_pid" "$parent_start_token"
    printf 'owner_id\t%s\nproject_id\t%s\nprofile\t%s\nworkspace\t%s\nroot_hash\t%s\nlocal_root\t%s\n' \
      "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" "$local_root"
  } | write_atomic "$identity_file"
  printf '%s\n' "$$" | write_atomic "$heartbeat_dir/$receipt_id.pid"
  while live_identity_matches "$identity_file" "$$" && \
        kill -0 "$parent_pid" 2>/dev/null && \
        [[ $(process_start_token "$parent_pid") == "$parent_start_token" ]]; do
    if ! refresh_remote_lease exec-heartbeat; then
      printf 'LEASE_HEARTBEAT_FAILED\ndetected_at\t%s\n' "$(date +%s)" | \
        write_atomic "$binding_dir/LEASE_HEARTBEAT_FAILED"
      exit 78
    fi
    sleep "$HEARTBEAT_INTERVAL_SECONDS"
  done
  if kill -0 "$parent_pid" 2>/dev/null && [[ $(process_start_token "$parent_pid") != "$parent_start_token" ]]; then
    printf 'LEASE_HEARTBEAT_FAILED\nreason\tparent-pid-reused\ndetected_at\t%s\n' "$(date +%s)" | \
      write_atomic "$binding_dir/LEASE_HEARTBEAT_FAILED"
    exit 78
  fi
  if ! live_identity_matches "$identity_file" "$$"; then
    printf 'LEASE_HEARTBEAT_FAILED\nreason\theartbeat-identity-mismatch\ndetected_at\t%s\n' "$(date +%s)" | \
      write_atomic "$binding_dir/LEASE_HEARTBEAT_FAILED"
    exit 78
  fi
}

mutagen_session_exists() {
  mutagen sync list "$mutagen_session" >/dev/null 2>&1
}

ensure_mutagen_session() {
  local policy_id recorded_policy_id= policy_id_file=$binding_dir/mutagen-policy.id standard_ignore
  local -a create_args=(
    sync create --name "$mutagen_session" --sync-mode one-way-safe --ignore-vcs
    --no-global-configuration --ignore-syntax mutagen
    --permissions-mode portable --default-file-mode 0644 --default-directory-mode 0755
  )
  policy_id=$({
    # Projection policy paths are relative to the project root.  Mutagen treats
    # a leaf ignore as recursive, so anchor manifest-derived paths to preserve
    # the materializer's root-relative tracked-exclusion semantics.
    printf 'remote-dev-mutagen-contract-v4\n'
    printf 'standard-ignore\t%s\n' "${STANDARD_MUTAGEN_IGNORES[@]}"
    cat "$excluded_manifest"
  } | sha256_stream)
  if [[ -f $policy_id_file ]]; then
    IFS= read -r recorded_policy_id < "$policy_id_file"
  fi
  if mutagen_session_exists && [[ $recorded_policy_id != "$policy_id" ]]; then
    mutagen sync terminate "$mutagen_session" >/dev/null
  fi
  if ! mutagen_session_exists; then
    for standard_ignore in "${STANDARD_MUTAGEN_IGNORES[@]}"; do
      create_args+=(--ignore "$standard_ignore")
    done
    while IFS=$'\t' read -r excluded_path reason; do
      [[ $excluded_path != path ]] || continue
      create_args+=(--ignore "/$excluded_path")
    done < "$excluded_manifest"
    create_args+=("$projection_root" "$ssh_alias:$remote_root")
    mutagen "${create_args[@]}" >/dev/null
    printf '%s\n' "$policy_id" | write_atomic "$policy_id_file"
  fi
}

remote_manifest_to() {
  local destination=$1 expected_manifest=${2:-$managed_manifest} transport=${3:-remote_bash}
  local excluded_path reason compressed_manifest transport_status=0
  local -a allowed_remote_scopes=()
  while IFS=$'\t' read -r excluded_path reason; do
    [[ $excluded_path != path ]] || continue
    allowed_remote_scopes+=("$excluded_path")
  done < "$excluded_manifest"
  compressed_manifest=$(mktemp "$binding_dir/.transport-manifest.XXXXXX") || return
  projection_temps+=("$compressed_manifest")
  gzip -c "$expected_manifest" > "$compressed_manifest" || return $?
  "$transport" 'exec python3 -c "$1" --compressed-match "${@:2}"' \
    "$(cat "${script_path%/*}/remote-dev-remote-manifest.py")" \
    "$remote_root" "${#STANDARD_REMOTE_SCOPES[@]}" "${STANDARD_REMOTE_SCOPES[@]}" \
    "${allowed_remote_scopes[@]}" < "$compressed_manifest" > "$destination" || transport_status=$?
  rm -f "$compressed_manifest"
  (( transport_status == 0 )) || return "$transport_status"
  if [[ $(<"$destination") == REMOTE_MANIFEST_MATCH ]]; then
    cp "$expected_manifest" "$destination"
  fi
}

reset_unaccepted_remote_projection() {
  remote_bash '
set -euo pipefail
root=$1
command -v remote-dev-managed-unlink >/dev/null 2>&1 || {
  echo "MANAGED_UNLINK_HELPER_MISSING: update the runner workspace image before topology retirement" >&2
  exit 78
}
remote-dev-managed-unlink "$root"
' "$remote_root" < "$managed_manifest"
}

record_revision() {
  local revision_id=$1 previous_id=${2:-} revision_dir revision_file now
  revision_dir=$binding_dir/revisions
  mkdir -p "$revision_dir"
  now=$(date +%s)
  revision_file=$revision_dir/$now-$revision_id.tsv
  {
    printf 'schema\t1\nkind\tprojection-revision\nmanifest_id\t%s\nprevious_manifest_id\t%s\ntimestamp\t%s\n' \
      "$revision_id" "${previous_id:--}" "$now"
  } | write_atomic "$revision_file"
  printf '%s\n' "$revision_id" | write_atomic "$binding_dir/current-manifest.id"
  remote_bash '
set -euo pipefail
control=$1 owner=$2 revision=$3
for record in "$control"/processes/active/*.tsv; do
  [[ -f $record ]] || continue
  record_owner=$(awk -F "\t" '"'"'$1 == "owner_id" {print $2; exit}'"'"' "$record")
  [[ $record_owner == "$owner" ]] || continue
  printf "%s\n" "$revision" >> "${record%.tsv}.revisions"
done
' "$remote_control" "$owner_id" "$revision_id" >/dev/null
}

mark_drift() {
  local remote_manifest_file=$1 expected_manifest=${2:-$managed_manifest} expected_id
  expected_id=$(sha256_file "$expected_manifest")
  {
    printf 'REMOTE_DRIFT\nmanifest_id\t%s\ndetected_at\t%s\n' "$expected_id" "$(date +%s)"
    diff -u "$expected_manifest" "$remote_manifest_file" || true
  } | write_atomic "$binding_dir/REMOTE_DRIFT"
  printf 'REMOTE_DRIFT: managed source differs in %s/%s.\n' "$profile" "$workspace" >&2
  printf 'Recovery: restore remote managed paths to the local projection, then run local-agent up --recover-drift.\n' >&2
}

sync_barrier() {
  local keep_active=$1 lock_already_held=${2:-false} lock_wait_mode=${3:-bounded} owns_lock=true
  local remote_manifest_file pre_remote_manifest previous_manifest_file= previous_id= sync_status=0 barrier_source_token
  assert_topology_current || return $?
  [[ ! -e $binding_dir/REMOTE_DRIFT ]] || {
    fail 'REMOTE_DRIFT blocks synchronization; use the documented explicit recovery.'
    return
  }
  [[ ! -e $binding_dir/UNKNOWN_EXECUTION ]] || {
    fail 'UNKNOWN_EXECUTION blocks synchronization; run local-agent up --recover-unknown.'
    return
  }
  [[ ! -e $binding_dir/PROCESS_ROLLBACK_FAILED ]] || {
    fail 'PROCESS_ROLLBACK_FAILED blocks synchronization; inspect status and stop the preserved handle.'
    return 79
  }
  if [[ $lock_already_held == true ]]; then
    [[ -n ${operation_lock:-} && -d $operation_lock ]] || {
      fail 'local-agent execution lock is missing; refusing synchronization'
      return 77
    }
    owns_lock=false
  else
    acquire_lock "$lock_wait_mode" || return
    trap 'cleanup_projection_temps; release_lock' RETURN
  fi
  barrier_source_token=$(source_state_token) || return $?
  refresh_remote_lease sync || return $?
  if mutagen_session_exists; then
    mutagen sync pause "$mutagen_session" >/dev/null
  fi
  if [[ -f $managed_manifest && -f $binding_dir/current-manifest.id ]]; then
    previous_manifest_file=$(mktemp "$binding_dir/.previous-manifest.XXXXXX")
    cp "$managed_manifest" "$previous_manifest_file"
    pre_remote_manifest=$(mktemp "$binding_dir/.pre-remote-manifest.XXXXXX")
    remote_manifest_to "$pre_remote_manifest" "$previous_manifest_file" || return $?
    if ! cmp -s "$previous_manifest_file" "$pre_remote_manifest"; then
      mark_drift "$pre_remote_manifest" "$previous_manifest_file"
      rm -f "$pre_remote_manifest" "$previous_manifest_file"
      return 74
    fi
    rm -f "$pre_remote_manifest"
  fi
  materialize_projection || return $?
  ensure_mutagen_session || return $?
  set +e
  mutagen sync resume "$mutagen_session" >/dev/null
  sync_status=$?
  if (( sync_status == 0 )); then
    mutagen sync flush "$mutagen_session" >/dev/null
    sync_status=$?
  fi
  set -e
  mutagen sync pause "$mutagen_session" >/dev/null
  if (( sync_status != 0 )); then
    if [[ -n $previous_manifest_file ]]; then
      remote_manifest_file=$(mktemp "$binding_dir/.failed-remote-manifest.XXXXXX")
      if remote_manifest_to "$remote_manifest_file" "$previous_manifest_file" && \
         ! cmp -s "$previous_manifest_file" "$remote_manifest_file"; then
        mark_drift "$remote_manifest_file" "$previous_manifest_file"
        rm -f "$remote_manifest_file" "$previous_manifest_file"
        return 74
      fi
      rm -f "$remote_manifest_file"
    fi
    # materialize_projection publishes the attempted manifest before transfer.
    # A failed flush must not make it the baseline for the next remote audit:
    # unchanged remote files still belong to the last accepted revision.
    if [[ -n $previous_manifest_file ]]; then
      cp "$previous_manifest_file" "$managed_manifest"
      manifest_id=$(sha256_file "$managed_manifest")
      rm -f "$previous_manifest_file"
    fi
    printf 'SYNC_FAILED\nstatus\t%s\ndetected_at\t%s\n' "$sync_status" "$(date +%s)" | \
      write_atomic "$binding_dir/SYNC_FAILED"
    printf 'SYNC_FAILED: Mutagen could not complete the one-way barrier (exit %s).\n' "$sync_status" >&2
    printf 'Recovery: repair SSH/Mutagen connectivity and retry; synchronization remains paused.\n' >&2
    return 76
  fi
  [[ -z $previous_manifest_file ]] || rm -f "$previous_manifest_file"
  remote_manifest_file=$(mktemp "$binding_dir/.remote-manifest.XXXXXX")
  remote_manifest_to "$remote_manifest_file" || return $?
  if ! cmp -s "$managed_manifest" "$remote_manifest_file"; then
    mark_drift "$remote_manifest_file"
    rm -f "$remote_manifest_file"
    return 74
  fi
  rm -f "$remote_manifest_file"
  rm -f "$binding_dir/SYNC_FAILED"
  if [[ -f $binding_dir/current-manifest.id ]]; then
    IFS= read -r previous_id < "$binding_dir/current-manifest.id"
  fi
  if [[ $previous_id != "$manifest_id" ]]; then
    record_revision "$manifest_id" "$previous_id"
  fi
  printf '%s\n' "$barrier_source_token" | write_atomic "$binding_dir/watcher-baseline.token"
  if [[ $keep_active == true ]]; then
    mutagen sync resume "$mutagen_session" >/dev/null
  fi
  if [[ $owns_lock == true ]]; then trap - RETURN; fi
  cleanup_projection_temps
  if [[ $owns_lock == true ]]; then release_lock; fi
}

post_execution_drift_check() {
  local resume_after=${1:-true} remote_manifest_file
  remote_manifest_file=$(mktemp "$binding_dir/.post-manifest.XXXXXX")
  remote_manifest_to "$remote_manifest_file"
  if ! cmp -s "$managed_manifest" "$remote_manifest_file"; then
    mark_drift "$remote_manifest_file"
    rm -f "$remote_manifest_file"
    return 74
  fi
  rm -f "$remote_manifest_file"
  if [[ $resume_after == true ]]; then
    mutagen sync resume "$mutagen_session" >/dev/null
  fi
}

source_state_token() {
  if [[ $binding_kind == working-set ]]; then
    python3 "$working_set_helper" watch-token --snapshot "$topology_file" --policy "$policy_file"
  else
    python3 "$working_set_helper" watch-token --root "$local_root" --policy "$policy_file"
  fi
}

watcher_remote_audit() {
  local remote_manifest_file status
  acquire_lock watcher || return $?
  refresh_remote_lease watcher-audit remote_bash_bounded || {
    status=$?
    release_lock
    return "$status"
  }
  if mutagen_session_exists; then mutagen sync pause "$mutagen_session" >/dev/null; fi
  remote_manifest_file=$(mktemp "$binding_dir/.watcher-audit.XXXXXX")
  remote_manifest_to "$remote_manifest_file" "$managed_manifest" remote_bash_bounded || {
    rm -f "$remote_manifest_file"
    release_lock
    return 76
  }
  if ! cmp -s "$managed_manifest" "$remote_manifest_file"; then
    mark_drift "$remote_manifest_file"
    rm -f "$remote_manifest_file"
    release_lock
    return 74
  fi
  rm -f "$remote_manifest_file"
  mutagen sync resume "$mutagen_session" >/dev/null
  release_lock
}

write_exec_receipt() {
  local receipt_id=$1 started=$2 finished=$3 exit_code=$4 signal=$5 timed_out=$6 result=$7
  shift 7
  local receipt_dir receipt_file program
  receipt_dir=$binding_dir/receipts
  mkdir -p "$receipt_dir"
  receipt_file=$receipt_dir/$receipt_id.tsv
  # Arguments may carry secrets, so a receipt keeps only the argument count and
  # the program name; it never stores argv in a recoverable form.
  program=${1##*/}
  program=${program//[$'\t\n']/ }
  {
    printf 'schema\t2\nkind\texec\nreceipt_id\t%s\nproject_id\t%s\nprofile\t%s\ncoder_origin\t%s\nworkspace\t%s\nworkspace_role\trunner\nbinding_kind\t%s\nlocal_root\t%s\nremote_root\t%s\nmember_id\t%s\nremote_cwd\t%s\ntopology_digest\t%s\nmanifest_id\t%s\nstarted_at\t%s\nfinished_at\t%s\nexit_code\t%s\nsignal\t%s\ntimed_out\t%s\nresult\t%s\nargc\t%s\nprogram\t%s\n' \
      "$receipt_id" "$project_id" "$profile" "$coder_origin" "$workspace" \
      "$binding_kind" "$local_root" "$remote_root" "$resolved_member" "$remote_cwd" \
      "${topology_digest:--}" "$manifest_id" "$started" "$finished" \
      "$exit_code" "$signal" "$timed_out" "$result" "$#" "${program:--}"
  } | write_atomic "$receipt_file"
  write_atomic "$current_receipt" < "$receipt_file"
  last_receipt_file=$receipt_file
}

emit_receipt_fd() {
  local fd=$1
  [[ -z $fd ]] && return 0
  [[ $fd =~ ^[3-9][0-9]*$ ]] || usage_error '--receipt-fd must be an open numeric descriptor >= 3'
  if [[ ! -w /dev/fd/$fd ]]; then
    fail "receipt file descriptor is not open: $fd"
    return
  fi
  printf '%s\n' "$last_receipt_file" > "/dev/fd/$fd"
}

parsed_args=()
target_workspace=
target_context=
parse_binding_target() {
  local -a arguments=("$@") remaining=()
  target_workspace=
  target_context=
  local index=0
  while (( index < ${#arguments[@]} )); do
    case "${arguments[$index]}" in
      --for-context|--for-root)
        (( index + 1 < ${#arguments[@]} )) || usage_error "${arguments[$index]} requires a path"
        target_context=${arguments[$((index + 1))]}
        index=$((index + 2))
        ;;
      *)
        remaining+=("${arguments[$index]}")
        index=$((index + 1))
        ;;
    esac
  done
  parsed_args=("${remaining[@]}")
  if [[ -z $target_context && ${#parsed_args[@]} -gt 0 && ${parsed_args[0]} != --* ]]; then
    target_workspace=${parsed_args[0]}
    parsed_args=("${parsed_args[@]:1}")
  fi
  if [[ -n $target_context ]]; then
    load_binding_for_context "$target_context"
    if [[ -n $target_workspace && $target_workspace != "$workspace" ]]; then
      fail 'workspace positional argument conflicts with --for-context binding'
      return
    fi
  else
    [[ -n $target_workspace ]] || usage_error 'command requires a workspace or --for-context'
    load_binding_for_workspace "$target_workspace"
  fi
}

write_binding() {
  {
    printf 'schema\t1\nbinding_kind\t%s\nproject_id\t%s\nworkspace\t%s\nworkspace_role\trunner\nprofile\t%s\ncoder_origin\t%s\nssh_alias\t%s\nlocal_root\t%s\nremote_root\t%s\nroot_hash\t%s\nmutagen_session\t%s\nowner_id\t%s\nremote_control\t%s\nprojection_policy_path\t%s\nmanaged_manifest_path\t%s\nexcluded_manifest_path\t%s\ncurrent_receipt_path\t%s\ntopology_path\t%s\ntopology_digest\t%s\nexecution_member\t%s\nmember_digests_path\t%s\n' \
      "$binding_kind" \
      "$project_id" "$workspace" "$profile" "$coder_origin" "$ssh_alias" \
      "$local_root" "$remote_root" "$root_hash" "$mutagen_session" "$owner_id" \
      "$remote_control" "$policy_file" "$managed_manifest" "$excluded_manifest" \
      "$current_receipt" "$topology_file" "$topology_digest" "$execution_member" "$member_digests"
    printf 'git_metadata_mode\t%s\n' "$git_metadata_mode"
  } | write_atomic "$binding_file"
}

remote_bind() {
  local take_over_stale=$1
  require_remote_mode_authority || return $?
  remote_bash '
set -euo pipefail
workspace_control=$1 control=$2 project=$3 profile=$4 workspace=$5 root_hash=$6 remote_root=$7 owner=$8 ttl=$9 takeover=${10}
mkdir -p "$workspace_control"
chmod 0700 "$workspace_control"
workspace_binding=$workspace_control/binding.tsv
binding=$control/binding.tsv
field() { awk -F "\t" -v key="$2" '"'"'$1 == key { sub(/^[^\t]*\t/, ""); print; found=1; exit } END { if (!found) exit 1 }'"'"' "$1"; }
mutex=$workspace_control/claim.lock
acquired=false
for attempt in $(seq 1 300); do
  if mkdir "$mutex" 2>/dev/null; then
    token=$(ps -p $$ -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    [[ -n $token ]] || { rmdir "$mutex"; echo "RUNNER_WORKSPACE_LOCK_IDENTITY_UNAVAILABLE" >&2; exit 1; }
    printf "pid\t%s\nstart_token\t%s\n" "$$" "$token" > "$mutex/owner.tsv"
    acquired=true
    break
  fi
  sleep 0.1
done
if [[ $acquired != true ]]; then
  if [[ -f $mutex/owner.tsv && ! -L $mutex/owner.tsv ]]; then
    lock_pid=$(field "$mutex/owner.tsv" pid)
    expected=$(field "$mutex/owner.tsv" start_token)
    actual=$(ps -p "$lock_pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    if ! kill -0 "$lock_pid" 2>/dev/null || [[ -z $actual || $actual != "$expected" ]]; then
      echo "RUNNER_WORKSPACE_LOCK_STALE: inspect and remove the exact stale lock $mutex before retrying" >&2; exit 1
    fi
  else
    echo "RUNNER_WORKSPACE_LOCK_ORPHANED: inspect and remove the exact orphan lock $mutex before retrying" >&2; exit 1
  fi
  echo "RUNNER_WORKSPACE_LOCK_BUSY" >&2; exit 1
fi
release_mutex() { rm -f "$mutex/owner.tsv"; rmdir "$mutex" 2>/dev/null || true; }
trap release_mutex EXIT
controls_root=${control%/*}
for recovery_record in "$controls_root"/*/processes/recovery/*.tsv; do
  [[ -e $recovery_record || -L $recovery_record ]] || continue
  recovery_handle=$(basename "$recovery_record" .tsv)
  [[ $recovery_handle =~ ^proc-[0-9]{8}T[0-9]{6}-[0-9]+-[0-9]+$ ]] || continue
  recovery_identity=$(dirname "$recovery_record")/$recovery_handle.identity.tsv
  recovery_argv=$(dirname "$recovery_record")/$recovery_handle.argv
  recovery_revisions=$(dirname "$recovery_record")/$recovery_handle.revisions
  recovery_state=identity-pending
  if [[ ! -f $recovery_record || -L $recovery_record || \
        $(field "$recovery_record" schema) != 2 || $(field "$recovery_record" handle) != "$recovery_handle" || \
        $(field "$recovery_record" identity_file) != "$recovery_identity" || \
        ! -f $recovery_argv || -L $recovery_argv || ! -f $recovery_revisions || -L $recovery_revisions || \
        -z $(field "$recovery_record" owner_id) || -z $(field "$recovery_record" project_id) || \
        -z $(field "$recovery_record" root_hash) || -z $(field "$recovery_record" remote_root) || \
        $(field "$recovery_record" profile) != "$profile" || $(field "$recovery_record" workspace) != "$workspace" ]]; then
    recovery_state=binding-invalid
  elif ! recovery_phase=$(field "$recovery_record" recovery_phase 2>/dev/null) || \
       ! supervisor_state=$(field "$recovery_record" supervisor_state 2>/dev/null) || \
       [[ "$recovery_phase:$supervisor_state" != identity-pending:not-started && \
          "$recovery_phase:$supervisor_state" != identity-pending:launch-requested && \
          "$recovery_phase:$supervisor_state" != active-transition:identity-ready ]]; then
    recovery_state=phase-invalid
  elif [[ -e $recovery_identity || -L $recovery_identity ]]; then
    if [[ ! -f $recovery_identity || -L $recovery_identity ]]; then
      recovery_state=identity-invalid
    else
      recovery_pid=$(field "$recovery_identity" pid); recovery_expected=$(field "$recovery_identity" start_token)
      recovery_sid=$(field "$recovery_identity" session_id); recovery_pgid=$(field "$recovery_identity" process_group_id)
      if [[ ! $recovery_pid =~ ^[0-9]+$ || ! $recovery_sid =~ ^[0-9]+$ || ! $recovery_pgid =~ ^[0-9]+$ ]]; then
        recovery_state=identity-invalid
      elif kill -0 "$recovery_pid" 2>/dev/null; then
        recovery_actual=$(ps -p "$recovery_pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
        recovery_actual_sid=$(ps -p "$recovery_pid" -o sid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
        recovery_actual_pgid=$(ps -p "$recovery_pid" -o pgid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
        if [[ -n $recovery_actual && $recovery_actual == "$recovery_expected" && \
              $recovery_actual_sid == "$recovery_sid" && $recovery_actual_pgid == "$recovery_pgid" && \
              $recovery_sid == "$recovery_pid" ]]; then
          recovery_state=live
        else
          recovery_state=pid-reused-or-session-mismatch
        fi
      elif pgrep -s "$recovery_sid" >/dev/null 2>&1; then
        recovery_state=leader-missing-session-live
      else
        recovery_state=stale
      fi
    fi
  fi
  printf "PROCESS_RECOVERY_GATE: handle=%s project=%s state=%s\n" "$recovery_handle" \
    "$(field "$recovery_record" project_id 2>/dev/null || printf invalid)" "$recovery_state" >&2
  echo "Recovery: use the original binding and exact local-agent stop <handle>; --take-over-stale cannot adopt recovery ownership." >&2
  exit 79
done
for recovery_identity in "$controls_root"/*/processes/recovery/*.identity.tsv; do
  [[ -e $recovery_identity || -L $recovery_identity ]] || continue
  recovery_handle=$(basename "$recovery_identity" .identity.tsv)
  [[ $recovery_handle =~ ^proc-[0-9]{8}T[0-9]{6}-[0-9]+-[0-9]+$ ]] || continue
  recovery_record=$(dirname "$recovery_identity")/$recovery_handle.tsv
  [[ -f $recovery_record && ! -L $recovery_record ]] && continue
  printf "PROCESS_RECOVERY_GATE: handle=%s project=invalid state=orphan-identity\n" "$recovery_handle" >&2
  exit 79
done
if [[ -e $workspace_binding ]]; then
  [[ -f $workspace_binding && ! -L $workspace_binding ]] || { echo "RUNNER_WORKSPACE_BINDING_INVALID" >&2; exit 1; }
  [[ $(field "$workspace_binding" project_id) == "$project" && \
     $(field "$workspace_binding" profile) == "$profile" && \
     $(field "$workspace_binding" workspace) == "$workspace" && \
     $(field "$workspace_binding" root_hash) == "$root_hash" && \
     $(field "$workspace_binding" remote_root) == "$remote_root" ]] || {
    echo "RUNNER_WORKSPACE_BINDING_CONFLICT: runner is globally bound to another project/root" >&2; exit 1;
  }
elif [[ -e $workspace_control/lease.tsv ]]; then
  echo "RUNNER_WORKSPACE_STATE_INVALID: lease exists without its binding" >&2; exit 1
fi
mkdir -p "$control" "$remote_root" "$control/processes/active" "$control/processes/stopped" \
  "$control/processes/recovery" "$control/logs" "$control/executions"
chmod 0700 "$control" "$control/processes" "$control/processes/active" "$control/processes/stopped" \
  "$control/processes/recovery" "$control/logs" "$control/executions"
[[ ! -e $remote_root/.git && ! -L $remote_root/.git ]] || {
  echo "RUNNER_NOT_GITLESS: $remote_root/.git exists" >&2; exit 1;
}
if [[ -e $binding ]]; then
  [[ -f $binding && ! -L $binding ]] || { echo "RUNNER_BINDING_INVALID" >&2; exit 1; }
  [[ $(field "$binding" project_id) == "$project" && $(field "$binding" profile) == "$profile" && \
     $(field "$binding" workspace) == "$workspace" && $(field "$binding" root_hash) == "$root_hash" && \
     $(field "$binding" remote_root) == "$remote_root" ]] || {
    echo "RUNNER_BINDING_CONFLICT: runner is bound to another project/root" >&2; exit 1;
  }
else
  [[ ! -e $control/lease.tsv ]] || { echo "RUNNER_STATE_INVALID: lease exists without its project binding" >&2; exit 1; }
  [[ -z $(find "$remote_root" -mindepth 1 -maxdepth 1 -print -quit) ]] || {
    echo "RUNNER_ROOT_NOT_EMPTY: first binding requires an empty marker-owned project root" >&2
    echo "Recovery: choose an empty runner project root or explicitly clean the exact unbound path." >&2
    exit 1
  }
fi
workspace_lease=$workspace_control/lease.tsv
lease=$control/lease.tsv
now=$(date +%s)
workspace_created=$now
project_created=$now
for candidate in "$workspace_lease" "$lease"; do
  [[ ! -e $candidate ]] || [[ -f $candidate && ! -L $candidate ]] || { echo "LEASE_INVALID" >&2; exit 1; }
  [[ -e $candidate ]] || continue
  lease_owner=$(field "$candidate" owner_id)
  heartbeat=$(field "$candidate" heartbeat)
  candidate_created=$(field "$candidate" created_at)
  if [[ $lease_owner != "$owner" ]]; then
    age=$((now - heartbeat))
    if (( age <= ttl )); then
      echo "RUNNER_WORKSPACE_LEASE_CONFLICT: owner=$lease_owner age=$age ttl=$ttl" >&2; exit 1
    fi
    [[ $takeover == true ]] || {
      echo "STALE_RUNNER_WORKSPACE_LEASE: owner=$lease_owner age=$age; rerun with --take-over-stale after checking liveness" >&2; exit 1;
    }
    for record in "$control"/processes/active/*.tsv "$control"/executions/*.running; do
      [[ -f $record && ! -L $record ]] || continue
      pid=$(field "$record" pid)
      expected_token=$(field "$record" start_token)
      if kill -0 "$pid" 2>/dev/null; then
        actual_token=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
        if [[ -n $actual_token && $actual_token == "$expected_token" ]]; then
          echo "STALE_LEASE_LIVE_EXECUTION: $record pid=$pid" >&2; exit 1
        fi
      fi
    done
    candidate_created=$now
  fi
  if [[ $candidate == "$workspace_lease" ]]; then workspace_created=$candidate_created; else project_created=$candidate_created; fi
done
if [[ ! -e $workspace_binding ]]; then
  workspace_binding_tmp=$(mktemp "$workspace_control/.binding.XXXXXX")
  printf "schema\t1\nproject_id\t%s\nprofile\t%s\nworkspace\t%s\nworkspace_role\trunner\nroot_hash\t%s\nremote_root\t%s\n" \
    "$project" "$profile" "$workspace" "$root_hash" "$remote_root" > "$workspace_binding_tmp"
  chmod 0600 "$workspace_binding_tmp"; mv "$workspace_binding_tmp" "$workspace_binding"
fi
if [[ ! -e $binding ]]; then
  binding_tmp=$(mktemp "$control/.binding.XXXXXX")
  printf "schema\t1\nproject_id\t%s\nprofile\t%s\nworkspace\t%s\nworkspace_role\trunner\nroot_hash\t%s\nremote_root\t%s\n" \
    "$project" "$profile" "$workspace" "$root_hash" "$remote_root" > "$binding_tmp"
  chmod 0600 "$binding_tmp"; mv "$binding_tmp" "$binding"
fi
workspace_tmp=$(mktemp "$workspace_control/.lease.XXXXXX")
printf "schema\t1\nowner_id\t%s\nproject_id\t%s\nprofile\t%s\nworkspace\t%s\nroot_hash\t%s\nremote_root\t%s\ncreated_at\t%s\nheartbeat\t%s\nttl\t%s\noperation\tup\n" \
  "$owner" "$project" "$profile" "$workspace" "$root_hash" "$remote_root" "$workspace_created" "$now" "$ttl" > "$workspace_tmp"
chmod 0600 "$workspace_tmp"
tmp=$(mktemp "$control/.lease.XXXXXX")
printf "schema\t1\nowner_id\t%s\nproject_id\t%s\ncreated_at\t%s\nheartbeat\t%s\nttl\t%s\noperation\tup\n" \
  "$owner" "$project" "$project_created" "$now" "$ttl" > "$tmp"
chmod 0600 "$tmp"
mv "$workspace_tmp" "$workspace_lease"
mv "$tmp" "$lease"
printf "REMOTE_DEV_BIND_READY\n"
' "$workspace_control" "$remote_control" "$project_id" "$profile" "$workspace" "$root_hash" \
    "$remote_root" "$owner_id" "$LEASE_TTL_SECONDS" "$take_over_stale"
}

start_watcher() {
  [[ ${REMOTE_DEV_LOCAL_AGENT_DISABLE_WATCHER:-false} != true ]] || return 0
  local pid_file=$binding_dir/watcher.pid identity_file=$binding_dir/watcher.identity.tsv pid attempt
  if [[ -e $pid_file || -e $identity_file ]]; then
    [[ -f $pid_file && ! -L $pid_file && -f $identity_file && ! -L $identity_file ]] || {
      fail 'WATCHER_IDENTITY_INVALID: watcher state is incomplete or non-regular'
      return 77
    }
    IFS= read -r pid < "$pid_file" || true
    if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      live_identity_matches "$identity_file" "$pid" && return 0
      fail "WATCHER_PID_REUSED: refusing to replace live unverified watcher PID $pid"
      return 77
    fi
    identity_matches_binding "$identity_file" "$pid" || {
      fail 'WATCHER_IDENTITY_INVALID: refusing to discard foreign watcher state'
      return 77
    }
    rm -f "$pid_file" "$identity_file"
  fi
  if [[ ${REMOTE_DEV_LOCAL_AGENT_WATCHER_LAUNCH_MODE:-daemon} != process ]]; then
    pid=$(python3 - "$script_path" "$binding_dir" "$binding_dir/watcher.log" <<'PY'
import os
import sys

script, binding, log_path = sys.argv[1:]
read_fd, write_fd = os.pipe()
child = os.fork()
if child:
    os.close(write_fd)
    payload = os.read(read_fd, 64).decode("ascii")
    os.close(read_fd)
    os.waitpid(child, 0)
    if not payload.isdigit():
        raise SystemExit("watcher daemonization did not return a PID")
    print(payload)
    raise SystemExit(0)

os.close(read_fd)
os.setsid()
grandchild = os.fork()
if grandchild:
    os.write(write_fd, str(grandchild).encode("ascii"))
    os.close(write_fd)
    os._exit(0)

os.close(write_fd)
log_fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.dup2(log_fd, 1)
os.dup2(log_fd, 2)
if log_fd > 2:
    os.close(log_fd)
os.execve(script, [script, "_watch", binding], os.environ.copy())
PY
)
    for attempt in $(seq 1 50); do
      if [[ $pid =~ ^[0-9]+$ ]] && live_identity_matches "$identity_file" "$pid" && \
         [[ -f $pid_file && ! -L $pid_file ]] && [[ $(<"$pid_file") == "$pid" ]]; then
        return 0
      fi
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    fail "WATCHER_START_FAILED: inspect $binding_dir/watcher.log"
    return 1
  fi
  nohup "$script_path" _watch "$binding_dir" > "$binding_dir/watcher.log" 2>&1 &
  pid=$!
  for attempt in $(seq 1 50); do
    if live_identity_matches "$identity_file" "$pid" && [[ -f $pid_file && ! -L $pid_file ]] && \
       [[ $(<"$pid_file") == "$pid" ]]; then
      return 0
    fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  fail "WATCHER_START_FAILED: inspect $binding_dir/watcher.log"
  return 1
}

verify_watcher_identity() {
  local pid_file=$binding_dir/watcher.pid identity_file=$binding_dir/watcher.identity.tsv pid
  [[ ! -e $pid_file && ! -e $identity_file ]] && return 0
  [[ -f $pid_file && ! -L $pid_file && -f $identity_file && ! -L $identity_file ]] || {
    fail 'WATCHER_IDENTITY_INVALID: watcher state is incomplete or non-regular'
    return 77
  }
  IFS= read -r pid < "$pid_file" || true
  if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    live_identity_matches "$identity_file" "$pid" || {
      fail "WATCHER_PID_REUSED: refusing an unverified watcher PID $pid"
      return 77
    }
  else
    identity_matches_binding "$identity_file" "$pid" || {
      fail 'WATCHER_IDENTITY_INVALID: refusing foreign dead-watcher state'
      return 77
    }
  fi
}

stop_watcher() {
  local pid_file=$binding_dir/watcher.pid identity_file=$binding_dir/watcher.identity.tsv pid attempt
  [[ ! -e $pid_file && ! -e $identity_file ]] && return 0
  [[ -f $pid_file && ! -L $pid_file && -f $identity_file && ! -L $identity_file ]] || {
    fail 'WATCHER_IDENTITY_INVALID: refusing cleanup of incomplete watcher state'
    return 77
  }
  IFS= read -r pid < "$pid_file" || true
  if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    live_identity_matches "$identity_file" "$pid" || {
      fail "WATCHER_PID_REUSED: refusing to stop unverified watcher PID $pid"
      return 77
    }
    kill "$pid" 2>/dev/null || true
    for attempt in $(seq 1 100); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.05
    done
    if kill -0 "$pid" 2>/dev/null; then
      fail "WATCHER_STOP_TIMEOUT: verified watcher PID $pid did not stop"
      return 77
    fi
    wait "$pid" 2>/dev/null || true
  else
    identity_matches_binding "$identity_file" "$pid" || {
      fail 'WATCHER_IDENTITY_INVALID: refusing cleanup of foreign watcher state'
      return 77
    }
  fi
  rm -f "$pid_file" "$identity_file"
}

new_binding_cleanup=
run_up() {
  workspace=${1:-}
  [[ -n $workspace ]] || usage_error 'local-agent up requires a workspace'
  validate_workspace "$workspace" || exit 2
  shift
  local requested_root= requested_working_set= git_metadata=not-required take_over_stale=false recover_drift=false recover_unknown=false
  local requested_workspace requested_project_id new_binding=false proposed_policy= proposed_topology=
  local requested_kind=single-root requested_topology_digest= requested_execution_member=root
  local -a allowed=() excluded=() writable=() context_roots=()
  while (( $# > 0 )); do
    case "$1" in
      --project-id) (( $# >= 2 )) || usage_error '--project-id requires a value'; project_id=$2; shift 2 ;;
      --local-project) (( $# >= 2 )) || usage_error '--local-project requires a path'; requested_root=$2; shift 2 ;;
      --working-set) (( $# >= 2 )) || usage_error '--working-set requires a manifest path'; requested_working_set=$2; shift 2 ;;
      --allow-untracked) (( $# >= 2 )) || usage_error '--allow-untracked requires a path'; allowed+=("$2"); shift 2 ;;
      --exclude-tracked) (( $# >= 2 )) || usage_error '--exclude-tracked requires a path'; excluded+=("$2"); shift 2 ;;
      --remote-writable) (( $# >= 2 )) || usage_error '--remote-writable requires a path'; writable+=("$2"); shift 2 ;;
      --git-metadata) (( $# >= 2 )) || usage_error '--git-metadata requires a mode'; git_metadata=$2; shift 2 ;;
      --take-over-stale) take_over_stale=true; shift ;;
      --recover-drift) recover_drift=true; shift ;;
      --recover-unknown) recover_unknown=true; shift ;;
      *) usage_error "unexpected local-agent up argument: $1" ;;
    esac
  done
  [[ -n $profile && -n $coder_origin ]] || usage_error 'local-agent up requires --profile and --coder-url'
  validate_profile "$profile" || exit 2
  validate_project_id "$project_id" || exit 2
  requested_workspace=$workspace
  requested_project_id=$project_id
  if [[ -n $requested_root && -n $requested_working_set ]]; then
    usage_error '--local-project and --working-set are mutually exclusive'
  fi
  [[ -n $requested_root || -n $requested_working_set ]] || usage_error 'local-agent up requires --local-project or --working-set'
  case "$git_metadata" in
    not-required|explicit-input) ;;
    required)
      printf 'UNSUPPORTED_GIT_METADATA: runner projections are Git-less.\n' >&2
      printf 'Recovery: use remote mode or provide a project-owned explicit version input.\n' >&2
      exit 1
      ;;
    *) usage_error '--git-metadata must be not-required, explicit-input, or required' ;;
  esac
  local path
  for path in "${allowed[@]}" "${excluded[@]}" "${writable[@]}"; do
    [[ -z $path ]] || validate_relative_path "$path" 'projection policy path' || exit 2
  done
  if [[ -n $requested_working_set ]]; then
    (( ${#allowed[@]} + ${#excluded[@]} + ${#writable[@]} == 0 )) || \
      usage_error 'working-set projection policy must be declared in its tracked manifest'
    [[ $git_metadata == not-required ]] || usage_error 'working-set git_metadata must be declared per member in its manifest'
    [[ $requested_working_set = /* ]] || usage_error '--working-set requires an absolute manifest path'
    requested_kind=working-set
    proposed_topology=$(mktemp "${TMPDIR:-/tmp}/remote-dev-working-set.XXXXXX")
    proposed_policy=$(mktemp "${TMPDIR:-/tmp}/remote-dev-working-set-policy.XXXXXX")
    requested_topology_digest=$(python3 "$working_set_helper" normalize --manifest "$requested_working_set" \
      --snapshot-out "$proposed_topology" --policy-out "$proposed_policy") || exit $?
    local_root=$(binding_value anchor "$proposed_topology")
    requested_execution_member=$(binding_value execution_member "$proposed_topology")
    while IFS=$'\t' read -r key member_id member_root member_remote member_mode; do
      [[ $key == member ]] || continue
      context_roots+=("$member_root")
    done < "$proposed_topology"
    context_roots+=("$local_root")
  else
    local_root=$(canonical_git_root "$requested_root") || exit 1
    context_roots+=("$local_root")
  fi
  validate_single_line "$local_root" 'canonical local authority root' || exit 2
  require_mode_authority || exit $?
  git_metadata_mode=$git_metadata
  root_hash=$(printf '%s' "$local_root" | sha256_stream)
  binding_dir=$state_root/bindings/by-root/$root_hash
  binding_file=$binding_dir/binding.tsv
  policy_file=$binding_dir/policy.tsv
  managed_manifest=$binding_dir/managed_manifest.tsv
  excluded_manifest=$binding_dir/excluded_manifest.tsv
  projection_root=$binding_dir/projection
  current_receipt=$binding_dir/current_receipt.tsv
  topology_file=$binding_dir/working-set.tsv
  member_digests=$binding_dir/member_digests.tsv
  ssh_alias=$profile.$workspace
  remote_root=/home/coder/projects/$project_id
  remote_control=/home/coder/.local/share/remote-dev/local-agent/$project_id
  mutagen_session=remote-dev-local-agent-${root_hash:0:24}
  mkdir -p "$binding_dir" "$state_root/bindings/by-runner/$profile"
  chmod 0700 "$state_root" "$state_root/bindings" "$state_root/bindings/by-root" \
    "$binding_dir" "$state_root/bindings/by-runner" "$state_root/bindings/by-runner/$profile" 2>/dev/null || true
  if [[ -e $binding_file ]]; then
    load_binding_dir "$binding_dir" || exit 1
    [[ $git_metadata_mode == "$git_metadata" ]] || { fail 'BINDING_METADATA_MODE_MISMATCH: preserve the existing binding metadata contract'; exit 1; }
    [[ $workspace == "$requested_workspace" && $project_id == "$requested_project_id" ]] || {
      fail "BINDING_IDENTITY_MISMATCH: local root is bound to $profile/$workspace project=$project_id"; exit 1;
    }
    [[ $binding_kind == "$requested_kind" ]] || { fail 'BINDING_KIND_MISMATCH: existing binding uses a different source topology'; exit 1; }
    if [[ $requested_kind == working-set ]]; then
      [[ $topology_digest == "$requested_topology_digest" ]] || {
        fail 'WORKING_SET_TOPOLOGY_DRIFT: run exact local-agent down using the stored binding, then rebind'; exit 79;
      }
      cmp -s "$policy_file" "$proposed_policy" || {
        fail 'BINDING_POLICY_MISMATCH: working-set projection policy is immutable'; exit 1;
      }
      if [[ -n $reanchor_retained_file ]] && ! cmp -s "$reanchor_retained_file" "$binding_dir/retained.tsv"; then
        fail 'REANCHOR_BINDING_MISMATCH: the existing binding does not carry the retained areas of this re-anchor'; exit 1
      fi
    elif (( ${#allowed[@]} + ${#excluded[@]} + ${#writable[@]} > 0 )); then
      proposed_policy=$(mktemp "$binding_dir/.proposed-policy.XXXXXX")
      {
        for path in "${allowed[@]}"; do printf 'allowed_untracked\t%s\n' "$path"; done
        for path in "${excluded[@]}"; do printf 'tracked_exclusion\t%s\n' "$path"; done
        for path in "${writable[@]}"; do printf 'remote_writable\t%s\n' "$path"; done
      } | LC_ALL=C sort -u > "$proposed_policy"
      if ! cmp -s "$policy_file" "$proposed_policy"; then
        rm -f "$proposed_policy"
        fail 'BINDING_POLICY_MISMATCH: existing projection policy is immutable; create a new binding or use its exact policy.'
        exit 1
      fi
      rm -f "$proposed_policy"
    fi
  else
    new_binding=true
    new_binding_cleanup=$binding_dir
    binding_kind=$requested_kind
    topology_digest=$requested_topology_digest
    execution_member=$requested_execution_member
    owner_id=$(printf '%s\n%s\n%s\n%s\n' "$profile" "$workspace" "$local_root" "$(date +%s)-$$-$RANDOM" | sha256_stream)
    if [[ $binding_kind == working-set ]]; then
      mv "$proposed_topology" "$topology_file"
      mv "$proposed_policy" "$policy_file"
      # Remote-owned areas a re-anchor left outside every member stay excluded
      # from synchronization and audits for the lifetime of this binding.
      [[ -z $reanchor_retained_file ]] || write_atomic "$binding_dir/retained.tsv" < "$reanchor_retained_file"
      proposed_topology=
      proposed_policy=
    else
      topology_file=
      topology_digest=
      {
        for path in "${allowed[@]}"; do printf 'allowed_untracked\t%s\n' "$path"; done
        for path in "${excluded[@]}"; do printf 'tracked_exclusion\t%s\n' "$path"; done
        for path in "${writable[@]}"; do printf 'remote_writable\t%s\n' "$path"; done
      } | LC_ALL=C sort -u | write_atomic "$policy_file"
    fi
  fi
  [[ -z $proposed_topology ]] || rm -f "$proposed_topology"
  [[ -z $proposed_policy || $proposed_policy == "$policy_file" ]] || rm -f "$proposed_policy"
  claim_binding_contexts "${context_roots[@]}" || exit $?
  ensure_platform
  ensure_coder_context
  ensure_ssh_alias
  require_runner_role
  remote_bind "$take_over_stale" >/dev/null
  if [[ $new_binding == true ]]; then
    write_binding
    new_binding_cleanup=
  fi
  created_binding_claims=()
  resolved_local_cwd=$local_root
  if [[ $binding_kind == working-set ]]; then
    local up_context
    up_context=$(python3 "$working_set_helper" context --snapshot "$topology_file" \
      --path "$local_root" --remote-root "$remote_root") || exit $?
    resolved_member=$(printf '%s\n' "$up_context" | awk -F '\t' '$1 == "member" {print $2; exit}')
    remote_cwd=$(printf '%s\n' "$up_context" | awk -F '\t' '$1 == "remote_cwd" {print $2; exit}')
  else
    resolved_member=root
    remote_cwd=$remote_root
  fi
  if [[ $recover_unknown == true ]]; then
    if remote_bash '
set -euo pipefail
control=$1 owner=$2 project=$3 profile=$4 workspace=$5 root_hash=$6 remote_root=$7
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
mkdir -p "$control/executions/recovered"
for running in "$control"/executions/*.running; do
  [[ -f $running && ! -L $running ]] || continue
  [[ $(field "$running" schema) == 2 && $(field "$running" owner_id) == "$owner" && \
     $(field "$running" project_id) == "$project" && $(field "$running" profile) == "$profile" && \
     $(field "$running" workspace) == "$workspace" && $(field "$running" root_hash) == "$root_hash" && \
     $(field "$running" remote_root) == "$remote_root" ]] || {
    echo "UNKNOWN_EXECUTION_BINDING_IDENTITY_MISMATCH: $running" >&2; exit 1;
  }
  pid=$(field "$running" pid); expected=$(field "$running" start_token)
  if kill -0 "$pid" 2>/dev/null; then
    actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    [[ -z $actual || $actual != "$expected" ]] || { echo "UNKNOWN_EXECUTION_LIVE: $running pid=$pid" >&2; exit 1; }
    reason=pid-reused
  else
    reason=stale
  fi
  printf "recovered_at\t%s\nrecovery_reason\t%s\n" "$(date +%s)" "$reason" >> "$running"
  mv "$running" "$control/executions/recovered/$(basename "$running")"
done
' "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" "$remote_root"; then
      rm -f "$binding_dir/UNKNOWN_EXECUTION" "$binding_dir/LEASE_HEARTBEAT_FAILED"
    else
      fail 'UNKNOWN_EXECUTION remains live or foreign remotely; resolve it explicitly before recovery.'
      exit 1
    fi
  fi
  if [[ $recover_drift == true && -e $binding_dir/REMOTE_DRIFT ]]; then
    if [[ ! -f $binding_dir/current-manifest.id ]]; then
      reset_unaccepted_remote_projection
      rm -f "$binding_dir/REMOTE_DRIFT" "$binding_dir/SYNC_FAILED"
      mutagen sync terminate "$mutagen_session" >/dev/null 2>&1 || true
    else
    materialize_projection
    local recovery_remote
    recovery_remote=$(mktemp "$binding_dir/.recover-manifest.XXXXXX")
    remote_manifest_to "$recovery_remote"
    if ! cmp -s "$managed_manifest" "$recovery_remote"; then
      rm -f "$recovery_remote"
      fail 'REMOTE_DRIFT still differs; restore remote managed paths to local state before recovery.'
      exit 74
    fi
    rm -f "$recovery_remote" "$binding_dir/REMOTE_DRIFT"
    mutagen sync terminate "$mutagen_session" >/dev/null 2>&1 || true
    fi
  fi
  acquire_lock || return $?
  sync_barrier true true || return $?
  [[ $binding_kind != single-root || ! -f $local_root/.gitmodules ]] || \
    printf 'WARNING: tracked .gitmodules may indicate an unsupported Git metadata dependency.\n' >&2
  start_watcher || return $?
  cat <<EOF
READY          Local Agent / Remote Runner
Codex host     macOS local
Source         $local_root (authoritative)
Binding kind   $binding_kind
Runner         $profile/$workspace (role=runner)
Member         $resolved_member
Remote workdir $remote_root (Git-less projection)
Remote cwd     $remote_cwd
Manifest       $manifest_id
Execution      build/test/run/debug commands are remote through runner tools
EOF
}

prepare_bound_command() {
  local operation=${1:-command}
  require_mode_authority || return $?
  assert_topology_current || return $?
  ensure_platform
  ensure_coder_context
  require_runner_role
  refresh_remote_lease "$operation" || return $?
}

policy_update_dir=
rollback_policy_update() {
  [[ -n $policy_update_dir ]] || return 0
  # Keep the operation lock if pausing or restoring fails. A later caller must
  # inspect that interrupted transaction instead of transferring its candidate.
  mutagen sync pause "$mutagen_session" >/dev/null || {
    fail "POLICY_UPDATE_ROLLBACK_FAILED: cannot pause transfer; inspect $policy_update_dir"
    return 79
  }
  local name
  for name in policy.tsv managed_manifest.tsv excluded_manifest.tsv current-manifest.id watcher-baseline.token mutagen-policy.id; do
    cat "$policy_update_dir/$name" | write_atomic "$binding_dir/$name" || return 79
  done
  find "$projection_root" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + || return 79
  cp -Rp "$policy_update_dir/projection/." "$projection_root/" || return 79
  printf 'SYNC_FAILED\nreason\tpolicy-update-rolled-back\ndetected_at\t%s\n' "$(date +%s)" | \
    write_atomic "$binding_dir/SYNC_FAILED" || return 79
  printf 'POLICY_UPDATE_ROLLED_BACK: accepted policy and local projection restored; transfer remains paused.\n' >&2
  printf 'Recovery: inspect local-agent status and resolve remote drift or connectivity before retrying the same command.\n' >&2
  rm -rf -- "$policy_update_dir"
  policy_update_dir=
}

run_allow_untracked() {
  parse_binding_target "$@"
  [[ $binding_kind == single-root ]] || { fail 'POLICY_UPDATE_UNSUPPORTED: only single-root bindings support additive source updates'; return 2; }
  local -a paths=()
  set -- "${parsed_args[@]}"
  while (( $# > 0 )); do
    [[ $1 == --path && $# -ge 2 ]] || usage_error 'allow-untracked accepts only repeated --path <exact-file>'
    validate_relative_path "$2" 'untracked source path' || return 2
    paths+=("$2"); shift 2
  done
  (( ${#paths[@]} > 0 )) || usage_error 'allow-untracked requires at least one --path <exact-file>'
  acquire_lock
  prepare_bound_command policy-update
  [[ ! -e $binding_dir/SYNC_FAILED ]] || { fail 'SYNC_FAILED: recover the existing binding with local-agent up before extending its policy'; return 79; }
  local candidate snapshot name accepted_policy=$policy_file
  candidate=$(mktemp "$binding_dir/.additive-policy.XXXXXX")
  projection_temps+=("$candidate")
  python3 - "$local_root" "$policy_file" "$candidate" "${paths[@]}" <<'PY'
import os
from pathlib import Path
import stat
import subprocess
import sys

root, policy, candidate, *paths = sys.argv[1:]
rows = set(Path(policy).read_text().splitlines())
protected = [line.split('\t', 1)[1] for line in rows
             if line.startswith(('remote_writable\t', 'tracked_exclusion\t'))]
standard = {'node_modules', 'dist', 'build', 'coverage', 'target'}
for path in paths:
    parts = path.split('/')
    if any(char in path for char in '*?[]:'):
        raise SystemExit('POLICY_UPDATE_PATH_UNSAFE: pathspec syntax: ' + path)
    if any(part.startswith('.') or part in standard for part in parts):
        raise SystemExit('POLICY_UPDATE_PATH_UNSAFE: hidden or runtime path: ' + path)
    if any(any(word in part.lower() for word in ('secret', 'credential'))
           or part.lower() in ('id_rsa', 'id_ed25519')
           or part.lower().endswith(('.pem', '.key', '.p12', '.pfx')) for part in parts):
        raise SystemExit('POLICY_UPDATE_PATH_UNSAFE: secret path: ' + path)
    if any(path == p or path.startswith(p + '/') or p.startswith(path + '/') for p in protected):
        raise SystemExit('PROJECTION_POLICY_OVERLAP: ' + path)
    current = Path(root)
    for part in parts:
        current /= part
        if current.is_symlink():
            raise SystemExit('POLICY_UPDATE_PATH_UNSAFE: symlink: ' + path)
    if not current.is_file() or not stat.S_ISREG(current.lstat().st_mode):
        raise SystemExit('POLICY_UPDATE_PATH_UNSAFE: requires an existing regular file: ' + path)
    result = subprocess.run(['git', '--literal-pathspecs', '-C', root, 'ls-files',
                             '--others', '--exclude-standard', '-z', '--', path],
                            check=True, stdout=subprocess.PIPE)
    if result.stdout != os.fsencode(path) + b'\0':
        raise SystemExit('POLICY_UPDATE_PATH_UNSAFE: requires an exact non-ignored untracked file: ' + path)
    rows.add('allowed_untracked_file\t' + path)
Path(candidate).write_text('\n'.join(sorted(rows)) + '\n')
PY
  [[ -f $binding_dir/current-manifest.id ]] || { fail 'POLICY_UPDATE_UNACCEPTED: establish the existing binding first'; return 79; }
  stop_watcher
  snapshot=$(mktemp -d "$binding_dir/.policy-update.XXXXXX")
  projection_temps+=("$snapshot")
  for name in policy.tsv managed_manifest.tsv excluded_manifest.tsv current-manifest.id watcher-baseline.token mutagen-policy.id; do
    cp "$binding_dir/$name" "$snapshot/$name"
  done
  cp -Rp "$projection_root" "$snapshot/projection"
  # Arm rollback only after the complete accepted state has been captured.
  # A killed process leaves its verified operation lock and snapshot in place.
  policy_update_dir=$snapshot
  policy_file=$candidate
  sync_barrier false true
  mv "$candidate" "$accepted_policy"
  policy_file=$accepted_policy
  mutagen sync resume "$mutagen_session" >/dev/null
  policy_update_dir=
  rm -rf -- "$snapshot"
  start_watcher
  printf 'READY          Local Agent source policy extended\nManifest       %s\n' "$manifest_id"
}

run_resume() {
  local -a args=("$@")
  parse_binding_target "${args[@]}"
  require_mode_authority || return $?
  args=("${parsed_args[@]}")
  (( ${#args[@]} == 0 )) || usage_error "unexpected resume argument: ${args[0]}"
  assert_topology_current || return $?
  ensure_platform
  ensure_coder_context
  acquire_lock || return $?
  stop_watcher || return $?
  "$workspace_helper" --profile "$profile" --coder-url "$coder_origin" \
    start "$workspace" || return $?
  ensure_ssh_alias
  require_runner_role || return $?
  remote_bind false >/dev/null || return $?
  sync_barrier true true || return $?
  release_lock
  start_watcher || return $?
  cat <<EOF
READY          Local Agent binding resumed
Source         $local_root (authoritative)
Runner         $profile/$workspace (role=runner)
Remote cwd     $remote_cwd
Synchronization restored
Managed        processes are not restarted automatically; inspect runner_status
EOF
}

run_status() {
  local -a args=("$@")
  parse_binding_target "${args[@]}"
  args=("${parsed_args[@]}")
  (( ${#args[@]} == 0 )) || usage_error "unexpected status argument: ${args[0]}"
  ensure_platform
  ensure_coder_context
  require_runner_role
  local drift=clean topology=clean unknown=clean sync_state=clean heartbeat=clean rollback=clean watcher=stopped pid= local_blocked=false remote_status=0
  local transfer=inactive activity=idle lock=$binding_dir/operation.lock lock_pid lock_expected lock_actual lock_operation
  local watcher_identity=$binding_dir/watcher.identity.tsv heartbeat_identity heartbeat_pid heartbeat_parent heartbeat_expected heartbeat_actual
  [[ ! -e $binding_dir/REMOTE_DRIFT ]] || drift=REMOTE_DRIFT
  if [[ $binding_kind == working-set ]] && ! assert_topology_current >/dev/null; then
    topology=WORKING_SET_TOPOLOGY_DRIFT
    local_blocked=true
  fi
  [[ ! -e $binding_dir/UNKNOWN_EXECUTION ]] || unknown=UNKNOWN_EXECUTION
  [[ ! -e $binding_dir/SYNC_FAILED ]] || sync_state=SYNC_FAILED
  [[ ! -e $binding_dir/LEASE_HEARTBEAT_FAILED ]] || heartbeat=LEASE_HEARTBEAT_FAILED
  if [[ -e $binding_dir/PROCESS_ROLLBACK_FAILED ]]; then
    if [[ -f $binding_dir/PROCESS_ROLLBACK_FAILED && ! -L $binding_dir/PROCESS_ROLLBACK_FAILED ]]; then
      rollback=PROCESS_ROLLBACK_FAILED
    else
      rollback=PROCESS_ROLLBACK_MARKER_INVALID
    fi
  fi
  if [[ $drift != clean || $unknown != clean || $sync_state != clean || $heartbeat != clean || $rollback != clean ]]; then local_blocked=true; fi
  if [[ -f $binding_dir/watcher.pid && ! -L $binding_dir/watcher.pid && -f $watcher_identity && ! -L $watcher_identity ]]; then
    IFS= read -r pid < "$binding_dir/watcher.pid" || true
    if live_identity_matches "$watcher_identity" "$pid"; then
      watcher=running
    elif identity_matches_binding "$watcher_identity" "$pid" && ! kill -0 "$pid" 2>/dev/null; then
      watcher=stopped
    else
      watcher=pid-reused-or-foreign
      local_blocked=true
    fi
  elif [[ -e $binding_dir/watcher.pid || -e $watcher_identity ]]; then
    watcher=identity-invalid
    local_blocked=true
  fi
  if [[ -e $lock || -L $lock ]]; then
    if [[ ! -d $lock || -L $lock || ! -f $lock/pid || -L $lock/pid || \
          ! -f $lock/start_token || -L $lock/start_token || \
          ! -f $lock/operation || -L $lock/operation ]]; then
      activity=lock-invalid
      local_blocked=true
    else
      IFS= read -r lock_pid < "$lock/pid" || lock_pid=
      IFS= read -r lock_expected < "$lock/start_token" || lock_expected=
      IFS= read -r lock_operation < "$lock/operation" || lock_operation=unknown
      lock_actual=
      [[ $lock_pid =~ ^[0-9]+$ ]] && lock_actual=$(process_start_token "$lock_pid")
      if [[ -n $lock_actual && $lock_actual == "$lock_expected" ]]; then
        activity="$lock_operation (pid=$lock_pid)"
      else
        activity=lock-stale-or-reused
        local_blocked=true
      fi
    fi
  fi
  for heartbeat_identity in "$binding_dir"/execution-heartbeats/*.identity.tsv; do
    [[ -e $heartbeat_identity ]] || continue
    if ! identity_matches_binding "$heartbeat_identity"; then
      printf 'Execution heartbeat %s identity-mismatch\n' "$(basename "$heartbeat_identity" .identity.tsv)"
      local_blocked=true
      continue
    fi
    heartbeat_pid=$(binding_value pid "$heartbeat_identity")
    heartbeat_parent=$(binding_value parent_pid "$heartbeat_identity" 2>/dev/null || true)
    heartbeat_expected=$(binding_value parent_start_token "$heartbeat_identity" 2>/dev/null || true)
    heartbeat_actual=
    [[ $heartbeat_parent =~ ^[0-9]+$ ]] && heartbeat_actual=$(process_start_token "$heartbeat_parent")
    if live_identity_matches "$heartbeat_identity" "$heartbeat_pid" && \
       [[ -n $heartbeat_actual && $heartbeat_actual == "$heartbeat_expected" ]]; then
      printf 'Execution heartbeat %s live\n' "$(basename "$heartbeat_identity" .identity.tsv)"
    else
      printf 'Execution heartbeat %s pid-reused-or-parent-mismatch\n' "$(basename "$heartbeat_identity" .identity.tsv)"
      local_blocked=true
    fi
  done
  if mutagen_session_exists; then
    transfer=managed
  elif [[ $watcher == running ]]; then
    local_blocked=true
  fi
  printf 'Mode           local-agent\nBinding kind   %s\nProfile        %s\nCoder origin   %s\nWorkspace      %s\nWorkspace role runner\nProject        %s\nLocal root     %s\nRemote root    %s\nResolved member %s\nRemote cwd     %s\nTopology       %s\nProjection     %s\nSynchronization %s\nTransfer       %s\nActivity       %s\nProcess rollback %s\nUnknown exec   %s\nLease heartbeat %s\nWatcher        %s\n' \
    "$binding_kind" \
    "$profile" "$coder_origin" "$workspace" "$project_id" "$local_root" \
    "$remote_root" "$resolved_member" "$remote_cwd" "$topology" "$drift" "$sync_state" "$transfer" "$activity" "$rollback" "$unknown" "$heartbeat" "$watcher"
  if [[ $rollback == PROCESS_ROLLBACK_FAILED ]]; then
    printf 'Rollback handle %s\nRollback reason %s\n' \
      "$(binding_value handle "$binding_dir/PROCESS_ROLLBACK_FAILED" 2>/dev/null || printf invalid)" \
      "$(binding_value reason "$binding_dir/PROCESS_ROLLBACK_FAILED" 2>/dev/null || printf invalid)"
  fi
  if [[ -f $managed_manifest ]]; then
    printf 'Manifest       %s\n' "$(sha256_file "$managed_manifest")"
  fi
  if [[ -s $binding_dir/retained.tsv ]]; then
    printf 'Retained       %s\n' "$(cut -f 2 "$binding_dir/retained.tsv" | paste -sd ' ' -)"
  fi
  if [[ -f $current_receipt ]]; then
    printf 'Receipt        %s\n' "$current_receipt"
  fi
  if [[ ${REMOTE_DEV_LOCAL_AGENT_STATUS_VERBOSE:-false} == true ]] && mutagen_session_exists; then
    mutagen sync list "$mutagen_session" || true
  fi
  set +e
  remote_bash '
set -euo pipefail
workspace_control=$1 control=$2 owner=$3 project=$4 profile=$5 workspace=$6 root_hash=$7 remote_root=$8
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
blocked=false
released=false
workspace_binding=$workspace_control/binding.tsv
workspace_lease=$workspace_control/lease.tsv
if [[ ! -e $workspace_binding && ! -e $workspace_lease ]]; then
  printf "workspace_claim\treleased\n"
  released=true
elif [[ ! -f $workspace_binding || -L $workspace_binding || ! -f $workspace_lease || -L $workspace_lease ]]; then
  printf "workspace_claim\tmissing-or-invalid\n"
  blocked=true
elif [[ $(field "$workspace_binding" project_id) != "$project" || $(field "$workspace_binding" profile) != "$profile" || \
        $(field "$workspace_binding" workspace) != "$workspace" || $(field "$workspace_binding" root_hash) != "$root_hash" || \
        $(field "$workspace_binding" remote_root) != "$remote_root" || $(field "$workspace_lease" owner_id) != "$owner" ]]; then
  printf "workspace_claim\tidentity-or-owner-mismatch\n"
  blocked=true
else
  printf "workspace_claim\towned\n"
fi
lease=$control/lease.tsv
if [[ -f $lease && ! -L $lease ]]; then
  cat "$lease"
  [[ $released == false ]] || blocked=true
elif [[ ! -e $lease ]]; then
  echo "lease\tmissing"
  [[ $released == true ]] || blocked=true
else
  echo "lease\tinvalid"
  blocked=true
fi
for record in "$control"/processes/active/*.tsv; do
  [[ -f $record ]] || continue
  record_owner=$(field "$record" owner_id); pid=$(field "$record" pid); expected=$(field "$record" start_token)
  sid=$(field "$record" session_id); pgid=$(field "$record" process_group_id)
  state=stale
  if [[ $(field "$record" schema) != 2 || $record_owner != "$owner" || \
        $(field "$record" project_id) != "$project" || $(field "$record" profile) != "$profile" || \
        $(field "$record" workspace) != "$workspace" || $(field "$record" root_hash) != "$root_hash" || \
        $(field "$record" remote_root) != "$remote_root" ]]; then
    state=binding-identity-mismatch
    blocked=true
  elif [[ ! $pid =~ ^[0-9]+$ || ! $sid =~ ^[0-9]+$ || ! $pgid =~ ^[0-9]+$ ]]; then
    state=identity-invalid
    blocked=true
  elif kill -0 "$pid" 2>/dev/null; then
    actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    actual_sid=$(ps -p "$pid" -o sid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
    actual_pgid=$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
    if [[ -n $actual && $actual == "$expected" && $actual_sid == "$sid" && $actual_pgid == "$pgid" && $sid == "$pid" ]]; then
      state=live
    else
      state=pid-reused-or-session-mismatch; blocked=true
    fi
  elif pgrep -s "$sid" >/dev/null 2>&1; then
    state=leader-missing-session-live
    blocked=true
  else
    blocked=true
  fi
  printf "active_process\t%s\t%s\tpid=%s\n" "$(basename "$record" .tsv)" "$state" "$pid"
done
for recovery_record in "$control"/processes/recovery/*.tsv; do
  [[ -e $recovery_record || -L $recovery_record ]] || continue
  handle=$(basename "$recovery_record" .tsv)
  [[ $handle =~ ^proc-[0-9]{8}T[0-9]{6}-[0-9]+-[0-9]+$ ]] || continue
  identity=$control/processes/recovery/$handle.identity.tsv
  state=identity-pending
  pid=-
  if [[ ! -f $recovery_record || -L $recovery_record || \
        $(field "$recovery_record" schema) != 2 || $(field "$recovery_record" owner_id) != "$owner" || \
        $(field "$recovery_record" project_id) != "$project" || $(field "$recovery_record" profile) != "$profile" || \
        $(field "$recovery_record" workspace) != "$workspace" || $(field "$recovery_record" root_hash) != "$root_hash" || \
        $(field "$recovery_record" remote_root) != "$remote_root" || $(field "$recovery_record" handle) != "$handle" || \
        $(field "$recovery_record" identity_file) != "$identity" || \
        ! -f $control/processes/recovery/$handle.argv || -L $control/processes/recovery/$handle.argv || \
        ! -f $control/processes/recovery/$handle.revisions || -L $control/processes/recovery/$handle.revisions ]]; then
    state=binding-identity-mismatch
  elif [[ -e $identity || -L $identity ]]; then
    if [[ ! -f $identity || -L $identity ]]; then
      state=identity-invalid
    else
      pid=$(field "$identity" pid); expected=$(field "$identity" start_token)
      sid=$(field "$identity" session_id); pgid=$(field "$identity" process_group_id)
      if [[ ! $pid =~ ^[0-9]+$ || ! $sid =~ ^[0-9]+$ || ! $pgid =~ ^[0-9]+$ ]]; then
        state=identity-invalid
      elif kill -0 "$pid" 2>/dev/null; then
        actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
        actual_sid=$(ps -p "$pid" -o sid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
        actual_pgid=$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
        if [[ -n $actual && $actual == "$expected" && $actual_sid == "$sid" && $actual_pgid == "$pgid" && $sid == "$pid" ]]; then
          state=live
        else
          state=pid-reused-or-session-mismatch
        fi
      elif pgrep -s "$sid" >/dev/null 2>&1; then
        state=leader-missing-session-live
      else
        state=stale
      fi
    fi
  fi
  printf "recovery_process\t%s\t%s\tpid=%s\n" "$handle" "$state" "$pid"
  blocked=true
done
for running in "$control"/executions/*.running; do
  [[ -f $running && ! -L $running ]] || continue
  running_owner=$(field "$running" owner_id); pid=$(field "$running" pid); expected=$(field "$running" start_token)
  state=stale
  if [[ $running_owner != "$owner" || $(field "$running" project_id) != "$project" || \
        $(field "$running" profile) != "$profile" || $(field "$running" workspace) != "$workspace" || \
        $(field "$running" root_hash) != "$root_hash" || $(field "$running" remote_root) != "$remote_root" ]]; then
    state=binding-identity-mismatch
  elif kill -0 "$pid" 2>/dev/null; then
    actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    if [[ -n $actual && $actual == "$expected" ]]; then state=live; else state=pid-reused; fi
  fi
  printf "remote_execution\t%s\t%s\tpid=%s\n" "$(basename "$running" .running)" "$state" "$pid"
  blocked=true
done
if timeout -k 1 4 getent hosts example.com >/dev/null 2>&1; then
  printf "network\tok\n"
else
  printf "network\tunavailable\texample.com lookup failed; run remote-dev doctor for this profile\n"
fi
[[ $blocked == false ]] || exit 79
[[ $released == false ]] || exit 80
' "$workspace_control" "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" "$remote_root"
  remote_status=$?
  set -e
  if (( remote_status == 0 )) && [[ $watcher != running ]]; then
    local_blocked=true
  fi
  if [[ $local_blocked == true || $remote_status != 0 ]]; then
    if [[ $local_blocked == false && $remote_status == 80 ]]; then
      printf 'Health         inactive\nRecovery       run local-agent up for this root to reacquire the dedicated runner.\n'
      return 0
    fi
    printf 'Health         blocked\nRecovery       inspect the reported marker/record; use explicit up recovery only after liveness is resolved.\n'
    return 79
  fi
  printf 'Health         ready\n'
}

prepare_tracked_inventory() {
  local receipt_id=$1 input_file input_sha remote_inventory
  inventory_environment=()
  [[ $git_metadata_mode == explicit-input ]] || return 0
  [[ $binding_kind == single-root ]] || { fail 'TRACKED_INVENTORY_UNSUPPORTED: explicit index input currently requires a single-root binding'; return 1; }
  input_file=$(mktemp "$binding_dir/.tracked-inventory.XXXXXX")
  if ! python3 "$tracked_inventory_helper" "$local_root" "$managed_manifest" "$remote_root" "$receipt_id" > "$input_file"; then
    rm -f "$input_file"
    return 1
  fi
  input_sha=$(sha256_file "$input_file")
  remote_inventory=$remote_control/inventories/$input_sha.json
  if ! remote_bash '
set -euo pipefail
control=$1 expected=$2
python3 -c '"'"'
import hashlib,os,pathlib,sys,tempfile
control=pathlib.Path(sys.argv[1]); expected=sys.argv[2]
if control.resolve()!=control or not control.is_dir(): raise SystemExit("INVENTORY_CONTROL_INVALID")
directory=control/"inventories"
if directory.is_symlink(): raise SystemExit("INVENTORY_CONTROL_INVALID")
directory.mkdir(mode=0o700,exist_ok=True)
payload=sys.stdin.buffer.read()
if hashlib.sha256(payload).hexdigest()!=expected: raise SystemExit("INVENTORY_CHECKSUM_INVALID")
path=directory/(expected+".json")
if path.exists():
 if path.is_symlink() or path.read_bytes()!=payload: raise SystemExit("INVENTORY_CONFLICT")
else:
 fd,name=tempfile.mkstemp(dir=directory)
 try:
  with os.fdopen(fd,"wb") as stream:
   stream.write(payload);stream.flush();os.fsync(stream.fileno())
  os.link(name,path,follow_symlinks=False)
 finally: os.unlink(name)
'"'"' "$control" "$expected"
' "$remote_control" "$input_sha" < "$input_file"; then
    rm -f "$input_file"
    return 1
  fi
  rm -f "$input_file"
  inventory_environment=(/usr/bin/env "REMOTE_DEV_TRACKED_INVENTORY=$remote_inventory" \
    "REMOTE_DEV_TRACKED_INVENTORY_SHA256=$input_sha" "REMOTE_DEV_EXECUTION_RECEIPT_ID=$receipt_id" \
    "REMOTE_DEV_PROJECTION_MANIFEST_ID=$manifest_id")
}

run_exec() {
  local -a args=("$@") command_argv=()
  local timeout_seconds=0 receipt_fd=
  parse_binding_target "${args[@]}"
  args=("${parsed_args[@]}")
  while (( ${#args[@]} > 0 )); do
    case "${args[0]}" in
      --timeout-seconds)
        (( ${#args[@]} >= 2 )) || usage_error '--timeout-seconds requires a value'
        timeout_seconds=${args[1]}; args=("${args[@]:2}") ;;
      --receipt-fd)
        (( ${#args[@]} >= 2 )) || usage_error '--receipt-fd requires a value'
        receipt_fd=${args[1]}; args=("${args[@]:2}") ;;
      --) command_argv=("${args[@]:1}"); args=(); break ;;
      *) usage_error "unexpected exec argument: ${args[0]}" ;;
    esac
  done
  (( ${#command_argv[@]} > 0 )) || usage_error 'exec requires -- followed by argv'
  [[ $timeout_seconds =~ ^[0-9]+$ ]] || usage_error '--timeout-seconds must be a non-negative integer'
  if [[ -n $receipt_fd ]]; then
    [[ $receipt_fd =~ ^[3-9][0-9]*$ ]] || usage_error '--receipt-fd must be an open numeric descriptor >= 3'
    [[ -w /dev/fd/$receipt_fd ]] || usage_error "receipt file descriptor is not open: $receipt_fd"
  fi
  if [[ ${command_argv[0]} == git || ${command_argv[0]} == */git ]]; then
    printf 'UNSUPPORTED_GIT_METADATA: Git commands do not run in a Git-less runner projection.\n' >&2
    exit 1
  fi
  # Preflight SSH calls must not consume the caller's command input. In
  # particular mode lifecycle passes its frozen request on stdin.
  {
  register_foreground_waiter || return $?
  prepare_bound_command
  acquire_lock || return $?
  sync_barrier false true || { status=$?; release_lock; return "$status"; }
  refresh_remote_lease exec || { status=$?; release_lock; return "$status"; }
  local receipt_id started finished remote_result remote_result_local status=0 exit_code signal=- timed_out=false result=completed
  receipt_id=$(date +%Y%m%dT%H%M%S)-$$-$RANDOM
  prepare_tracked_inventory "$receipt_id" || { status=$?; release_lock; return "$status"; }
  command_argv=("${inventory_environment[@]}" "${command_argv[@]}")
  started=$(date +%s)
  remote_result=$remote_control/executions/$receipt_id.result
  start_execution_heartbeat "$receipt_id" || { status=$?; release_lock; return "$status"; }
  } </dev/null
  set +e
  remote_bash '
set -u
root=$1 cwd=$2 control=$3 owner=$4 project=$5 profile=$6 workspace=$7 root_hash=$8 member=$9
topology=${10} manifest=${11} timeout_seconds=${12} result_file=${13}; shift 13
mkdir -p "$control/executions"
running=${result_file%.result}.running
token=$(ps -p $$ -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
[[ -n $token ]] || token=unavailable
printf "schema\t2\npid\t%s\nstart_token\t%s\nowner_id\t%s\nproject_id\t%s\nprofile\t%s\nworkspace\t%s\nroot_hash\t%s\nremote_root\t%s\nmember_id\t%s\nremote_cwd\t%s\ntopology_digest\t%s\nmanifest_id\t%s\n" \
  "$$" "$token" "$owner" "$project" "$profile" "$workspace" "$root_hash" "$root" \
  "$member" "$cwd" "$topology" "$manifest" > "$running"
cd "$cwd" || exit 72
if (( timeout_seconds > 0 )); then
  /usr/bin/timeout --signal=TERM --kill-after=5s "$timeout_seconds" "$@"
else
  "$@"
fi
status=$?
timed_out=false
signal=-
if (( status == 124 || status == 137 )); then timed_out=true; fi
if (( status > 128 )); then signal=$((status - 128)); fi
tmp=$(mktemp "$control/executions/.result.XXXXXX")
printf "exit_code\t%s\nsignal\t%s\ntimed_out\t%s\n" "$status" "$signal" "$timed_out" > "$tmp"
chmod 0600 "$tmp"; mv "$tmp" "$result_file"; rm -f "$running"
exit "$status"
' "$remote_root" "$remote_cwd" "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" \
    "$resolved_member" "${topology_digest:--}" "$manifest_id" "$timeout_seconds" "$remote_result" "${command_argv[@]}"
  status=$?
  set -e
  stop_execution_heartbeat
  finished=$(date +%s)
  remote_result_local=$(mktemp "$binding_dir/.exec-result.XXXXXX")
  if coder_ssh cat "$remote_result" > "$remote_result_local" 2>/dev/null; then
    exit_code=$(awk -F '\t' '$1 == "exit_code" {print $2}' "$remote_result_local")
    signal=$(awk -F '\t' '$1 == "signal" {print $2}' "$remote_result_local")
    timed_out=$(awk -F '\t' '$1 == "timed_out" {print $2}' "$remote_result_local")
    rm -f "$remote_result_local"
  else
    rm -f "$remote_result_local"
    printf 'UNKNOWN_EXECUTION\nreceipt_id\t%s\ndetected_at\t%s\n' "$receipt_id" "$finished" | \
      write_atomic "$binding_dir/UNKNOWN_EXECUTION"
    result=unknown
    exit_code=$status
  fi
  if [[ -e $binding_dir/LEASE_HEARTBEAT_FAILED ]]; then
    post_execution_drift_check false || true
    result=lease-heartbeat-failed
    write_exec_receipt "$receipt_id" "$started" "$finished" "$exit_code" "$signal" "$timed_out" "$result" "${command_argv[@]}"
    emit_receipt_fd "$receipt_fd"
    release_lock
    return 78
  fi
  if [[ $result == unknown ]]; then
    if ! post_execution_drift_check false; then
      result=remote-drift
      write_exec_receipt "$receipt_id" "$started" "$finished" "$exit_code" "$signal" "$timed_out" "$result" "${command_argv[@]}"
      emit_receipt_fd "$receipt_fd"
      release_lock
      return 74
    fi
    write_exec_receipt "$receipt_id" "$started" "$finished" "$exit_code" "$signal" "$timed_out" "$result" "${command_argv[@]}"
    emit_receipt_fd "$receipt_fd"
    release_lock
    return 75
  fi
  if ! post_execution_drift_check true; then
    result=remote-drift
    write_exec_receipt "$receipt_id" "$started" "$finished" "$exit_code" "$signal" "$timed_out" "$result" "${command_argv[@]}"
    emit_receipt_fd "$receipt_fd"
    release_lock
    return 74
  fi
  write_exec_receipt "$receipt_id" "$started" "$finished" "$exit_code" "$signal" "$timed_out" "$result" "${command_argv[@]}"
  emit_receipt_fd "$receipt_fd"
  release_lock
  return "$exit_code"
}

process_handle_valid() {
  [[ $1 =~ ^proc-[0-9]{8}T[0-9]{6}-[0-9]+-[0-9]+$ ]]
}

remote_start_handle() {
  local handle=$1 start_manifest=$2 start_member=$3 start_cwd=$4 start_topology=$5
  shift 5
  remote_bash '
set -euo pipefail
workspace_control=$1 root=$2 cwd=$3 control=$4 owner=$5 project=$6 profile=$7 workspace=$8 root_hash=$9
handle=${10} manifest=${11} member=${12} topology=${13}; shift 13
active=$control/processes/active
recovery=$control/processes/recovery
log=$control/logs/$handle.log
record=$active/$handle.tsv
argv_file=$active/$handle.argv
revisions=$active/$handle.revisions
recovery_record=$recovery/$handle.tsv
recovery_identity=$recovery/$handle.identity.tsv
recovery_argv=$recovery/$handle.argv
recovery_revisions=$recovery/$handle.revisions
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
for required in setsid pgrep pkill; do command -v "$required" >/dev/null || { echo "PROCESS_SESSION_TOOL_MISSING: $required" >&2; exit 1; }; done
mkdir -p "$recovery"
[[ ! -e $record && ! -L $record && ! -e $argv_file && ! -L $argv_file && \
   ! -e $recovery_record && ! -L $recovery_record && ! -e $recovery_identity && ! -L $recovery_identity && \
   ! -e $recovery_argv && ! -L $recovery_argv && ! -e $recovery_revisions && ! -L $recovery_revisions ]] || {
  echo "PROCESS_HANDLE_CONFLICT" >&2; exit 1;
}
[[ "$cwd" == "$root" || "$cwd" == "$root"/* ]] || { echo "PROCESS_CWD_INVALID" >&2; exit 1; }
cd "$cwd"
launch_identity=$recovery_identity
published=false
session_started=false
launch_attempted=false
command_argv=("$@")
stop_attempts=${REMOTE_DEV_LOCAL_AGENT_TEST_PROCESS_STOP_ATTEMPTS:-50}
[[ $stop_attempts =~ ^[1-9][0-9]*$ ]] || stop_attempts=50
recovery_tmp_record=$(mktemp "$recovery/.intent-record.XXXXXX")
recovery_tmp_argv=$(mktemp "$recovery/.intent-argv.XXXXXX")
recovery_tmp_revisions=$(mktemp "$recovery/.intent-revisions.XXXXXX")
printf "schema\t2\nowner_id\t%s\nproject_id\t%s\nprofile\t%s\nworkspace\t%s\nroot_hash\t%s\nremote_root\t%s\nmember_id\t%s\nremote_cwd\t%s\ntopology_digest\t%s\nhandle\t%s\nlog\t%s\nstart_manifest\t%s\ncreated_at\t%s\nactivation_state\tlaunch-intent\nrecovery_phase\tidentity-pending\nsupervisor_state\tnot-started\nidentity_file\t%s\n" \
  "$owner" "$project" "$profile" "$workspace" "$root_hash" "$root" "$member" "$cwd" "$topology" \
  "$handle" "$log" "$manifest" "$(date +%s)" "$recovery_identity" > "$recovery_tmp_record"
printf "%s\0" "${command_argv[@]}" > "$recovery_tmp_argv"
printf "%s\n" "$manifest" > "$recovery_tmp_revisions"
chmod 0600 "$recovery_tmp_record" "$recovery_tmp_argv" "$recovery_tmp_revisions"
mv "$recovery_tmp_argv" "$recovery_argv"
mv "$recovery_tmp_revisions" "$recovery_revisions"
mv "$recovery_tmp_record" "$recovery_record"
remove_recovery_state() {
  removal_reason=${1:-cleanup}
  if [[ $removal_reason == active-publish && \
        ${REMOTE_DEV_LOCAL_AGENT_TEST_FAIL_RECOVERY_DELETE:-false} == true ]]; then
    echo "PROCESS_TEST_RECOVERY_DELETE_FAILURE" >&2
    return 93
  fi
  rm -f "$recovery_record" "$recovery_identity" "$recovery_identity".tmp.* "$recovery_argv" "$recovery_revisions"
}
remove_unpublished_active_state() {
  rm -f "$argv_file" "$revisions" \
    "$active"/.process-"$handle"-record.* "$active"/.process-"$handle"-argv.* "$active"/.process-"$handle"-revisions.*
}
publish_active_record() {
  activation_state=$1
  tmp_record=$(mktemp "$active/.process-$handle-record.XXXXXX")
  tmp_argv=$(mktemp "$active/.process-$handle-argv.XXXXXX")
  tmp_revisions=$(mktemp "$active/.process-$handle-revisions.XXXXXX")
  printf "schema\t2\nowner_id\t%s\nproject_id\t%s\nprofile\t%s\nworkspace\t%s\nroot_hash\t%s\nremote_root\t%s\nmember_id\t%s\nremote_cwd\t%s\ntopology_digest\t%s\nhandle\t%s\npid\t%s\nstart_token\t%s\nsession_id\t%s\nprocess_group_id\t%s\nlog\t%s\nstart_manifest\t%s\nstarted_at\t%s\nactivation_state\t%s\n" \
    "$owner" "$project" "$profile" "$workspace" "$root_hash" "$root" "$member" "$cwd" "$topology" \
    "$handle" "$pid" "$expected" "$sid" "$pgid" "$log" "$manifest" "$(date +%s)" "$activation_state" > "$tmp_record"
  cp "$recovery_argv" "$tmp_argv"
  cp "$recovery_revisions" "$tmp_revisions"
  chmod 0600 "$tmp_record" "$tmp_argv" "$tmp_revisions"
  mv "$tmp_argv" "$argv_file" || return $?
  mv "$tmp_revisions" "$revisions" || return $?
  mv "$tmp_record" "$record" || return $?
  published=true
  remove_recovery_state active-publish
}
terminate_verified_session() {
  [[ $launch_attempted == true ]] || return 0
  [[ -f $launch_identity && ! -L $launch_identity ]] || {
    echo "PROCESS_CLEANUP_IDENTITY_UNAVAILABLE: recovery ownership preserved" >&2
    return 1
  }
  pid=$(field "$launch_identity" pid); expected=$(field "$launch_identity" start_token)
  sid=$(field "$launch_identity" session_id); pgid=$(field "$launch_identity" process_group_id)
  [[ $pid =~ ^[0-9]+$ && $sid =~ ^[0-9]+$ && $pgid =~ ^[0-9]+$ ]] || { echo "PROCESS_CLEANUP_IDENTITY_INVALID" >&2; return 1; }
  if kill -0 "$pid" 2>/dev/null; then
    actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    actual_sid=$(ps -p "$pid" -o sid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
    actual_pgid=$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
    [[ -n $actual && $actual == "$expected" && $actual_sid == "$sid" && $actual_pgid == "$pgid" ]] || {
      echo "PROCESS_CLEANUP_IDENTITY_MISMATCH: refusing signal" >&2; return 1;
    }
    pkill -TERM -s "$sid" 2>/dev/null || true
    for _ in $(seq 1 "$stop_attempts"); do pgrep -s "$sid" >/dev/null 2>&1 || break; sleep 0.1; done
    pgrep -s "$sid" >/dev/null 2>&1 && pkill -KILL -s "$sid" 2>/dev/null || true
    for _ in $(seq 1 "$stop_attempts"); do pgrep -s "$sid" >/dev/null 2>&1 || break; sleep 0.1; done
    pgrep -s "$sid" >/dev/null 2>&1 && { echo "PROCESS_SESSION_CLEANUP_FAILED: sid=$sid" >&2; return 1; }
  elif pgrep -s "$sid" >/dev/null 2>&1; then
    echo "PROCESS_LEADER_MISSING_SESSION_LIVE: refusing unverified cleanup sid=$sid" >&2
    return 1
  fi
  return 0
}
cleanup_started_process() {
  cleanup_status=0
  if [[ $published != true ]]; then
    if terminate_verified_session; then
      remove_unpublished_active_state
      remove_recovery_state cleanup
    else
      cleanup_status=$?
      if publish_active_record prepublication-rollback-failed; then
        published=true
        echo "PROCESS_PREPUBLICATION_ROLLBACK_FAILED: preserved recoverable active handle $handle" >&2
      else
        echo "PROCESS_PREPUBLICATION_ROLLBACK_FAILED: recovery ownership remains at $recovery_record" >&2
      fi
    fi
  fi
  return "$cleanup_status"
}
trap cleanup_started_process EXIT
if [[ -n ${REMOTE_DEV_LOCAL_AGENT_TEST_PAUSE_AFTER_RECOVERY_INTENT:-} ]]; then
  printf "%s\n" "$handle" > "$REMOTE_DEV_LOCAL_AGENT_TEST_PAUSE_AFTER_RECOVERY_INTENT.ready"
  while [[ ! -e $REMOTE_DEV_LOCAL_AGENT_TEST_PAUSE_AFTER_RECOVERY_INTENT.release ]]; do sleep 0.02; done
fi
if [[ ${REMOTE_DEV_LOCAL_AGENT_TEST_INTERRUPT_AFTER_RECOVERY_INTENT:-false} == true ]]; then
  echo "PROCESS_TEST_INTERRUPT_AFTER_RECOVERY_INTENT" >&2
  kill -KILL $$
fi
launch_attempted=true
nohup setsid /usr/bin/env bash -c '"'"'
set -euo pipefail
workspace_control=$1 recovery_record=$2 identity=$3 owner=$4 project=$5 profile=$6 workspace=$7 root_hash=$8 remote_root=$9 handle=${10}; shift 10
self=$$
token=$(ps -p "$self" -o lstart= 2>/dev/null | sed "s/^[[:space:]]*//;s/[[:space:]]*$//" || true)
sid=$(ps -p "$self" -o sid= 2>/dev/null | tr -d "[:space:]" || true)
pgid=$(ps -p "$self" -o pgid= 2>/dev/null | tr -d "[:space:]" || true)
[[ -n $token && $sid =~ ^[0-9]+$ && $pgid =~ ^[0-9]+$ && $sid == "$self" ]] || exit 77
field() {
  while IFS="$(printf "\t")" read -r key value; do
    if [[ $key == "$2" ]]; then printf "%s\n" "$value"; return 0; fi
  done < "$1"
  return 1
}
mutex=$workspace_control/claim.lock
acquired=false
for attempt in $(seq 1 300); do
  if mkdir "$mutex" 2>/dev/null; then
    lock_token=$(ps -p $$ -o lstart= 2>/dev/null | sed "s/^[[:space:]]*//;s/[[:space:]]*$//" || true)
    [[ -n $lock_token ]] || { rmdir "$mutex"; echo "RUNNER_WORKSPACE_LOCK_IDENTITY_UNAVAILABLE" >&2; exit 1; }
    printf "pid\t%s\nstart_token\t%s\n" "$$" "$lock_token" > "$mutex/owner.tsv"
    acquired=true
    break
  fi
  sleep 0.1
done
if [[ $acquired != true ]]; then
  if [[ -f $mutex/owner.tsv && ! -L $mutex/owner.tsv ]]; then
    lock_pid=$(field "$mutex/owner.tsv" pid)
    lock_expected=$(field "$mutex/owner.tsv" start_token)
    lock_actual=$(ps -p "$lock_pid" -o lstart= 2>/dev/null | sed "s/^[[:space:]]*//;s/[[:space:]]*$//" || true)
    if ! kill -0 "$lock_pid" 2>/dev/null || [[ -z $lock_actual || $lock_actual != "$lock_expected" ]]; then
      echo "RUNNER_WORKSPACE_LOCK_STALE: inspect and remove the exact stale lock $mutex before retrying" >&2
      exit 1
    fi
  else
    echo "RUNNER_WORKSPACE_LOCK_ORPHANED: inspect and remove the exact orphan lock $mutex before retrying" >&2
    exit 1
  fi
  echo "RUNNER_WORKSPACE_LOCK_BUSY" >&2
  exit 1
fi
release_mutex() { rm -f "$mutex/owner.tsv"; rmdir "$mutex" 2>/dev/null || true; }
trap release_mutex EXIT
expected_identity=$(dirname "$recovery_record")/$handle.identity.tsv
if [[ ! -f $recovery_record || -L $recovery_record || $identity != "$expected_identity" || \
      $(field "$recovery_record" schema) != 2 || $(field "$recovery_record" owner_id) != "$owner" || \
      $(field "$recovery_record" project_id) != "$project" || $(field "$recovery_record" profile) != "$profile" || \
      $(field "$recovery_record" workspace) != "$workspace" || $(field "$recovery_record" root_hash) != "$root_hash" || \
      $(field "$recovery_record" remote_root) != "$remote_root" || $(field "$recovery_record" handle) != "$handle" || \
      $(field "$recovery_record" identity_file) != "$identity" || \
      $(field "$recovery_record" recovery_phase) != identity-pending || \
      $(field "$recovery_record" supervisor_state) != not-started ]]; then
  echo "PROCESS_LAUNCH_INTENT_CANCELLED: exact recovery intent is missing or changed" >&2
  exit 78
fi
tmp=${identity}.tmp.$self
printf "pid\t%s\nstart_token\t%s\nsession_id\t%s\nprocess_group_id\t%s\n" "$self" "$token" "$sid" "$pgid" > "$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$identity"
phase_tmp=$(mktemp "$(dirname "$recovery_record")/.phase.XXXXXX")
phase_seen=false
supervisor_seen=false
while IFS="$(printf "\t")" read -r key value; do
  case "$key" in
    recovery_phase) value=active-transition; phase_seen=true ;;
    supervisor_state) value=identity-ready; supervisor_seen=true ;;
  esac
  printf "%s\t%s\n" "$key" "$value"
done < "$recovery_record" > "$phase_tmp"
[[ $phase_seen == true && $supervisor_seen == true ]] || exit 77
chmod 0600 "$phase_tmp"
mv "$phase_tmp" "$recovery_record"
release_mutex
trap - EXIT
set +e
"$@" & command_pid=$!
wait "$command_pid"; status=$?
while pgrep -s "$sid" 2>/dev/null | grep -Fvx "$self" >/dev/null; do sleep 0.1; done
exit "$status"
'"'"' remote-dev-managed-session "$workspace_control" "$recovery_record" "$launch_identity" \
  "$owner" "$project" "$profile" "$workspace" "$root_hash" "$root" "$handle" "$@" >> "$log" 2>&1 </dev/null &
launcher=$!
if [[ ${REMOTE_DEV_LOCAL_AGENT_TEST_INTERRUPT_AFTER_SUPERVISOR_FORK:-false} == true ]]; then
  echo "PROCESS_TEST_INTERRUPT_AFTER_SUPERVISOR_FORK" >&2
  kill -KILL $$
fi
for _ in $(seq 1 100); do
  [[ -s $launch_identity ]] && break
  jobs -pr | grep -Fx "$launcher" >/dev/null || break
  sleep 0.05
done
if [[ ! -f $launch_identity || -L $launch_identity ]]; then
  if jobs -pr | grep -Fx "$launcher" >/dev/null; then
    cat "$log" >&2 || true
    echo "PROCESS_SESSION_IDENTITY_UNAVAILABLE: supervisor is still live; recovery ownership preserved" >&2
    exit 1
  fi
  set +e
  wait "$launcher"
  launcher_status=$?
  set -e
  launch_attempted=false
  echo "PROCESS_SESSION_IDENTITY_PUBLISH_FAILED: supervisor exited status=$launcher_status before user argv" >&2
  exit 1
fi
pid=$(field "$launch_identity" pid); expected=$(field "$launch_identity" start_token)
sid=$(field "$launch_identity" session_id); pgid=$(field "$launch_identity" process_group_id)
session_started=true
[[ $pid =~ ^[0-9]+$ && $sid =~ ^[0-9]+$ && $pgid =~ ^[0-9]+$ ]] || { echo "PROCESS_SESSION_IDENTITY_INVALID" >&2; exit 1; }
actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
actual_sid=$(ps -p "$pid" -o sid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
actual_pgid=$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
[[ -n $actual && $actual == "$expected" && $actual_sid == "$sid" && $actual_pgid == "$pgid" && $sid == "$pid" ]] || {
  echo "PROCESS_SESSION_IDENTITY_MISMATCH" >&2; exit 1;
}
session_member=false
for _ in $(seq 1 50); do
  if pgrep -s "$sid" 2>/dev/null | grep -Fvx "$pid" >/dev/null; then session_member=true; break; fi
  kill -0 "$pid" 2>/dev/null || break
  sleep 0.05
done
[[ $session_member == true ]] || { cat "$log" >&2 || true; echo "PROCESS_COMMAND_EXITED_BEFORE_PUBLISH" >&2; exit 1; }
publish_active_record active
published=true
trap - EXIT
' "$workspace_control" "$remote_root" "$start_cwd" "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" \
  "$handle" "$start_manifest" "$start_member" "$start_topology" "$@"
}

remote_active_handle_is_owned() {
  remote_bash '
set -euo pipefail
control=$1 owner=$2 project=$3 profile=$4 workspace=$5 root_hash=$6 remote_root=$7 handle=$8
record=$control/processes/active/$handle.tsv
[[ -e $record ]] || record=$control/processes/recovery/$handle.tsv
[[ -f $record && ! -L $record ]] || exit 1
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
[[ $(field "$record" schema) == 2 && $(field "$record" owner_id) == "$owner" && \
   $(field "$record" project_id) == "$project" && $(field "$record" profile) == "$profile" && \
   $(field "$record" workspace) == "$workspace" && $(field "$record" root_hash) == "$root_hash" && \
   $(field "$record" remote_root) == "$remote_root" && $(field "$record" handle) == "$handle" ]]
' "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" "$remote_root" "$1"
}

handle_remote_start_failure() {
  local handle=$1 original_status=$2
  if ! remote_active_handle_is_owned "$handle" >/dev/null 2>&1; then
    if ! mutagen sync pause "$mutagen_session" >/dev/null; then
      printf 'SYNC_FAILED\nreason\tfailed-process-launch-pause-failed\nhandle\t%s\ndetected_at\t%s\n' \
        "$handle" "$(date +%s)" | write_atomic "$binding_dir/SYNC_FAILED"
      fail "PROCESS_ACTIVATION_FAILED: failed launch has no published active handle, but synchronization could not be paused." || true
      return 76
    fi
    return "$original_status"
  fi
  mark_process_rollback_failed "$handle" prepublication-terminate-failed
  pause_after_process_rollback "$handle" prepublication-terminate-failed || return $?
  fail "PROCESS_ROLLBACK_FAILED: failed launch preserved recoverable active handle $handle." || true
  fail "Recovery: inspect local-agent status, then retry local-agent stop $workspace $handle." || true
  return 79
}

run_start() {
  local -a args=("$@") command_argv=()
  parse_binding_target "${args[@]}"
  args=("${parsed_args[@]}")
  [[ ${args[0]:-} == -- ]] || usage_error 'start requires -- followed by argv'
  command_argv=("${args[@]:1}")
  (( ${#command_argv[@]} > 0 )) || usage_error 'start requires non-empty argv'
  [[ ${command_argv[0]} != git && ${command_argv[0]} != */git ]] || {
    fail 'UNSUPPORTED_GIT_METADATA: Git commands do not run in a runner projection.'; exit 1;
  }
  prepare_bound_command
  acquire_lock || return $?
  sync_barrier false true || return $?
  refresh_remote_lease start
  local handle
  handle=proc-$(date +%Y%m%dT%H%M%S)-$$-$RANDOM
  prepare_tracked_inventory "$handle" || return $?
  command_argv=("${inventory_environment[@]}" "${command_argv[@]}")
  wait_test_activation_gate
  local start_status
  if remote_start_handle "$handle" "$manifest_id" "$resolved_member" "$remote_cwd" "${topology_digest:--}" \
    "${command_argv[@]}" >/dev/null; then
    :
  else
    start_status=$?
    handle_remote_start_failure "$handle" "$start_status"
    return $?
  fi
  if ! mutagen sync resume "$mutagen_session" >/dev/null; then
    rollback_published_handle "$handle" start-resume-failed || return $?
    fail 'PROCESS_ACTIVATION_FAILED: synchronization did not resume; the new managed session was verified stopped and synchronization paused.'
    return 76
  fi
  if ! start_watcher; then
    rollback_published_handle "$handle" start-watcher-failed || return $?
    fail 'PROCESS_ACTIVATION_FAILED: watcher did not start; the new managed session was verified stopped and synchronization paused.'
    return 77
  fi
  printf 'STARTED  %s\nLogs     local-agent logs %s %s\nStop     local-agent stop %s %s\n' \
    "$handle" "$workspace" "$handle" "$workspace" "$handle"
}

run_logs() {
  local -a args=("$@")
  parse_binding_target "${args[@]}"
  args=("${parsed_args[@]}")
  (( ${#args[@]} == 1 )) || usage_error 'logs requires exactly one process handle'
  process_handle_valid "${args[0]}" || usage_error "invalid process handle: ${args[0]}"
  prepare_bound_command
  remote_bash '
set -euo pipefail
control=$1 owner=$2 handle=$3
record=$control/processes/active/$handle.tsv
[[ -f $record ]] || record=$control/processes/stopped/$handle.tsv
[[ -f $record ]] || record=$control/processes/recovery/$handle.tsv
[[ -f $record && ! -L $record ]] || { echo "unknown process handle: $handle" >&2; exit 1; }
[[ $(awk -F "\t" '"'"'$1 == "owner_id" {print $2; exit}'"'"' "$record") == "$owner" ]] || {
  echo "PROCESS_OWNER_MISMATCH" >&2; exit 1;
}
cat "$control/logs/$handle.log"
' "$remote_control" "$owner_id" "${args[0]}"
}

remote_stop_handle() {
  remote_bash '
set -euo pipefail
workspace_control=$1 control=$2 owner=$3 project=$4 profile=$5 workspace=$6 root_hash=$7 remote_root=$8 handle=$9
stop_attempts=${REMOTE_DEV_LOCAL_AGENT_TEST_PROCESS_STOP_ATTEMPTS:-50}
[[ $stop_attempts =~ ^[1-9][0-9]*$ ]] || stop_attempts=50
active=$control/processes/active/$handle.tsv
active_argv=$control/processes/active/$handle.argv
active_revisions=$control/processes/active/$handle.revisions
stopped=$control/processes/stopped/$handle.tsv
stopped_argv=$control/processes/stopped/$handle.argv
stopped_revisions=$control/processes/stopped/$handle.revisions
recovery_dir=$control/processes/recovery
recovery_record=$recovery_dir/$handle.tsv
recovery_identity=$recovery_dir/$handle.identity.tsv
recovery_argv=$recovery_dir/$handle.argv
recovery_revisions=$recovery_dir/$handle.revisions
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
validate_binding() {
  candidate=$1
  [[ -f $candidate && ! -L $candidate && $(field "$candidate" schema) == 2 && \
     $(field "$candidate" owner_id) == "$owner" && $(field "$candidate" project_id) == "$project" && \
     $(field "$candidate" profile) == "$profile" && $(field "$candidate" workspace) == "$workspace" && \
     $(field "$candidate" root_hash) == "$root_hash" && $(field "$candidate" remote_root) == "$remote_root" && \
     $(field "$candidate" handle) == "$handle" ]]
}
mutex=$workspace_control/claim.lock
acquired=false
for attempt in $(seq 1 300); do
  if mkdir "$mutex" 2>/dev/null; then
    token=$(ps -p $$ -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    [[ -n $token ]] || { rmdir "$mutex"; echo "RUNNER_WORKSPACE_LOCK_IDENTITY_UNAVAILABLE" >&2; exit 1; }
    printf "pid\t%s\nstart_token\t%s\n" "$$" "$token" > "$mutex/owner.tsv"
    acquired=true
    break
  fi
  sleep 0.1
done
if [[ $acquired != true ]]; then
  if [[ -f $mutex/owner.tsv && ! -L $mutex/owner.tsv ]]; then
    lock_pid=$(field "$mutex/owner.tsv" pid)
    lock_expected=$(field "$mutex/owner.tsv" start_token)
    lock_actual=$(ps -p "$lock_pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    if ! kill -0 "$lock_pid" 2>/dev/null || [[ -z $lock_actual || $lock_actual != "$lock_expected" ]]; then
      echo "RUNNER_WORKSPACE_LOCK_STALE: inspect and remove the exact stale lock $mutex before retrying" >&2; exit 1
    fi
  else
    echo "RUNNER_WORKSPACE_LOCK_ORPHANED: inspect and remove the exact orphan lock $mutex before retrying" >&2; exit 1
  fi
  echo "RUNNER_WORKSPACE_LOCK_BUSY" >&2; exit 1
fi
release_mutex() { rm -f "$mutex/owner.tsv"; rmdir "$mutex" 2>/dev/null || true; }
trap release_mutex EXIT
has_active=false
has_recovery=false
has_stopped=false
[[ ! -e $active && ! -L $active ]] || {
  validate_binding "$active" || { echo "PROCESS_BINDING_IDENTITY_MISMATCH" >&2; exit 1; }
  has_active=true
}
[[ ! -e $stopped && ! -L $stopped ]] || {
  validate_binding "$stopped" || { echo "PROCESS_BINDING_IDENTITY_MISMATCH" >&2; exit 1; }
  has_stopped=true
}
if [[ -e $recovery_record || -L $recovery_record ]]; then
  validate_binding "$recovery_record" || { echo "PROCESS_BINDING_IDENTITY_MISMATCH" >&2; exit 1; }
  [[ $(field "$recovery_record" identity_file) == "$recovery_identity" && \
     -f $recovery_argv && ! -L $recovery_argv && -f $recovery_revisions && ! -L $recovery_revisions ]] || {
    echo "PROCESS_RECOVERY_IDENTITY_INVALID" >&2; exit 1;
  }
  recovery_phase=$(field "$recovery_record" recovery_phase)
  supervisor_state=$(field "$recovery_record" supervisor_state)
  case "$recovery_phase:$supervisor_state" in
    identity-pending:not-started|identity-pending:launch-requested|active-transition:identity-ready) ;;
    *) echo "PROCESS_RECOVERY_PHASE_INVALID: phase=$recovery_phase supervisor=$supervisor_state" >&2; exit 1 ;;
  esac
  has_recovery=true
fi
[[ $has_active == true || $has_recovery == true || $has_stopped == true ]] || {
  echo "unknown process handle: $handle" >&2; exit 1;
}

recovery_identity_source=
intent_only=false
if [[ $has_recovery == true ]]; then
  stable_checksum=
  stable_samples=0
  for attempt in $(seq 1 50); do
    if [[ -e $recovery_identity || -L $recovery_identity ]]; then
      [[ -f $recovery_identity && ! -L $recovery_identity ]] || { echo "PROCESS_RECOVERY_IDENTITY_INVALID" >&2; exit 1; }
      recovery_identity_source=$recovery_identity
      break
    fi
    shopt -s nullglob
    identity_temps=("$recovery_identity".tmp.*)
    shopt -u nullglob
    if (( ${#identity_temps[@]} > 1 )); then
      echo "PROCESS_RECOVERY_IDENTITY_AMBIGUOUS" >&2
      exit 1
    elif (( ${#identity_temps[@]} == 1 )); then
      candidate=${identity_temps[0]}
      [[ -f $candidate && ! -L $candidate ]] || { echo "PROCESS_RECOVERY_IDENTITY_INVALID" >&2; exit 1; }
      temp_pid=$(field "$candidate" pid 2>/dev/null || true)
      temp_start=$(field "$candidate" start_token 2>/dev/null || true)
      temp_sid=$(field "$candidate" session_id 2>/dev/null || true)
      temp_pgid=$(field "$candidate" process_group_id 2>/dev/null || true)
      if [[ $candidate == "$recovery_identity.tmp.$temp_pid" && $temp_pid =~ ^[0-9]+$ && \
            -n $temp_start && $temp_sid =~ ^[0-9]+$ && $temp_pgid =~ ^[0-9]+$ ]]; then
        recovery_identity_source=$candidate
        break
      fi
    elif [[ $recovery_phase == identity-pending && $supervisor_state == not-started && $has_active == false ]]; then
      checksum=$(cksum "$recovery_record")
      if [[ $checksum == "$stable_checksum" ]]; then
        stable_samples=$((stable_samples + 1))
      else
        stable_checksum=$checksum
        stable_samples=1
      fi
      if (( stable_samples >= 5 )); then
        intent_only=true
        break
      fi
    fi
    sleep 0.1
  done
  [[ -n $recovery_identity_source || $intent_only == true ]] || {
    echo "PROCESS_RECOVERY_IDENTITY_PENDING: no stable final or complete temporary identity" >&2
    exit 1
  }
fi

record_mode=stopped
identity_source=$stopped
if [[ $has_active == true ]]; then
  record_mode=active
  identity_source=$active
elif [[ $has_recovery == true ]]; then
  record_mode=recovery
  identity_source=$recovery_identity_source
fi
if [[ $intent_only == true ]]; then
  [[ $record_mode == recovery ]] || { echo "PROCESS_RECOVERY_DUPLICATE_STATE_INVALID" >&2; exit 1; }
elif [[ $record_mode == stopped && $(field "$stopped" recovery_state 2>/dev/null || true) == intent-cleared-no-launch ]]; then
  printf "stop_mode\tstopped\n"
  exit 0
fi
if [[ $has_active == true && $has_recovery == true ]]; then
  [[ -n $recovery_identity_source && \
     $(field "$recovery_identity_source" pid) == $(field "$active" pid) && \
     $(field "$recovery_identity_source" start_token) == $(field "$active" start_token) && \
     $(field "$recovery_identity_source" session_id) == $(field "$active" session_id) && \
     $(field "$recovery_identity_source" process_group_id) == $(field "$active" process_group_id) ]] || {
    echo "PROCESS_RECOVERY_DUPLICATE_IDENTITY_MISMATCH" >&2; exit 1;
  }
fi
if [[ $intent_only == true ]]; then
  pid= expected= sid= pgid=
else
pid=$(field "$identity_source" pid); expected=$(field "$identity_source" start_token)
sid=$(field "$identity_source" session_id); pgid=$(field "$identity_source" process_group_id)
[[ $pid =~ ^[0-9]+$ && $sid =~ ^[0-9]+$ && $pgid =~ ^[0-9]+$ ]] || { echo "PROCESS_IDENTITY_INVALID" >&2; exit 1; }
fi
if [[ $intent_only != true ]] && kill -0 "$pid" 2>/dev/null; then
  actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
  actual_sid=$(ps -p "$pid" -o sid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
  actual_pgid=$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
  [[ $record_mode != stopped ]] || { echo "PROCESS_STOPPED_RECORD_PID_LIVE_OR_REUSED: refusing recovery" >&2; exit 1; }
  [[ -n $actual && $actual == "$expected" && $actual_sid == "$sid" && $actual_pgid == "$pgid" && $sid == "$pid" ]] || {
    echo "PROCESS_PID_REUSED_OR_SESSION_MISMATCH: refusing kill" >&2; exit 1;
  }
  pkill -TERM -s "$sid" 2>/dev/null || true
  for _ in $(seq 1 "$stop_attempts"); do pgrep -s "$sid" >/dev/null 2>&1 || break; sleep 0.1; done
  pgrep -s "$sid" >/dev/null 2>&1 && pkill -KILL -s "$sid" 2>/dev/null || true
  for _ in $(seq 1 "$stop_attempts"); do pgrep -s "$sid" >/dev/null 2>&1 || break; sleep 0.1; done
  pgrep -s "$sid" >/dev/null 2>&1 && { echo "PROCESS_SESSION_STOP_FAILED: sid=$sid" >&2; exit 1; }
elif [[ $intent_only != true ]] && pgrep -s "$sid" >/dev/null 2>&1; then
  echo "PROCESS_LEADER_MISSING_SESSION_LIVE: refusing unverified kill sid=$sid" >&2
  exit 1
fi
if [[ $record_mode == active ]]; then
  [[ -f $active_argv && ! -L $active_argv && -f $active_revisions && ! -L $active_revisions ]] || {
    echo "PROCESS_ACTIVE_STATE_INVALID" >&2; exit 1;
  }
  stopped_tmp=$(mktemp "$control/processes/stopped/.active.XXXXXX")
  stopped_tmp_argv=$(mktemp "$control/processes/stopped/.active-argv.XXXXXX")
  stopped_tmp_revisions=$(mktemp "$control/processes/stopped/.active-revisions.XXXXXX")
  cat "$active" > "$stopped_tmp"
  cp "$active_argv" "$stopped_tmp_argv"
  cp "$active_revisions" "$stopped_tmp_revisions"
  printf "stopped_at\t%s\n" "$(date +%s)" >> "$stopped_tmp"
  chmod 0600 "$stopped_tmp" "$stopped_tmp_argv" "$stopped_tmp_revisions"
  mv "$stopped_tmp_argv" "$stopped_argv"
  mv "$stopped_tmp_revisions" "$stopped_revisions"
  mv "$stopped_tmp" "$stopped"
  rm -f "$active" "$active_argv" "$active_revisions"
elif [[ $record_mode == recovery ]]; then
  stopped_tmp=$(mktemp "$control/processes/stopped/.recovery.XXXXXX")
  stopped_tmp_argv=$(mktemp "$control/processes/stopped/.recovery-argv.XXXXXX")
  stopped_tmp_revisions=$(mktemp "$control/processes/stopped/.recovery-revisions.XXXXXX")
  cat "$recovery_record" > "$stopped_tmp"
  [[ $intent_only == true ]] || cat "$recovery_identity_source" >> "$stopped_tmp"
  cp "$recovery_argv" "$stopped_tmp_argv"
  cp "$recovery_revisions" "$stopped_tmp_revisions"
  if [[ $intent_only == true ]]; then recovery_state=intent-cleared-no-launch; else recovery_state=stopped; fi
  printf "recovery_state\t%s\nstopped_at\t%s\n" "$recovery_state" "$(date +%s)" >> "$stopped_tmp"
  chmod 0600 "$stopped_tmp" "$stopped_tmp_argv" "$stopped_tmp_revisions"
  mv "$stopped_tmp_argv" "$stopped_argv"
  mv "$stopped_tmp_revisions" "$stopped_revisions"
  mv "$stopped_tmp" "$stopped"
fi
if [[ $has_recovery == true ]]; then
  rm -f "$recovery_record" "$recovery_identity" "$recovery_identity".tmp.* "$recovery_argv" "$recovery_revisions"
  record_mode=recovery
fi
rm -f "$active" "$active_argv" "$active_revisions" \
  "$control/processes/active"/.process-"$handle"-record.* \
  "$control/processes/active"/.process-"$handle"-argv.* \
  "$control/processes/active"/.process-"$handle"-revisions.*
printf "stop_mode\t%s\n" "$record_mode"
' "$workspace_control" "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" "$remote_root" "$1"
}

run_stop() {
  local -a args=("$@")
  parse_binding_target "${args[@]}"
  args=("${parsed_args[@]}")
  (( ${#args[@]} == 1 )) || usage_error 'stop requires exactly one process handle'
  process_handle_valid "${args[0]}" || usage_error "invalid process handle: ${args[0]}"
  prepare_bound_command stop
  acquire_lock || return $?
  refresh_remote_lease stop
  local handle=${args[0]} marker_handle=
  if [[ -e $binding_dir/PROCESS_ROLLBACK_FAILED ]]; then
    marker_handle=$(process_rollback_handle) || return $?
    [[ $marker_handle == "$handle" ]] || {
      fail "PROCESS_ROLLBACK_HANDLE_MISMATCH: recover $marker_handle before operating on $handle" || true
      return 79
    }
  fi
  local stop_status stop_output stop_mode
  if stop_output=$(remote_stop_handle "$handle"); then
    :
  else
    stop_status=$?
    if remote_active_handle_is_owned "$handle" >/dev/null 2>&1; then
      mark_process_rollback_failed "$handle" explicit-stop-failed
      fail "PROCESS_ROLLBACK_FAILED: managed handle $handle could not be verified stopped; its active record was preserved." || true
      return 79
    fi
    return "$stop_status"
  fi
  stop_mode=$(printf '%s\n' "$stop_output" | awk -F '\t' '$1 == "stop_mode" {print $2; exit}')
  [[ $stop_mode == active || $stop_mode == stopped || $stop_mode == recovery ]] || {
    fail 'PROCESS_STOP_RESULT_INVALID: remote stop omitted its verified ownership mode' || true
    return 79
  }
  if [[ -n $marker_handle || $stop_mode == recovery ]]; then
    pause_after_process_rollback "$handle" explicit-stop-recovery || return $?
    clear_matching_process_rollback "$handle" || return $?
  fi
  printf 'STOPPED  %s\n' "$handle"
}

run_restart() {
  local -a args=("$@") argv=()
  parse_binding_target "${args[@]}"
  args=("${parsed_args[@]}")
  (( ${#args[@]} == 1 )) || usage_error 'restart requires exactly one process handle'
  local handle=${args[0]} argv_file restart_context restart_member restart_cwd restart_topology
  process_handle_valid "$handle" || usage_error "invalid process handle: $handle"
  prepare_bound_command
  acquire_lock || return $?
  [[ ! -e $binding_dir/PROCESS_ROLLBACK_FAILED ]] || {
    fail 'PROCESS_ROLLBACK_FAILED blocks restart; recover it with explicit stop first.' || true
    return 79
  }
  restart_context=$(remote_bash '
set -euo pipefail
control=$1 owner=$2 project=$3 profile=$4 workspace=$5 root_hash=$6 remote_root=$7 handle=$8
record=$control/processes/active/$handle.tsv
[[ -f $record && ! -L $record ]] || { echo "unknown active process handle: $handle" >&2; exit 1; }
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
[[ $(field "$record" schema) == 2 && $(field "$record" owner_id) == "$owner" && \
   $(field "$record" project_id) == "$project" && $(field "$record" profile) == "$profile" && \
   $(field "$record" workspace) == "$workspace" && $(field "$record" root_hash) == "$root_hash" && \
   $(field "$record" remote_root) == "$remote_root" ]] || { echo "PROCESS_BINDING_IDENTITY_MISMATCH" >&2; exit 1; }
member=$(field "$record" member_id 2>/dev/null || printf root)
cwd=$(field "$record" remote_cwd 2>/dev/null || printf %s "$remote_root")
topology=$(field "$record" topology_digest 2>/dev/null || printf -- -)
[[ "$cwd" == "$remote_root" || "$cwd" == "$remote_root"/* ]] || { echo "PROCESS_CWD_INVALID" >&2; exit 1; }
printf "member\t%s\nremote_cwd\t%s\ntopology_digest\t%s\n" "$member" "$cwd" "$topology"
' "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" "$remote_root" "$handle") || return $?
  restart_member=$(printf '%s\n' "$restart_context" | awk -F '\t' '$1 == "member" {print $2; exit}')
  restart_cwd=$(printf '%s\n' "$restart_context" | awk -F '\t' '$1 == "remote_cwd" {print $2; exit}')
  restart_topology=$(printf '%s\n' "$restart_context" | awk -F '\t' '$1 == "topology_digest" {print $2; exit}')
  [[ $restart_topology == "${topology_digest:--}" ]] || {
    fail 'PROCESS_TOPOLOGY_MISMATCH: restart requires the exact topology used by start' || true
    return 79
  }
  argv_file=$(mktemp "$binding_dir/.restart-argv.XXXXXX")
  coder_ssh cat "$remote_control/processes/active/$handle.argv" > "$argv_file"
  while IFS= read -r -d '' argument; do argv+=("$argument"); done < "$argv_file" || true
  rm -f "$argv_file"
  (( ${#argv[@]} > 0 )) || { fail 'managed process has no restart argv'; exit 1; }
  if ! remote_stop_handle "$handle" >/dev/null; then
    mark_process_rollback_failed "$handle" restart-stop-failed
    fail "PROCESS_ROLLBACK_FAILED: restart could not verify stop of $handle; its active record was preserved." || true
    return 79
  fi
  sync_barrier false true || return $?
  refresh_remote_lease restart
  if [[ $git_metadata_mode == explicit-input ]]; then
    [[ ${argv[0]:-} == /usr/bin/env && ${argv[1]:-} == REMOTE_DEV_TRACKED_INVENTORY=* && \
       ${argv[2]:-} == REMOTE_DEV_TRACKED_INVENTORY_SHA256=* && ${argv[3]:-} == REMOTE_DEV_EXECUTION_RECEIPT_ID=* && \
       ${argv[4]:-} == REMOTE_DEV_PROJECTION_MANIFEST_ID=* ]] || { fail 'PROCESS_INVENTORY_ENVELOPE_INVALID'; return 1; }
    argv=("${argv[@]:5}")
    prepare_tracked_inventory "$handle" || return $?
    argv=("${inventory_environment[@]}" "${argv[@]}")
  fi
  wait_test_activation_gate
  local start_status
  if remote_start_handle "$handle" "$manifest_id" "$restart_member" "$restart_cwd" "$restart_topology" \
    "${argv[@]}" >/dev/null; then
    :
  else
    start_status=$?
    handle_remote_start_failure "$handle" "$start_status"
    return $?
  fi
  if ! mutagen sync resume "$mutagen_session" >/dev/null; then
    rollback_published_handle "$handle" restart-resume-failed || return $?
    fail 'PROCESS_ACTIVATION_FAILED: synchronization did not resume; the restarted session was verified stopped and synchronization paused.'
    return 76
  fi
  if ! start_watcher; then
    rollback_published_handle "$handle" restart-watcher-failed || return $?
    fail 'PROCESS_ACTIVATION_FAILED: watcher did not start; the restarted session was verified stopped and synchronization paused.'
    return 77
  fi
  printf 'RESTARTED %s\n' "$handle"
}

run_down() {
  local -a args=("$@")
  local retire_for_topology_drift=false
  parse_binding_target "${args[@]}"
  require_mode_authority || return $?
  args=("${parsed_args[@]}")
  (( ${#args[@]} == 0 )) || usage_error "unexpected down argument: ${args[0]}"
  if [[ $binding_kind == working-set ]] && ! assert_topology_current >/dev/null; then
    retire_for_topology_drift=true
  fi
  ensure_platform
  ensure_coder_context
  require_runner_role
  refresh_remote_lease down || return $?
  if [[ -e $binding_dir/REMOTE_DRIFT || -e $binding_dir/SYNC_FAILED || \
        -e $binding_dir/PROCESS_ROLLBACK_FAILED || \
        -e $binding_dir/UNKNOWN_EXECUTION || -e $binding_dir/LEASE_HEARTBEAT_FAILED ]]; then
    fail 'RUNNER_UNRESOLVED_STATE: down is blocked by drift, sync, process-rollback, heartbeat, or unknown-execution evidence.' || true
    fail 'Recovery: inspect local-agent status and complete the explicit recovery before down.' || true
    return 79
  fi
  remote_bash '
set -euo pipefail
control=$1 owner=$2 project=$3 profile=$4 workspace=$5 root_hash=$6 remote_root=$7
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
for running in "$control"/executions/*.running; do
  [[ -f $running && ! -L $running ]] || continue
  running_owner=$(field "$running" owner_id); pid=$(field "$running" pid); expected=$(field "$running" start_token)
  state=stale
  if [[ $(field "$running" schema) != 2 || $running_owner != "$owner" || \
        $(field "$running" project_id) != "$project" || $(field "$running" profile) != "$profile" || \
        $(field "$running" workspace) != "$workspace" || $(field "$running" root_hash) != "$root_hash" || \
        $(field "$running" remote_root) != "$remote_root" ]]; then
    state=binding-identity-mismatch
  elif kill -0 "$pid" 2>/dev/null; then
    actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    if [[ -n $actual && $actual == "$expected" ]]; then state=live; else state=pid-reused; fi
  fi
  echo "UNRESOLVED_REMOTE_EXECUTION: $(basename "$running") state=$state owner=$running_owner pid=$pid" >&2
  exit 79
done
' "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" "$remote_root" || return $?
  verify_watcher_identity || return $?
  acquire_lock || return $?
  trap 'release_lock' RETURN
  stop_watcher || return $?
  remote_bash '
set -euo pipefail
control=$1 owner=$2 project=$3 profile=$4 workspace=$5 root_hash=$6 remote_root=$7
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
# Validate every record and live session before signaling any process.
for record in "$control"/processes/active/*.tsv; do
  [[ -e $record || -L $record ]] || continue
  [[ -f $record && ! -L $record ]] || { echo "PROCESS_RECORD_INVALID: $record" >&2; exit 1; }
  [[ $(field "$record" schema) == 2 && $(field "$record" owner_id) == "$owner" && \
     $(field "$record" project_id) == "$project" && $(field "$record" profile) == "$profile" && \
     $(field "$record" workspace) == "$workspace" && $(field "$record" root_hash) == "$root_hash" && \
     $(field "$record" remote_root) == "$remote_root" ]] || { echo "PROCESS_BINDING_IDENTITY_MISMATCH" >&2; exit 1; }
  pid=$(field "$record" pid); expected=$(field "$record" start_token)
  sid=$(field "$record" session_id); pgid=$(field "$record" process_group_id)
  [[ $pid =~ ^[0-9]+$ && $sid =~ ^[0-9]+$ && $pgid =~ ^[0-9]+$ ]] || { echo "PROCESS_IDENTITY_INVALID" >&2; exit 1; }
  if kill -0 "$pid" 2>/dev/null; then
    actual=$(ps -p "$pid" -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    actual_sid=$(ps -p "$pid" -o sid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
    actual_pgid=$(ps -p "$pid" -o pgid= 2>/dev/null | tr -d '"'"'[:space:]'"'"' || true)
    [[ -n $actual && $actual == "$expected" && $actual_sid == "$sid" && $actual_pgid == "$pgid" && $sid == "$pid" ]] || {
      echo "PROCESS_PID_REUSED_OR_SESSION_MISMATCH: refusing kill $pid" >&2; exit 1;
    }
  elif pgrep -s "$sid" >/dev/null 2>&1; then
    echo "PROCESS_LEADER_MISSING_SESSION_LIVE: refusing unverified kill sid=$sid" >&2; exit 1
  fi
done
for record in "$control"/processes/active/*.tsv; do
  [[ -f $record && ! -L $record ]] || continue
  handle=$(basename "$record" .tsv); pid=$(field "$record" pid); sid=$(field "$record" session_id)
  if kill -0 "$pid" 2>/dev/null; then
    pkill -TERM -s "$sid" 2>/dev/null || true
    for _ in $(seq 1 50); do pgrep -s "$sid" >/dev/null 2>&1 || break; sleep 0.1; done
    pgrep -s "$sid" >/dev/null 2>&1 && pkill -KILL -s "$sid" 2>/dev/null || true
    for _ in $(seq 1 50); do pgrep -s "$sid" >/dev/null 2>&1 || break; sleep 0.1; done
    pgrep -s "$sid" >/dev/null 2>&1 && { echo "PROCESS_SESSION_STOP_FAILED: sid=$sid" >&2; exit 1; }
  fi
  printf "stopped_at\t%s\n" "$(date +%s)" >> "$record"
  mv "$record" "$control/processes/stopped/$handle.tsv"
  [[ ! -e $control/processes/active/$handle.argv ]] || mv "$control/processes/active/$handle.argv" "$control/processes/stopped/$handle.argv"
  [[ ! -e $control/processes/active/$handle.revisions ]] || mv "$control/processes/active/$handle.revisions" "$control/processes/stopped/$handle.revisions"
done
' "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" "$remote_root" >/dev/null
  if [[ $retire_for_topology_drift == true ]]; then
    local retirement_remote_manifest
    if mutagen_session_exists; then
      mutagen sync pause "$mutagen_session" >/dev/null || {
        fail 'SYNC_PAUSE_FAILED: topology retirement cannot verify a moving remote projection.'
        return 76
      }
    fi
    retirement_remote_manifest=$(mktemp "$binding_dir/.retirement-remote-manifest.XXXXXX")
    remote_manifest_to "$retirement_remote_manifest" || {
      rm -f "$retirement_remote_manifest"
      return 74
    }
    if ! cmp -s "$managed_manifest" "$retirement_remote_manifest"; then
      mark_drift "$retirement_remote_manifest"
      rm -f "$retirement_remote_manifest"
      return 74
    fi
    rm -f "$retirement_remote_manifest"
    reset_unaccepted_remote_projection || return $?
  fi
  if mutagen_session_exists; then
    mutagen sync terminate "$mutagen_session" >/dev/null || {
      fail 'SYNC_TERMINATION_FAILED: workspace claim remains owned; repair Mutagen and retry down.'
      return 76
    }
  fi
  remote_bash '
set -euo pipefail
workspace_control=$1 control=$2 owner=$3 project=$4 profile=$5 workspace=$6 root_hash=$7 remote_root=$8
field() { awk -F "\t" -v key="$2" '"'"'$1 == key {sub(/^[^\t]*\t/, ""); print; found=1; exit} END {if (!found) exit 1}'"'"' "$1"; }
mutex=$workspace_control/claim.lock
acquired=false
for attempt in $(seq 1 300); do
  if mkdir "$mutex" 2>/dev/null; then
    token=$(ps -p $$ -o lstart= 2>/dev/null | sed '"'"'s/^[[:space:]]*//;s/[[:space:]]*$//'"'"' || true)
    [[ -n $token ]] || { rmdir "$mutex"; echo "RUNNER_WORKSPACE_LOCK_IDENTITY_UNAVAILABLE" >&2; exit 1; }
    printf "pid\t%s\nstart_token\t%s\n" "$$" "$token" > "$mutex/owner.tsv"
    acquired=true; break
  fi
  sleep 0.1
done
[[ $acquired == true ]] || { echo "RUNNER_WORKSPACE_LOCK_BUSY: claim was not released" >&2; exit 1; }
release_mutex() { rm -f "$mutex/owner.tsv"; rmdir "$mutex" 2>/dev/null || true; }
trap release_mutex EXIT
workspace_binding=$workspace_control/binding.tsv; workspace_lease=$workspace_control/lease.tsv; lease=$control/lease.tsv
[[ -f $workspace_binding && ! -L $workspace_binding && -f $workspace_lease && ! -L $workspace_lease && -f $lease && ! -L $lease ]] || {
  echo "RUNNER_WORKSPACE_RELEASE_STATE_INVALID" >&2; exit 1;
}
[[ $(field "$workspace_binding" project_id) == "$project" && $(field "$workspace_binding" profile) == "$profile" && \
   $(field "$workspace_binding" workspace) == "$workspace" && $(field "$workspace_binding" root_hash) == "$root_hash" && \
   $(field "$workspace_binding" remote_root) == "$remote_root" && $(field "$workspace_lease" owner_id) == "$owner" && \
   $(field "$lease" owner_id) == "$owner" ]] || { echo "RUNNER_WORKSPACE_RELEASE_OWNER_MISMATCH" >&2; exit 1; }
rm -f "$workspace_lease" "$workspace_binding" "$lease"
' "$workspace_control" "$remote_control" "$owner_id" "$project_id" "$profile" "$workspace" "$root_hash" "$remote_root" >/dev/null
  if [[ $retire_for_topology_drift == true ]]; then
    trap - RETURN
    release_lock
    retire_working_set_binding || return $?
  fi
  printf 'DOWN     bridge-owned synchronization and managed processes stopped\n'
  printf 'Preserved %s and runner caches/data; no workspace was deleted.\n' "$local_root"
}

# Release a binding that is already down, so another local root can take the
# same runner. This removes no project files and never touches the runner.
run_retire() {
  local -a args=("$@")
  local marker
  parse_binding_target "${args[@]}"
  require_mode_authority || return $?
  args=("${parsed_args[@]}")
  (( ${#args[@]} == 0 )) || usage_error "unexpected retire argument: ${args[0]}"
  ensure_platform
  # The runner holds the lease, so the Mac-side evidence that this binding is
  # still live is its synchronization session and watcher identity. Releasing
  # the runner remains `down`; this only releases the local claims afterwards.
  if mutagen_session_exists; then
    fail 'RETIRE_BINDING_ACTIVE: run the exact local-agent down for this context before retiring its binding.'
    return 79
  fi
  [[ ! -e $binding_dir/watcher.pid && ! -e $binding_dir/watcher.identity.tsv ]] || {
    fail 'RETIRE_WATCHER_PRESENT: a synchronization watcher identity remains; inspect local-agent status.'
    return 79
  }
  for marker in REMOTE_DRIFT SYNC_FAILED PROCESS_ROLLBACK_FAILED UNKNOWN_EXECUTION LEASE_HEARTBEAT_FAILED; do
    [[ ! -e $binding_dir/$marker ]] || {
      fail "RETIRE_UNRESOLVED_STATE: $marker evidence remains; complete the explicit recovery before retiring."
      return 79
    }
  done
  retire_binding BINDING || return $?
  printf 'Preserved %s and runner caches/data; no project files were removed.\n' "$local_root"
}

# Re-anchoring moves a working-set binding onto a new aggregate anchor and
# member set on the same runner workspace and project ID. The runner stores the
# hash of the anchor, so `down` and `up --working-set` alone cannot do it. Each
# phase is recorded in an owner-only journal and repeating the same command
# resumes it; nothing is rolled back once the runner has moved.
reanchor_retained_file=
reanchor_lock=
reanchor_cleanup_dir=
reanchor_retired_dir=
reanchor_journal=

load_retired_binding() {
  local requested=$1 directory retired_root file bound_profile bound_origin newest marker
  [[ $requested = /* && -d $requested && ! -L $requested ]] || {
    fail "REANCHOR_RETIRED_INVALID: not a retired binding directory: $requested"; return 1;
  }
  directory=$(cd "$requested" && pwd -P)
  retired_root=$(cd "$state_root" && pwd -P)/retired
  [[ ${directory%/*} == "$retired_root" ]] || {
    fail "REANCHOR_RETIRED_INVALID: retired bindings live directly under $retired_root"; return 1;
  }
  for file in binding.tsv working-set.tsv policy.tsv managed_manifest.tsv excluded_manifest.tsv; do
    [[ -f $directory/$file && ! -L $directory/$file ]] || {
      fail "REANCHOR_RETIRED_INVALID: $directory/$file is missing or not a regular file"; return 1;
    }
  done
  python3 -c 'import os, sys
for path in sys.argv[1:]:
    info = os.lstat(path)
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise SystemExit(1)' "$directory" "$directory/binding.tsv" "$directory/managed_manifest.tsv" || {
    fail "REANCHOR_RETIRED_UNTRUSTED: $directory must be owner-only"; return 1;
  }
  file=$directory/binding.tsv
  [[ $(binding_value schema "$file") == 1 && $(binding_value workspace_role "$file") == runner ]] || {
    fail 'REANCHOR_RETIRED_INVALID: unsupported retired binding'; return 1;
  }
  [[ $(binding_value binding_kind "$file" 2>/dev/null || true) == working-set ]] || {
    fail 'REANCHOR_KIND_UNSUPPORTED: only a working-set binding is re-anchored here; a single-root project moves with mode rebind'
    return 1
  }
  bound_profile=$(binding_value profile "$file")
  bound_origin=$(binding_value coder_origin "$file")
  [[ -z $profile || $profile == "$bound_profile" ]] || { fail "binding profile mismatch: expected $bound_profile, got $profile"; return 1; }
  [[ -z $coder_origin || $coder_origin == "$bound_origin" ]] || { fail "binding Coder origin mismatch: expected $bound_origin, got $coder_origin"; return 1; }
  profile=$bound_profile
  coder_origin=$bound_origin
  project_id=$(binding_value project_id "$file")
  workspace=$(binding_value workspace "$file")
  local_root=$(binding_value local_root "$file")
  remote_root=$(binding_value remote_root "$file")
  remote_control=$(binding_value remote_control "$file")
  root_hash=$(binding_value root_hash "$file")
  mutagen_session=$(binding_value mutagen_session "$file")
  topology_digest=$(binding_value topology_digest "$file")
  ssh_alias=$(binding_value ssh_alias "$file")
  binding_kind=working-set
  [[ $(printf '%s' "$local_root" | sha256_stream) == "$root_hash" && \
     $remote_root == "/home/coder/projects/$project_id" && \
     $remote_control == "/home/coder/.local/share/remote-dev/local-agent/$project_id" && \
     $(binding_value topology_digest "$directory/working-set.tsv") == "$topology_digest" && \
     ${directory##*/} == *-"${root_hash:0:16}" ]] || {
    fail 'REANCHOR_RETIRED_INVALID: retired binding identity is inconsistent'; return 1;
  }
  newest=$(find "$retired_root" -mindepth 1 -maxdepth 1 -type d -name "*-${root_hash:0:16}" | LC_ALL=C sort | tail -1)
  [[ $newest == "$directory" ]] || {
    fail "REANCHOR_RETIRED_SUPERSEDED: $newest is the latest retired binding of this root"; return 1;
  }
  [[ ! -e $state_root/bindings/by-root/$root_hash ]] || {
    fail 'REANCHOR_RETIRED_SUPERSEDED: the previous root is bound again; re-anchor that binding with --for-context'; return 1;
  }
  for marker in REMOTE_DRIFT SYNC_FAILED PROCESS_ROLLBACK_FAILED UNKNOWN_EXECUTION LEASE_HEARTBEAT_FAILED watcher.pid watcher.identity.tsv; do
    [[ ! -e $directory/$marker ]] || {
      fail "RETIRE_UNRESOLVED_STATE: the retired binding keeps $marker evidence; resolve it before re-anchoring"; return 79;
    }
  done
  topology_file=$directory/working-set.tsv
  policy_file=$directory/policy.tsv
  managed_manifest=$directory/managed_manifest.tsv
  excluded_manifest=$directory/excluded_manifest.tsv
  reanchor_retired_dir=$directory
}

write_reanchor_journal() {
  printf 'schema\t1\nkind\treanchor\noperation_id\t%s\nphase\t%s\nprofile\t%s\ncoder_origin\t%s\nworkspace\t%s\nproject_id\t%s\nprevious_root\t%s\nprevious_root_hash\t%s\nanchor\t%s\nanchor_hash\t%s\ntopology_digest\t%s\nmanifest\t%s\nretired_binding\t%s\nupdated_at\t%s\n' \
    "$reanchor_operation" "$1" "$profile" "$coder_origin" "$workspace" "$project_id" \
    "$reanchor_previous_root" "$reanchor_previous_hash" "$reanchor_anchor" "$reanchor_anchor_hash" \
    "$reanchor_digest" "$reanchor_manifest" "$reanchor_retired_dir" "$(date +%s)" | write_atomic "$reanchor_journal"
}

run_reanchor() {
  workspace=${1:-}
  [[ -n $workspace && $workspace != --* ]] || usage_error 'local-agent reanchor requires the runner workspace'
  validate_workspace "$workspace" || exit 2
  shift
  local requested_project= confirm_anchor= previous_context= retired= confirm_retired= phase path hash claim claimed
  local requested_workspace=$workspace proposed output status=0 previous_dir retire_output= down_output=
  while (( $# > 0 )); do
    case "$1" in
      --project-id) (( $# >= 2 )) || usage_error '--project-id requires a value'; requested_project=$2; shift 2 ;;
      --working-set) (( $# >= 2 )) || usage_error '--working-set requires a manifest path'; reanchor_manifest=$2; shift 2 ;;
      --confirm-anchor) (( $# >= 2 )) || usage_error '--confirm-anchor requires a path'; confirm_anchor=$2; shift 2 ;;
      --for-context) (( $# >= 2 )) || usage_error '--for-context requires a path'; previous_context=$2; shift 2 ;;
      --retired-binding) (( $# >= 2 )) || usage_error '--retired-binding requires a path'; retired=$2; shift 2 ;;
      --confirm-retired) (( $# >= 2 )) || usage_error '--confirm-retired requires a path'; confirm_retired=$2; shift 2 ;;
      *) usage_error "unexpected local-agent reanchor argument: $1" ;;
    esac
  done
  validate_project_id "$requested_project" || exit 2
  [[ ${reanchor_manifest:-} = /* ]] || usage_error 'local-agent reanchor requires an absolute --working-set manifest'
  [[ -n $confirm_anchor ]] || usage_error 'local-agent reanchor requires --confirm-anchor <new absolute anchor>'
  if [[ -n $previous_context && -n $retired || -z $previous_context && -z $retired ]]; then
    usage_error 'name the current binding with exactly one of --for-context or --retired-binding'
  fi
  if [[ -n $retired && $confirm_retired != "$retired" ]]; then
    fail 'REANCHOR_CONFIRMATION_REQUIRED: repeat the exact retired binding directory in --confirm-retired'; exit 1
  fi
  mkdir -p "$state_root/reanchor"
  chmod 0700 "$state_root" "$state_root/reanchor" 2>/dev/null || true
  proposed=$(mktemp -d "$state_root/reanchor/.proposed.XXXXXX")
  projection_temps+=("$proposed")
  reanchor_digest=$(python3 "$working_set_helper" normalize --manifest "$reanchor_manifest" \
    --snapshot-out "$proposed/working-set.tsv" --policy-out "$proposed/policy.tsv") || exit $?
  reanchor_anchor=$(binding_value anchor "$proposed/working-set.tsv")
  [[ $confirm_anchor == "$reanchor_anchor" ]] || {
    fail "REANCHOR_CONFIRMATION_REQUIRED: repeat the exact new anchor in --confirm-anchor: $reanchor_anchor"; exit 1;
  }
  reanchor_anchor_hash=$(printf '%s' "$reanchor_anchor" | sha256_stream)
  reanchor_operation=$(printf 'reanchor\n%s\n%s\n%s\n%s\n' "$workspace" "$requested_project" \
    "$reanchor_anchor" "$reanchor_digest" | sha256_stream)
  local operation_dir=$state_root/reanchor/$reanchor_operation
  reanchor_journal=$operation_dir/journal.tsv
  if mkdir "$operation_dir" 2>/dev/null; then
    reanchor_cleanup_dir=$operation_dir
  fi
  chmod 0700 "$operation_dir"
  if ! mkdir "$operation_dir/operation.lock" 2>/dev/null; then
    fail "REANCHOR_BUSY: another re-anchor holds $operation_dir/operation.lock; if no Local Agent command is running, remove that directory and repeat the command"
    exit 77
  fi
  reanchor_lock=$operation_dir/operation.lock
  printf '%s\n' "$$" > "$reanchor_lock/pid"

  if [[ -f $reanchor_journal ]]; then
    [[ ! -L $reanchor_journal && $(binding_value kind "$reanchor_journal") == reanchor && \
       $(binding_value workspace "$reanchor_journal") == "$requested_workspace" && \
       $(binding_value project_id "$reanchor_journal") == "$requested_project" && \
       $(binding_value topology_digest "$reanchor_journal") == "$reanchor_digest" ]] || {
      fail "REANCHOR_JOURNAL_INVALID: $reanchor_journal"; exit 1;
    }
    [[ -z $profile || $profile == "$(binding_value profile "$reanchor_journal")" ]] || {
      fail 'binding profile mismatch with the re-anchor journal'; exit 1;
    }
    profile=$(binding_value profile "$reanchor_journal")
    coder_origin=$(binding_value coder_origin "$reanchor_journal")
    project_id=$requested_project
    reanchor_previous_root=$(binding_value previous_root "$reanchor_journal")
    reanchor_previous_hash=$(binding_value previous_root_hash "$reanchor_journal")
    reanchor_retired_dir=$(binding_value retired_binding "$reanchor_journal" || true)
    if [[ -n $retired && -n $reanchor_retired_dir && $(cd "$retired" 2>/dev/null && pwd -P) != "$reanchor_retired_dir" ]]; then
      fail 'REANCHOR_JOURNAL_MISMATCH: this re-anchor already uses another retired binding'; exit 1
    fi
    phase=$(binding_value phase "$reanchor_journal")
  else
    if [[ -n $previous_context ]]; then
      load_binding_for_context "$previous_context" || exit 1
      [[ $binding_kind == working-set ]] || {
        fail 'REANCHOR_KIND_UNSUPPORTED: only a working-set binding is re-anchored here; a single-root project moves with mode rebind'
        exit 1
      }
      previous_dir=$binding_dir
      [[ -f $excluded_manifest && ! -L $excluded_manifest ]] || {
        fail 'REANCHOR_BINDING_UNSYNCHRONIZED: the current binding has no accepted projection; run local-agent up first'; exit 1;
      }
    else
      load_retired_binding "$retired" || exit $?
      previous_dir=$reanchor_retired_dir
    fi
    [[ $workspace == "$requested_workspace" && $project_id == "$requested_project" ]] || {
      fail "REANCHOR_IDENTITY_MISMATCH: the current binding is $profile/$workspace project=$project_id; re-anchoring keeps both"
      exit 1
    }
    reanchor_previous_root=$local_root
    reanchor_previous_hash=$root_hash
    [[ $reanchor_anchor != "$reanchor_previous_root" ]] || {
      fail 'REANCHOR_SAME_ANCHOR: the anchor is unchanged; change the member set with exact local-agent down, then up --working-set'
      exit 1
    }
    [[ ! -e $state_root/bindings/by-root/$reanchor_anchor_hash ]] || {
      fail "REANCHOR_TARGET_BOUND: $reanchor_anchor already has a Local Agent binding"; exit 1;
    }
    local -a contexts=("$reanchor_anchor")
    while IFS=$'\t' read -r path _ claimed _ _; do
      [[ $path == member ]] && contexts+=("$claimed")
    done < "$proposed/working-set.tsv"
    for path in "${contexts[@]}"; do
      hash=$(printf '%s' "$path" | sha256_stream)
      claim=$state_root/bindings/by-context/$hash.claim
      if [[ -e $claim ]]; then
        IFS= read -r claimed < "$claim" || true
        [[ -n $previous_context && $claimed == "$previous_dir" ]] || {
          fail "LOCAL_CONTEXT_ALREADY_BOUND: $path belongs to another Local Agent binding"; exit 1;
        }
      fi
      if [[ -e $state_root/bindings/by-root/$hash/binding.tsv && $state_root/bindings/by-root/$hash != "$previous_dir" ]]; then
        fail "LOCAL_CONTEXT_ALREADY_BOUND: an existing single-root binding owns $path"; exit 1
      fi
    done
    claim=$state_root/bindings/by-runner/$profile/$workspace.claim
    if [[ -e $claim ]]; then
      IFS= read -r claimed < "$claim" || true
      [[ -n $previous_context && $claimed == "$previous_dir" ]] || {
        fail "RUNNER_CLAIMED: $profile/$workspace is claimed by another local binding: $claimed"; exit 1;
      }
    fi
    python3 "$working_set_helper" reanchor-plan --old-snapshot "$topology_file" \
      --old-excluded "$excluded_manifest" --new-snapshot "$proposed/working-set.tsv" \
      --new-policy "$proposed/policy.tsv" --retained-out "$operation_dir/retained.tsv" \
      > "$operation_dir/plan.tsv" || exit $?
    if [[ -n $previous_context ]]; then
      phase=planned
    else
      phase=released
    fi
    write_reanchor_journal "$phase"
    reanchor_cleanup_dir=
  fi

  ensure_platform
  if [[ $phase == planned ]]; then
    previous_dir=$state_root/bindings/by-root/$reanchor_previous_hash
    if [[ -d $previous_dir ]]; then
      load_binding_dir "$previous_dir" || exit 1
      if mutagen_session_exists || [[ -e $binding_dir/watcher.pid || -e $binding_dir/watcher.identity.tsv ]]; then
        down_output=$("$script_path" --profile "$profile" --coder-url "$coder_origin" \
          down --for-context "$reanchor_previous_root" 2>&1) || status=$?
        printf '%s\n' "$down_output"
        (( status == 0 )) || exit "$status"
      fi
      if [[ -d $previous_dir ]]; then
        retire_output=$("$script_path" --profile "$profile" --coder-url "$coder_origin" \
          retire --for-context "$reanchor_previous_root" 2>&1) || status=$?
        printf '%s\n' "$retire_output"
        (( status == 0 )) || exit "$status"
      fi
    fi
    # A retirement completed before this journal recorded it is the latest
    # retired directory of the previous root.
    reanchor_retired_dir=$(find "$state_root/retired" -mindepth 1 -maxdepth 1 -type d \
      -name "*-${reanchor_previous_hash:0:16}" 2>/dev/null | LC_ALL=C sort | tail -1)
    [[ -n $reanchor_retired_dir ]] || { fail 'REANCHOR_RETIRED_MISSING: the previous binding was not retired'; exit 1; }
    phase=released
    write_reanchor_journal "$phase"
  fi

  if [[ $phase == released ]]; then
    local requested_profile=$profile requested_origin=$coder_origin
    load_retired_binding "$reanchor_retired_dir" || exit $?
    [[ $profile == "$requested_profile" && $coder_origin == "$requested_origin" && \
       $root_hash == "$reanchor_previous_hash" && $workspace == "$requested_workspace" && \
       $project_id == "$requested_project" ]] || {
      fail 'REANCHOR_JOURNAL_MISMATCH: the retired binding differs from the re-anchor journal'; exit 1;
    }
    if mutagen_session_exists; then
      fail 'RETIRE_BINDING_ACTIVE: the retired binding still has a synchronization session'; exit 79
    fi
    # Temporary audit files belong to the operation, not to the retired binding.
    binding_dir=$operation_dir
    resolved_local_cwd=$reanchor_anchor
    ensure_coder_context
    require_runner_role || {
      printf 'Recovery: start the runner with bin/remote-dev --profile %s workspace start %s, then repeat this command.\n' \
        "$profile" "$workspace" >&2
      exit 1
    }
    require_remote_mode_authority || exit $?
    remote_manifest_to "$operation_dir/previous-remote.tsv" "$managed_manifest" || exit $?
    output=$(python3 "$working_set_helper" reanchor-verify --expected "$managed_manifest" \
      --actual "$operation_dir/previous-remote.tsv" 2>&1) || {
      status=$?
      { printf '%s\n' "$output"; diff -u "$managed_manifest" "$operation_dir/previous-remote.tsv" || true; } | \
        write_atomic "$operation_dir/REMOTE_DRIFT"
      printf '%s\n' "$output" >&2
      printf 'Recovery: inspect %s, restore the runner paths it names to the previous managed manifest or remove the unexpected ones, then repeat this command.\n' \
        "$operation_dir/REMOTE_DRIFT" >&2
      exit "$status"
    }
    rm -f "$operation_dir/REMOTE_DRIFT"
    local compressed=$operation_dir/previous-managed.gz
    gzip -c "$managed_manifest" > "$compressed"
    output=$(remote_bash 'exec python3 -c "$1" "${@:2}"' \
      "$(cat "${script_path%/*}/remote-dev-local-agent-reanchor-runner.py")" \
      "$workspace_control" "$remote_control" "$project_id" "$profile" "$workspace" \
      "$reanchor_previous_hash" "$reanchor_anchor_hash" "$remote_root" < "$compressed") || exit $?
    rm -f "$compressed" "$operation_dir/previous-remote.tsv"
    [[ $output == REANCHOR_RUNNER_MOVED* ]] || { fail "REANCHOR_RUNNER_RESULT_INVALID: $output"; exit 1; }
    phase=runner-moved
    write_reanchor_journal "$phase"
  fi

  if [[ $phase == runner-moved ]]; then
    reanchor_retained_file=$operation_dir/retained.tsv
    project_id=$requested_project
    run_up "$requested_workspace" --project-id "$requested_project" --working-set "$reanchor_manifest"
    phase=complete
    write_reanchor_journal "$phase"
  fi

  [[ $phase == complete ]] || { fail "REANCHOR_JOURNAL_INVALID: unknown phase $phase"; exit 1; }
  printf 'REANCHORED     %s -> %s\n' "$reanchor_previous_root" "$reanchor_anchor"
  printf 'Runner         %s/%s project=%s (root hash moved)\n' "$profile" "$requested_workspace" "$requested_project"
  if [[ -s $operation_dir/retained.tsv ]]; then
    printf 'Retained       %s\n' "$(cut -f 2 "$operation_dir/retained.tsv" | paste -sd ' ' -)"
  fi
  printf 'Journal        %s\n' "$reanchor_journal"
}

run_watch() {
  binding_dir=$1
  local identity_file=$binding_dir/watcher.identity.tsv pid_file=$binding_dir/watcher.pid self_token status
  local source_token last_source_token baseline_file=$binding_dir/watcher-baseline.token now last_audit waiter_status
  load_binding_dir "$binding_dir"
  ensure_platform
  ensure_coder_context
  self_token=$(process_start_token "$$")
  [[ -n $self_token ]] || { fail 'WATCHER_IDENTITY_UNAVAILABLE'; return 77; }
  write_local_process_identity "$identity_file" "$$" "$self_token"
  printf '%s\n' "$$" | write_atomic "$pid_file"
  cleanup_watch_identity() {
    cleanup_projection_temps
    cancel_bounded_transport
    cleanup_ssh_transport
    release_lock
    if identity_matches_binding "$identity_file" "$$" && \
       [[ $(binding_value start_token "$identity_file" 2>/dev/null || true) == "$self_token" ]]; then
      rm -f "$pid_file" "$identity_file"
    fi
  }
  defer_or_exit_watch_signal() {
    local code=$1
    if [[ $lock_signal_defer == true ]]; then
      lock_signal_pending=$code
      return 0
    fi
    cancel_bounded_transport
    exit "$code"
  }
  trap cleanup_watch_identity EXIT
  trap 'defer_or_exit_watch_signal 143' TERM
  trap 'defer_or_exit_watch_signal 130' INT
  [[ -f $baseline_file && ! -L $baseline_file ]] || { fail 'WATCHER_BASELINE_MISSING'; exit 77; }
  IFS= read -r last_source_token < "$baseline_file"
  [[ $last_source_token =~ ^[0-9a-f]{64}$ ]] || { fail 'WATCHER_BASELINE_INVALID'; exit 77; }
  now=$(date +%s)
  last_audit=$now
  while live_identity_matches "$identity_file" "$$" && [[ -f $pid_file ]] && [[ $(<"$pid_file") == "$$" ]]; do
    if ! require_mode_authority; then
      mutagen sync pause "$mutagen_session" >/dev/null || exit 76
      exit 0
    fi
    if [[ -e $binding_dir/PROCESS_ROLLBACK_FAILED ]]; then
      if ! mutagen sync pause "$mutagen_session" >/dev/null; then
        rollback_handle=$(binding_value handle "$binding_dir/PROCESS_ROLLBACK_FAILED" 2>/dev/null || true)
        printf 'SYNC_FAILED\nreason\tactivation-rollback-pause-failed\nhandle\t%s\ndetected_at\t%s\n' \
          "$rollback_handle" "$(date +%s)" | \
          write_atomic "$binding_dir/SYNC_FAILED"
        exit 76
      fi
      exit 79
    fi
    if [[ -e $binding_dir/REMOTE_DRIFT || -e $binding_dir/UNKNOWN_EXECUTION ]]; then
      mutagen sync pause "$mutagen_session" >/dev/null 2>&1 || true
      exit 74
    fi
    set +e
    foreground_waiter_exists
    waiter_status=$?
    set -e
    if (( waiter_status == 0 )); then
      sleep "$WATCH_INTERVAL_SECONDS"
      continue
    elif (( waiter_status != 1 )); then
      exit "$waiter_status"
    fi
    # Foreground barriers publish a new baseline while this watcher yields.
    # Re-read it so a completed foreground sync is not immediately repeated.
    [[ -f $baseline_file && ! -L $baseline_file ]] || { fail 'WATCHER_BASELINE_MISSING'; exit 77; }
    IFS= read -r last_source_token < "$baseline_file"
    [[ $last_source_token =~ ^[0-9a-f]{64}$ ]] || { fail 'WATCHER_BASELINE_INVALID'; exit 77; }
    source_token=$(source_state_token) || exit $?
    now=$(date +%s)
    set +e
    if [[ $source_token != "$last_source_token" ]]; then
      sync_barrier true false watcher
      status=$?
      if (( status == 0 )); then
        last_source_token=$source_token
        last_audit=$now
      fi
    elif (( now - last_audit >= REMOTE_AUDIT_INTERVAL_SECONDS )); then
      watcher_remote_audit
      status=$?
      if (( status == 0 )); then
        last_audit=$now
      fi
    else
      status=0
    fi
    set -e
    if (( status == 82 )); then
      sleep "$WATCH_INTERVAL_SECONDS"
      continue
    fi
    (( status == 0 )) || exit "$status"
    sleep "$WATCH_INTERVAL_SECONDS"
  done
}

# Opt-in phase timings contain only static function names, PIDs and timestamps.
# Do not use shell tracing here: argv and transport input may contain secrets.
if [[ -n ${REMOTE_DEV_LOCAL_AGENT_TIMING_FILE:-} ]]; then
  timing_event() {
    python3 -c 'import sys,time; f=open(sys.argv[1], "a"); f.write("\t".join([str(time.time_ns()), *sys.argv[2:]])+"\n")' \
      "$REMOTE_DEV_LOCAL_AGENT_TIMING_FILE" "$$" "$1" "$2"
  }
  for timing_function in load_binding_for_context assert_topology_current ensure_platform ensure_coder_context require_runner_role prepare_bound_command acquire_lock refresh_remote_lease remote_recovery_gate source_state_token materialize_projection ensure_mutagen_session remote_manifest_to sync_barrier start_execution_heartbeat stop_execution_heartbeat post_execution_drift_check coder_ssh coder_ssh_bounded; do
    timing_definition=$(declare -f "$timing_function")
    eval "${timing_definition/$timing_function ()/_timed_$timing_function ()}"
    eval "$timing_function() { timing_event begin $timing_function; _timed_$timing_function \"\$@\"; local timing_status=\$?; timing_event end $timing_function; return \"\$timing_status\"; }"
  done
fi

if [[ ${1:-} == _watch ]]; then
  (( $# == 2 )) || exit 2
  run_watch "$2"
  exit
fi

if [[ ${1:-} == _heartbeat ]]; then
  (( $# == 5 )) || exit 2
  run_heartbeat "$2" "$3" "$4" "$5"
  exit
fi

while (( $# > 0 )); do
  case "$1" in
    --profile) (( $# >= 2 )) || usage_error '--profile requires a value'; profile=$2; shift 2 ;;
    --coder-url) (( $# >= 2 )) || usage_error '--coder-url requires a value'; coder_origin=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done

command=${1:-}
[[ -n $command ]] || { usage >&2; exit 2; }
shift
trap cleanup_local_agent EXIT
case "$command" in
  up) run_up "$@" ;;
  status) run_status "$@" ;;
  resume) run_resume "$@" ;;
  allow-untracked) run_allow_untracked "$@" ;;
  exec) run_exec "$@" ;;
  start) run_start "$@" ;;
  logs) run_logs "$@" ;;
  stop) run_stop "$@" ;;
  restart) run_restart "$@" ;;
  down) run_down "$@" ;;
  retire) run_retire "$@" ;;
  reanchor) run_reanchor "$@" ;;
  -h|--help) usage ;;
  *) usage_error "unknown local-agent command: $command" ;;
esac
