# Example host profile. Copy to deploy/host-profiles/<name>.env and edit.
# A profile holds no secrets: it only names identities and points to
# credential files kept outside Git. `bin/remote-dev init` and
# `bin/remote-dev quickstart` write the minimal part for you.
#
# The name must equal the file name without .env.
REMOTE_DEV_PROFILE_NAME=example

# ---------------------------------------------------------------------------
# Minimal topology (default for new profiles)
#   ssh-forward: nothing is published; open Coder through
#                `bin/remote-dev --profile example forward`
#   host:        workspaces use the server's own Internet route
# ---------------------------------------------------------------------------
REMOTE_DEV_PROFILE_INGRESS=ssh-forward
REMOTE_DEV_PROFILE_EGRESS=host

# SSH alias (or host) that reaches the server as the `dev` user.
REMOTE_DEV_PROFILE_SSH_HOST=example

# ssh-forward: the Mac-side loopback URL served by `forward`.
REMOTE_DEV_PROFILE_CODER_ACCESS_URL=http://127.0.0.1:3080
# Coder's loopback port on the server.
REMOTE_DEV_PROFILE_CODER_HOST_PORT=3080

# Workspace networks (IPv4, must not overlap each other or your networks).
REMOTE_DEV_PROFILE_EGRESS_SUBNET=10.250.10.0/24
REMOTE_DEV_PROFILE_EGRESS_GATEWAY=10.250.10.1
REMOTE_DEV_PROFILE_EGRESS_MTU=1500
REMOTE_DEV_PROFILE_CONTROL_SUBNET=10.250.11.0/24

# Optional: provider network mirror when the server cannot reach the public
# Terraform registry. Must be an https URL ending with /.
#REMOTE_DEV_PROFILE_TERRAFORM_MIRROR=https://terraform-mirror.example.invalid/

# Optional: install refuses a server whose hostname differs.
#REMOTE_DEV_PROFILE_EXPECTED_HOSTNAME=example-host
#REMOTE_DEV_PROFILE_SYSTEM_ROLE=dev-server
#REMOTE_DEV_PROFILE_DISPLAY_NAME='Example development server'

# ---------------------------------------------------------------------------
# Advanced: Cloudflare Tunnel ingress
# Replace the ingress line above and the access URL with these values.
# See docs/advanced-topology.md.
# ---------------------------------------------------------------------------
#REMOTE_DEV_PROFILE_INGRESS=cloudflare-tunnel
#REMOTE_DEV_PROFILE_CODER_ACCESS_URL=https://coder.example.com
#REMOTE_DEV_PROFILE_CLOUDFLARE_TUNNEL_ID=00000000-0000-4000-8000-000000000000
#REMOTE_DEV_PROFILE_CLOUDFLARE_HOSTNAME=coder.example.com
# Tunnel credential JSON on the Mac; owner-only permissions; never in Git.
#REMOTE_DEV_PROFILE_CLOUDFLARE_CREDENTIALS="$HOME/.config/remote-dev/example/cloudflared.json"

# ---------------------------------------------------------------------------
# Advanced: WireGuard egress
# Replace the egress line and MTU above with these values.
# ---------------------------------------------------------------------------
#REMOTE_DEV_PROFILE_EGRESS=wireguard
#REMOTE_DEV_PROFILE_EGRESS_MTU=1420
#REMOTE_DEV_PROFILE_WIREGUARD_INTERFACE=wg-egress
# Interface address assigned by your WireGuard peer.
#REMOTE_DEV_PROFILE_WIREGUARD_ADDRESS=10.66.0.2/32
# Public key of the client private key in the configuration below (wg pubkey).
#REMOTE_DEV_PROFILE_WIREGUARD_PUBLIC_KEY=<base64 public key>
# Client configuration on the Mac; owner-only permissions; never in Git.
#REMOTE_DEV_PROFILE_WIREGUARD_CONFIG="$HOME/.config/remote-dev/example/wg-egress.conf"
# Free policy routing table on the server (not 253-255).
#REMOTE_DEV_PROFILE_POLICY_TABLE=4242
