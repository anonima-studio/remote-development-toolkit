networkd_foreign_setting() {
  awk -v key="$1" '
    /^[[:space:]]*\[/ { section = $0; gsub(/[[:space:]]/, "", section); next }
    section == "[Network]" && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      value = $0
      sub(/^[^=]*=[[:space:]]*/, "", value)
      sub(/[[:space:]]+$/, "", value)
      result = tolower(value)
    }
    END { print result }'
}
check_networkd_keeps_egress_rules() {
  local config setting value timestamp started files file mtime newest=0
  config=$(systemd-analyze cat-config systemd/networkd.conf 2>&1) || {
    echo 'cannot read the effective networkd.conf'
    return 1
  }
  for setting in ManageForeignRoutingPolicyRules ManageForeignRoutes; do
    value=$(networkd_foreign_setting "$setting" <<<"$config")
    case $value in
      no|false|0|off|n|f) ;;
      *)
        echo "$setting is not disabled (effective value: ${value:-unset})"
        return 1
        ;;
    esac
  done
  if [[ $(systemctl is-active systemd-networkd) != active ]]; then
    echo 'systemd-networkd is not active'
    return 1
  fi
  timestamp=$(systemctl show systemd-networkd -p ActiveEnterTimestamp --value) || return 1
  if [[ -z $timestamp ]]; then
    echo 'systemd-networkd reports no start time'
    return 1
  fi
  started=$(date -d "$timestamp" +%s) || {
    echo "cannot read the systemd-networkd start time: $timestamp"
    return 1
  }
  files=$(sed -nE 's|^# (/[^[:space:]]+)$|\1|p' <<<"$config")
  while IFS= read -r file; do
    [[ -n $file ]] || continue
    mtime=$(stat -L -c %Y -- "$file") || {
      echo "cannot stat $file"
      return 1
    }
    if ((mtime > newest)); then
      newest=$mtime
    fi
  done <<<"$files"
  if ((newest == 0)); then
    echo 'no networkd configuration file found'
    return 1
  fi
  if ((started < newest)); then
    echo 'systemd-networkd started before its last configuration change; restart it to load the change'
    return 1
  fi
}
if networkd_reason=$(check_networkd_keeps_egress_rules 2>&1); then
  echo 'OK   networkd keeps workspace egress rules across restarts'
else
  echo "FAIL networkd keeps workspace egress rules across restarts: $networkd_reason"
  failures=$((failures + 1))
fi
else
  echo 'SKIP WireGuard egress (host egress uses the host default route)'
fi
control_gateway=$(python3 -c \
  'import ipaddress,sys; print(next(ipaddress.ip_network(sys.argv[1]).hosts()))' \
  "$control_subnet")
check_network_contract() {
  local name=$1 subnet=$2 gateway=$3 internal=$4 mtu=$5 attached=$6
  docker network inspect "$name" | python3 -c '
import ipaddress
import json
import sys

name, expected_subnet, expected_gateway, expected_internal, expected_mtu, attached = sys.argv[1:]
payload = json.load(sys.stdin)
if not isinstance(payload, list) or len(payload) != 1:
    raise SystemExit(1)
network = payload[0]
configs = network.get("IPAM", {}).get("Config", [])
ipv4 = [item for item in configs if isinstance(item, dict) and ":" not in item.get("Subnet", "")]
actual_mtu = network.get("Options", {}).get("com.docker.network.driver.mtu", "")
expected_mtu = "" if expected_mtu == "-" else expected_mtu
containers = {
    item.get("Name") for item in network.get("Containers", {}).values()
    if isinstance(item, dict)
}
valid = (
    network.get("Name") == name
    and network.get("Driver") == "bridge"
    and network.get("Internal") is (expected_internal == "true")
    and len(ipv4) == 1
    and ipaddress.ip_network(ipv4[0].get("Subnet", ""), strict=True)
        == ipaddress.ip_network(expected_subnet, strict=True)
    and ipv4[0].get("Gateway") == expected_gateway
    and actual_mtu == expected_mtu
    and (attached == "-" or attached in containers)
)
raise SystemExit(0 if valid else 1)
' "$name" "$subnet" "$gateway" "$internal" "$mtu" "$attached"
}
check 'workspace egress network contract' check_network_contract \
  remote-dev-egress "$egress_subnet" "$egress_gateway" false "$egress_mtu" -
check 'Coder control network contract' check_network_contract \
  remote-dev-control "$control_subnet" "$control_gateway" true - \
  remote-dev-coder-coder-1
