# Append-only REST server on an independent host/failure domain.
RESTIC_REPOSITORY=rest:https://backup.example.invalid:8000/remote-dev/
RESTIC_PASSWORD_FILE=/etc/remote-dev/restic-password
RESTIC_REST_USERNAME=primary-append-only
RESTIC_REST_PASSWORD=REPLACE_WITH_REST_SERVER_CREDENTIAL

# Read 2% of repository data after each snapshot. A recovery-host maintenance
# job must run full checks and retention separately.
RESTIC_CHECK_SUBSET=1/50
