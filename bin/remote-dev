fi
check 'PostgreSQL healthy' docker exec remote-dev-coder-database-1 pg_isready -U coder -d coder
if [[ -s /opt/remote-dev/coder/operator.session ]]; then
  operator_token=$(tr -d '\r\n' < /opt/remote-dev/coder/operator.session)
  check 'Coder operator session' docker exec \
    -e CODER_URL=http://127.0.0.1:7080 \
