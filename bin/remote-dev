ingress=${12}
egress=${13}
failures=0
check() {
  local label=$1
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'OK   %s\n' "$label"
  else
    printf 'FAIL %s\n' "$label"
    failures=$((failures + 1))
  fi
}

check 'passwordless sudo' sudo -n true
check 'Docker daemon' docker info
verified_workspace_image_id=
check_workspace_image() {
  local image source_hash actual_hash
  source_hash=$(cat /opt/remote-dev/coder/workspace-image.sha256) || return 1
  [[ $source_hash =~ ^[0-9a-f]{64}$ ]] || return 1
  image=$(python3 -c '
import pathlib, re
text = pathlib.Path("/opt/remote-dev/templates/docker/main.tf").read_text()
images = re.findall(r"^\s*image\s*=\s*\"(remote-dev-workspace:[^\"]+)\"\s*$", text, re.M)
if len(images) != 1:
    raise SystemExit(1)
print(images[0])
') || return 1
  actual_hash=$(docker image inspect --format \
    '{{index .Config.Labels "id0.remote-dev.workspace-source-sha256"}}' "$image") || return 1
  [[ $actual_hash == "$source_hash" ]] || return 1
  verified_workspace_image_id=$(docker image inspect --format '{{.Id}}' "$image")
}
check 'pinned workspace image and source hash' check_workspace_image
check_workspace_image_retention() {
  local image_id identity
  image_id=$verified_workspace_image_id
  [[ $image_id =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
  identity=$(docker container inspect --format \
    '{{.Image}}|{{.State.Status}}|{{index .Config.Labels "id0.remote-dev.purpose"}}' \
    "remote-dev-image-retention-${image_id#sha256:}") || return 1
  [[ $identity == "$image_id|created|image-retention" ]]
}
check 'workspace image retained across stop' check_workspace_image_retention
if python3 /opt/remote-dev/coder/workspace-images.py --port "$coder_host_port"; then
  echo 'OK   images for all existing workspace versions and their active templates'
else
  echo 'FAIL workspace image dependency coverage'
  failures=$((failures + 1))
fi
