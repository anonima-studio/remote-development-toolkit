#!/usr/bin/env bash
set -euo pipefail

coder_bin="${REMOTE_DEV_CODER_BIN:-coder}"
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck disable=SC1091
. "$repo_root/deploy/host-profiles/load.sh"
remote_dev_load_profile "$repo_root" "${REMOTE_DEV_PROFILE:-}"
remote_dev_require_profile_fields secrets REMOTE_DEV_CODER_ACCESS_URL
[[ "$REMOTE_DEV_CODER_ACCESS_URL" =~ ^(https://[A-Za-z0-9.-]+(:[0-9]+)?|http://127\.0\.0\.1:[0-9]+)$ ]] || \
  remote_dev_profile_fail 'REMOTE_DEV_CODER_ACCESS_URL must be an https origin or http://127.0.0.1:<port>, without a path'
coder_url=$REMOTE_DEV_CODER_ACCESS_URL
if [[ -n ${REMOTE_DEV_EXPECTED_CODER_ORIGIN:-} && $coder_url != "$REMOTE_DEV_EXPECTED_CODER_ORIGIN" ]]; then
  remote_dev_profile_fail 'Coder origin differs from the reviewed caller route'
fi
coder_config_root=${REMOTE_DEV_CODEX_DESKTOP_CONFIG_ROOT:-$HOME/Library/Application Support/remote-dev/coder}
coder_global_config=${REMOTE_DEV_CODER_GLOBAL_CONFIG:-$coder_config_root/$REMOTE_DEV_PROFILE}
coder_command=("$coder_bin" --no-version-warning --global-config "$coder_global_config")

usage() {
  cat <<'EOF'
Usage:
  remote-dev secrets plan <manifest>
  remote-dev secrets apply <manifest> --confirm <workspace> \
    --confirm-profile <profile> --confirm-origin <https-origin> [--replace]
  remote-dev secrets verify <manifest>

Version 3 reads from a second workspace. Both apply and verify require the
three target confirmations above plus --confirm-source <source-workspace>.
Plan checks metadata only. Values travel through an OS pipe, never a Mac file.

The manifest contains only non-secret routing metadata. Secret values are read
from the declared files and sent directly to the Coder workspace. They
are never printed, embedded in the manifest, or included in ordinary imports.
EOF
}

fail() {
  printf 'ERROR    %s\n' "$*" >&2
  exit 1
}

validate_relative_path() {
  local value=$1
  [[ -n "$value" && "$value" != /* ]] || return 1
  [[ "$value" != */ && "$value" != *//* ]] || return 1
  [[ "$value" != "." && "$value" != ".." ]] || return 1
  [[ "$value" != ../* && "$value" != */../* && "$value" != */.. ]] || return 1
  [[ "$value" != ./* && "$value" != */./* && "$value" != */. ]] || return 1
  [[ "$value" != *[[:cntrl:]]* ]] || return 1
}

local_mode() {
  local path=$1
  if [[ $(uname -s) == Darwin ]]; then
    /usr/bin/stat -f '%Lp' "$path"
  else
    stat -c '%a' "$path"
  fi
}

local_hash() {
  local path=$1
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$path" | awk '{print $1}'
  else
    shasum -a 256 "$path" | awk '{print $1}'
  fi
}

declare workspace=''
declare local_root=''
declare remote_root=''
declare manifest_version=''
declare project_id=''
declare workspace_role=''
declare topology_digest=''
declare source_workspace='' source_workspace_role='' source_root='' source_context=''
declare -a source_paths=()
declare -a destination_paths=()
workspace_role_checked=false

load_manifest() {
  local manifest=$1
  local line=0 kind first second extra
  [[ -f "$manifest" && ! -L "$manifest" ]] || fail "manifest must be a regular non-symlink file: $manifest"

  while IFS=$'\t' read -r kind first second extra || [[ -n "${kind:-}${first:-}${second:-}${extra:-}" ]]; do
    line=$((line + 1))
    [[ -z "${kind:-}" || "$kind" == \#* ]] && continue
    [[ -z "${extra:-}" ]] || fail "manifest line $line has too many fields"
    case "$kind" in
      manifest_version)
        [[ -z "$manifest_version" && ( "${first:-}" == 2 || "${first:-}" == 3 ) && -z "${second:-}" ]] || fail "invalid manifest_version declaration on line $line"
        manifest_version=$first
        ;;
      project_id)
        [[ -z "$project_id" && -n "${first:-}" && -z "${second:-}" ]] || fail "invalid project_id declaration on line $line"
        [[ "$first" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "invalid project_id on line $line"
        project_id=$first
        ;;
      workspace)
        [[ -z "$workspace" && -n "${first:-}" && -z "${second:-}" ]] || fail "invalid workspace declaration on line $line"
        [[ "$first" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "invalid workspace name on line $line"
        workspace=$first
        ;;
      workspace_role)
        [[ -z "$workspace_role" && -n "${first:-}" && -z "${second:-}" ]] || fail "invalid workspace_role declaration on line $line"
        [[ "$first" == development || "$first" == runner ]] || fail "workspace_role must be development or runner on line $line"
        workspace_role=$first
        ;;
      local_root)
        [[ -z "$local_root" && "${first:-}" == /* && -z "${second:-}" ]] || fail "invalid local_root declaration on line $line"
        local_root=$first
        ;;
      remote_root)
        [[ -z "$remote_root" && -z "${second:-}" ]] || fail "invalid remote_root declaration on line $line"
        [[ "${first:-}" =~ ^/home/coder/projects/[A-Za-z0-9._@+/-]+$ ]] || fail "remote_root must be below /home/coder/projects on line $line"
        [[ "$first" != */../* && "$first" != */.. && "$first" != */./* && "$first" != */. ]] || fail "remote_root contains traversal on line $line"
        remote_root=$first
        ;;
      topology_digest)
        [[ -z "$topology_digest" && "${first:-}" =~ ^[a-f0-9]{64}$ && -z "${second:-}" ]] || \
          fail "invalid topology_digest declaration on line $line"
        topology_digest=$first
        ;;
      source_workspace|source_workspace_role|source_root|source_context)
        [[ -z ${!kind} && -n ${first:-} && -z ${second:-} ]] || fail "invalid source declaration on line $line"
        printf -v "$kind" '%s' "$first"
        ;;
      file)
        validate_relative_path "${first:-}" || fail "invalid source path on line $line"
        validate_relative_path "${second:-}" || fail "invalid destination path on line $line"
        source_paths+=("$first")
        destination_paths+=("$second")
        ;;
      *) fail "unknown manifest directive '$kind' on line $line" ;;
    esac
  done < "$manifest"

  if [[ -z $manifest_version ]]; then
    manifest_version=1
    [[ -z $project_id && -z $workspace_role ]] || \
      fail 'version-1 manifests cannot declare project_id or workspace_role'
    workspace_role=development
  else
    [[ $manifest_version == 2 || $manifest_version == 3 ]] || fail "unsupported manifest version: $manifest_version"
    [[ -n $project_id ]] || fail 'version-2 manifest has no project_id declaration'
    [[ -n $workspace_role ]] || fail 'version-2 manifest has no workspace_role declaration'
  fi
  if [[ $manifest_version == 3 ]]; then
    [[ $source_workspace =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $source_workspace != "$workspace" ]] || fail 'invalid or identical source workspace'
    [[ $source_workspace_role == development || $source_workspace_role == runner ]] || fail 'invalid source role'
    [[ $source_root == /home/coder || $source_root == /home/coder/* ]] || fail 'source_root must be within /home/coder'
    [[ $source_context == /home/coder/projects/* ]] || fail 'source_context must be a project root'
  else
    [[ -z $source_workspace$source_workspace_role$source_root$source_context ]] || fail 'source headers require manifest version 3'
  fi
  [[ -n "$workspace" ]] || fail 'manifest has no workspace declaration'
  [[ -d "$local_root" ]] || fail "local_root is not a directory: $local_root"
  [[ -n "$remote_root" ]] || fail 'manifest has no remote_root declaration'
  (( ${#source_paths[@]} > 0 )) || fail 'manifest has no file entries'

  local i j
  for ((i = 0; i < ${#source_paths[@]}; i++)); do
    for ((j = i + 1; j < ${#source_paths[@]}; j++)); do
      [[ "${source_paths[$i]}" != "${source_paths[$j]}" ]] || fail "duplicate source path: ${source_paths[$i]}"
      [[ "${destination_paths[$i]}" != "${destination_paths[$j]}" ]] || fail "duplicate destination path: ${destination_paths[$i]}"
    done
  done
}

ensure_workspace_role() {
  local state status=0
  [[ $workspace_role_checked == false ]] || return 0
  set +e
  state=$("${coder_command[@]}" --url "$coder_url" ssh --disable-autostart=true \
    "$workspace" -- '
      set -euo pipefail
      marker=$HOME/.local/share/remote-dev/workspace-role
      helper=/usr/local/bin/remote-dev-workspace-role
      if [[ -x "$helper" ]]; then
        exec "$helper" show
      fi
      if [[ ! -e "$marker" && ! -L "$marker" ]]; then
        printf legacy-development
        exit 0
      fi
      [[ -f "$marker" && ! -L "$marker" ]]
      value=$(cat -- "$marker")
      bytes=$(wc -c < "$marker" | tr -d "[:space:]")
      [[ "$bytes" == $((${#value} + 1)) ]]
      case "$value" in
        development|runner) printf %s "$value" ;;
        *) exit 1 ;;
      esac
    ' 2>&1)
  status=$?
  set -e
  if (( status != 0 )); then
    if [[ $state == *'workspace must be started'* || $state == *'Workspace must be started'* || $state == *'workspace is stopped'* ]]; then
      fail "workspace $workspace is stopped; start it without changing its role: bin/remote-dev --profile $REMOTE_DEV_PROFILE workspace start $workspace"
    fi
    [[ -z $state ]] || printf '%s\n' "$state" >&2
    fail "workspace role preflight failed for $workspace"
  fi
  case "$state" in
    legacy-development)
      [[ $manifest_version == 1 && $workspace_role == development ]] || \
        fail 'version-2 manifests require an immutable workspace role marker'
      workspace_role_checked=true
      ;;
    development)
      [[ $workspace_role == development ]] || \
        fail "workspace role mismatch: manifest=$workspace_role remote=development"
      workspace_role_checked=true
      ;;
    runner)
      [[ $manifest_version != 1 && $workspace_role == runner ]] || \
        fail 'RUNNER_SECRETS_UNSUPPORTED: version-1 secret manifests cannot target runner workspaces'
      workspace_role_checked=true
      ;;
    *)
      fail "workspace role preflight returned an unexpected value for $workspace"
      ;;
  esac
}

local_agent_state_root() {
  if [[ -n ${REMOTE_DEV_LOCAL_AGENT_STATE_ROOT:-} ]]; then
    printf '%s\n' "$REMOTE_DEV_LOCAL_AGENT_STATE_ROOT"
  elif [[ $(uname -s) == Darwin ]]; then
    printf '%s\n' "$HOME/Library/Application Support/remote-dev/local-agent"
  else
    printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/remote-dev/local-agent"
  fi
}

hash_text() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | awk '{print $1}'
  else
    printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
  fi
}

paths_overlap() {
  local first=$1 second=$2
  [[ $first == "$second" || $first == "$second"/* || $second == "$first"/* ]]
}

verify_runner_binding() {
  local canonical_root git_root root_hash state_root binding_file
  local key value extra binding_line line=0
  local binding_schema='' binding_project_id='' binding_workspace=''
  local binding_role='' binding_profile='' binding_origin=''
  local binding_local_root='' binding_remote_root=''
  local binding_managed_manifest='' binding_excluded_manifest=''
  local binding_kind='single-root' binding_topology='' binding_topology_path=''
  local binding_kind_seen=false binding_topology_seen=false binding_topology_path_seen=false verified_topology
  local destination managed_path managed_type managed_mode managed_digest
  local managed_target managed_state excluded_path excluded_reason
  local remote_writable=false

  canonical_root=$(cd "$local_root" && pwd -P)
  [[ $local_root == "$canonical_root" ]] || \
    fail "version-2 runner local_root must be canonical: $canonical_root"
  root_hash=$(hash_text "$canonical_root")
  state_root=$(local_agent_state_root)
  binding_file=$state_root/bindings/by-root/$root_hash/binding.tsv
  [[ -f $binding_file && ! -L $binding_file ]] || \
    fail "active local-agent binding is missing for local_root: $canonical_root"

  while IFS= read -r binding_line || [[ -n $binding_line ]]; do
    line=$((line + 1))
    [[ $binding_line == *$'\t'* ]] || \
      fail "invalid local-agent binding line $line: $binding_file"
    key=${binding_line%%$'\t'*}
    value=${binding_line#*$'\t'}
    [[ -n $key && $value != *$'\t'* ]] || \
      fail "invalid local-agent binding line $line: $binding_file"
    # The single-root writer emits empty topology fields; all other rows stay nonempty.
    case "$key" in
      topology_path|topology_digest) ;;
      *) [[ -n $value ]] || fail "invalid local-agent binding line $line: $binding_file" ;;
    esac
    case "$key" in
      schema) [[ -z $binding_schema ]] || fail 'duplicate binding schema'; binding_schema=$value ;;
      binding_kind) [[ $binding_kind_seen == false ]] || fail 'duplicate binding binding_kind'; binding_kind_seen=true; binding_kind=$value ;;
      project_id) [[ -z $binding_project_id ]] || fail 'duplicate binding project_id'; binding_project_id=$value ;;
      workspace) [[ -z $binding_workspace ]] || fail 'duplicate binding workspace'; binding_workspace=$value ;;
      workspace_role) [[ -z $binding_role ]] || fail 'duplicate binding workspace_role'; binding_role=$value ;;
      profile) [[ -z $binding_profile ]] || fail 'duplicate binding profile'; binding_profile=$value ;;
      coder_origin) [[ -z $binding_origin ]] || fail 'duplicate binding coder_origin'; binding_origin=$value ;;
      local_root) [[ -z $binding_local_root ]] || fail 'duplicate binding local_root'; binding_local_root=$value ;;
      remote_root) [[ -z $binding_remote_root ]] || fail 'duplicate binding remote_root'; binding_remote_root=$value ;;
      managed_manifest_path) [[ -z $binding_managed_manifest ]] || fail 'duplicate binding managed_manifest_path'; binding_managed_manifest=$value ;;
      excluded_manifest_path) [[ -z $binding_excluded_manifest ]] || fail 'duplicate binding excluded_manifest_path'; binding_excluded_manifest=$value ;;
      topology_path) [[ $binding_topology_path_seen == false ]] || fail 'duplicate binding topology_path'; binding_topology_path_seen=true; binding_topology_path=$value ;;
      topology_digest) [[ $binding_topology_seen == false ]] || fail 'duplicate binding topology_digest'; binding_topology_seen=true; binding_topology=$value ;;
      *) ;;
    esac
  done < "$binding_file"

  [[ $binding_schema == 1 ]] || fail "unsupported local-agent binding schema: $binding_schema"
  [[ $binding_project_id == "$project_id" ]] || fail 'secret manifest project_id does not match the active runner binding'
  [[ $binding_workspace == "$workspace" ]] || fail 'secret manifest workspace does not match the active runner binding'
  [[ $binding_role == runner ]] || fail 'active local-agent binding is not role=runner'
  [[ $binding_profile == "$REMOTE_DEV_PROFILE" ]] || fail 'selected profile does not match the active runner binding'
  [[ $binding_origin == "$coder_url" ]] || fail 'selected Coder origin does not match the active runner binding'
  [[ $binding_local_root == "$canonical_root" ]] || fail 'secret manifest local_root does not match the active runner binding'
  [[ $binding_remote_root == "$remote_root" ]] || fail 'secret manifest remote_root does not match the active runner binding'
  case "$binding_kind" in
    single-root)
      git_root=$(git -C "$canonical_root" rev-parse --show-toplevel 2>/dev/null) || \
        fail "version-2 runner local_root is not a Git worktree: $canonical_root"
      git_root=$(cd "$git_root" && pwd -P)
      [[ $git_root == "$canonical_root" ]] || \
        fail "version-2 runner local_root must equal its Git root: $git_root"
      [[ -z $topology_digest ]] || fail 'single-root runner secret manifest must not declare topology_digest'
      ;;
    working-set)
      [[ $binding_topology =~ ^[a-f0-9]{64}$ && $binding_topology_path == /* && \
         -f $binding_topology_path && ! -L $binding_topology_path ]] || \
        fail 'active working-set topology snapshot is missing or invalid'
      [[ $topology_digest == "$binding_topology" ]] || \
        fail 'secret manifest topology_digest does not match the active working-set binding'
      verified_topology=$(python3 "$repo_root/bin/remote-dev-local-agent-working-set.py" verify \
        --snapshot "$binding_topology_path") || \
        fail 'active working-set topology has drifted; secrets are blocked until exact down and rebind'
      [[ $verified_topology == "$binding_topology" ]] || \
        fail 'active working-set snapshot digest does not match the binding'
      ;;
    *) fail "unsupported active local-agent binding kind: $binding_kind" ;;
  esac
  [[ $binding_managed_manifest == /* && -f $binding_managed_manifest && ! -L $binding_managed_manifest ]] || fail 'active runner managed manifest is missing'
  [[ $binding_excluded_manifest == /* && -f $binding_excluded_manifest && ! -L $binding_excluded_manifest ]] || fail 'active runner excluded manifest is missing'

  for destination in "${destination_paths[@]}"; do
    while IFS=$'\t' read -r managed_path managed_type managed_mode managed_digest managed_target managed_state extra || \
      [[ -n ${managed_path:-}${managed_type:-}${managed_mode:-}${managed_digest:-}${managed_target:-}${managed_state:-}${extra:-} ]]; do
      [[ $managed_path == path && $managed_type == type ]] && continue
      [[ -n $managed_path && -z ${extra:-} ]] || fail 'invalid active runner managed manifest'
      validate_relative_path "$managed_path" || fail 'active runner managed manifest has an unsafe path'
      if paths_overlap "$destination" "$managed_path"; then
        fail "runner secret destination overlaps managed source: $destination"
      fi
    done < "$binding_managed_manifest"

    remote_writable=false
    while IFS=$'\t' read -r excluded_path excluded_reason extra || \
      [[ -n ${excluded_path:-}${excluded_reason:-}${extra:-} ]]; do
      [[ $excluded_path == path && $excluded_reason == reason ]] && continue
      [[ -n $excluded_path && -n $excluded_reason && -z ${extra:-} ]] || \
        fail 'invalid active runner excluded manifest'
      validate_relative_path "$excluded_path" || fail 'active runner excluded manifest has an unsafe path'
      if [[ $excluded_reason == remote-writable ]] && \
         [[ $destination == "$excluded_path" || $destination == "$excluded_path"/* ]]; then
        remote_writable=true
      fi
    done < "$binding_excluded_manifest"
    [[ $remote_writable == true ]] || \
      fail "runner secret destination is not declared remote-writable: $destination"
  done
}

verify_version_2_identity() {
  [[ $manifest_version != 1 ]] || return 0
  if [[ $manifest_version == 3 && $source_workspace_role == runner ]]; then
    [[ $source_root == "$source_context" ]] || fail 'runner source_root must equal its bound project context'
    (
      workspace=$source_workspace
      remote_root=$source_context
      destination_paths=("${source_paths[@]}")
      verify_runner_binding
    )
  fi
  if [[ $workspace_role == runner ]]; then
    verify_runner_binding
    return 0
  fi
  [[ ${remote_root##*/} == "$project_id" ]] || \
    fail 'development version-2 project_id must match the remote project root name'
}

check_local_source() {
  local relative=$1 source="$local_root/$1" mode mode_value
  if [[ $manifest_version == 3 ]]; then
    read_remote_source "$relative" metadata || return 1
    printf 'OK       source:%s passed metadata preflight\n' "$relative"
    return 0
  fi
  if [[ -L "$source" || ! -f "$source" ]]; then
    printf 'BLOCKED  local:%s is not a regular non-symlink file\n' "$relative" >&2
    return 1
  fi
  if [[ ! -s "$source" ]]; then
    printf 'BLOCKED  local:%s is empty\n' "$relative" >&2
    return 1
  fi
  mode=$(local_mode "$source")
  mode_value=$((8#$mode))
  if (( (mode_value & 63) != 0 )); then
    printf 'WARN     local:%s has mode %s; prefer 600\n' "$relative" "$mode" >&2
  else
    printf 'OK       local:%s is present and owner-only\n' "$relative"
  fi
}

remote_state() {
  local relative=$1
  "${coder_command[@]}" --url "$coder_url" ssh --disable-autostart=true \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_ROOT=$remote_root")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_REL=$relative")" \
    "$workspace" -- '
      set -euo pipefail
      root=$REMOTE_DEV_SECRET_ROOT
      relative=$REMOTE_DEV_SECRET_REL
      [[ "$root" == /home/coder/projects/* ]]
      [[ -d "$root" && ! -L "$root" ]]
      [[ $(realpath -e "$root") == "$root" ]]
      destination="$root/$relative"
      parent=$(dirname -- "$destination")
      [[ -d "$parent" ]]
      [[ $(realpath -e "$parent") == "$parent" ]]
      [[ ! -L "$destination" ]]
      if [[ -e "$destination" ]]; then
        [[ -f "$destination" ]]
        printf PRESENT
      else
        printf ABSENT
      fi
    '
}

check_remote_destination() {
  local relative=$1 state
  if ! state=$(remote_state "$relative"); then
    printf 'BLOCKED  remote:%s failed workspace/path preflight\n' "$relative" >&2
    return 1
  fi
  case "$state" in
    ABSENT) printf 'OK       remote:%s is ready (absent)\n' "$relative" ;;
    PRESENT) printf 'NOTICE   remote:%s already exists\n' "$relative" ;;
    *)
      printf 'BLOCKED  remote:%s returned an unexpected state\n' "$relative" >&2
      return 1
      ;;
  esac
}

run_plan() {
  local failures=0 i
  verify_version_2_identity
  ensure_workspace_role
  printf 'PLAN     workspace=%s entries=%d\n' "$workspace" "${#source_paths[@]}"
  for ((i = 0; i < ${#source_paths[@]}; i++)); do
    check_local_source "${source_paths[$i]}" || failures=$((failures + 1))
    check_remote_destination "${destination_paths[$i]}" || failures=$((failures + 1))
  done
  if (( failures > 0 )); then
    printf 'BLOCKED  plan has %d failed checks\n' "$failures" >&2
    return 1
  fi
  printf 'READY    plan is valid; no secret content was transferred\n'
}

coder_env_argument() {
  # Coder parses each -e value as a CSV record, not a literal assignment.
  local escaped=${1//\"/\"\"}
  printf '"%s"' "$escaped"
}

read_remote_source() {
  local relative=$1 action=$2 guard_source reader_source
  guard_source=$(< "$repo_root/templates/docker/mode-guard.py")
  reader_source=$(< "$repo_root/bin/remote-dev-secret-read.py")
  "${coder_command[@]}" --url "$coder_url" ssh --disable-autostart=true \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_SOURCE_ROOT=$source_root")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_SOURCE_CONTEXT=$source_context")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_SOURCE_ROLE=$source_workspace_role")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_REL=$relative")" -e "$(coder_env_argument "REMOTE_DEV_SECRET_READ_ACTION=$action")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_OWNER_ONLY=${secret_owner_only:-false}")" \
    -e "$(coder_env_argument "REMOTE_DEV_MODE_OPERATION_ID=${REMOTE_DEV_MODE_OPERATION_ID:-}")" \
    -e "$(coder_env_argument "REMOTE_DEV_MODE_TOKEN=${REMOTE_DEV_MODE_TOKEN:-}")" \
    -e "$(coder_env_argument "REMOTE_DEV_MODE_GUARD_SOURCE=$guard_source")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_READ_SOURCE=$reader_source")" \
    "$source_workspace" -- 'exec python3 -c "$REMOTE_DEV_SECRET_READ_SOURCE"'
}

upload_stdin() {
  local destination_relative=$1 replace=$2
  local guard_source uploader_source
  guard_source=$(< "$repo_root/templates/docker/mode-guard.py")
  uploader_source=$(< "$repo_root/bin/remote-dev-secret-upload.py")
  if [[ $workspace_role == runner ]]; then
    REMOTE_DEV_SECRET_ROOT="$remote_root" \
    REMOTE_DEV_SECRET_REL="$destination_relative" REMOTE_DEV_SECRET_REPLACE="$replace" \
    REMOTE_DEV_MODE_OPERATION_ID="${REMOTE_DEV_MODE_OPERATION_ID:-}" \
    REMOTE_DEV_MODE_TOKEN="${REMOTE_DEV_MODE_TOKEN:-}" \
    REMOTE_DEV_MODE_GUARD_SOURCE="$guard_source" REMOTE_DEV_SECRET_UPLOAD_SOURCE="$uploader_source" \
      python3 "$repo_root/bin/remote-dev-secret-runner-upload.py" \
        "$repo_root/bin/remote-dev-local-agent" "$REMOTE_DEV_PROFILE" "$coder_url" "$local_root"
    return $?
  fi
  "${coder_command[@]}" --url "$coder_url" ssh --disable-autostart=true \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_ROOT=$remote_root")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_REL=$destination_relative")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_REPLACE=$replace")" \
    -e "$(coder_env_argument "REMOTE_DEV_MODE_OPERATION_ID=${REMOTE_DEV_MODE_OPERATION_ID:-}")" \
    -e "$(coder_env_argument "REMOTE_DEV_MODE_TOKEN=${REMOTE_DEV_MODE_TOKEN:-}")" \
    -e "$(coder_env_argument "REMOTE_DEV_MODE_GUARD_SOURCE=$guard_source")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_UPLOAD_SOURCE=$uploader_source")" \
    "$workspace" -- '
      set -euo pipefail
      exec python3 -c "$REMOTE_DEV_SECRET_UPLOAD_SOURCE"
    '
}

upload_one() {
  local source_relative=$1 destination_relative=$2 replace=$3
  if [[ $manifest_version == 3 ]]; then
    read_remote_source "$source_relative" stream | upload_stdin "$destination_relative" "$replace"
  else
    upload_stdin "$destination_relative" "$replace" < "$local_root/$source_relative"
  fi
}

verify_one() {
  local source_relative=$1 destination_relative=$2
  local source="$local_root/$source_relative" expected actual metadata remote_result
  if [[ $manifest_version == 3 ]]; then
    expected=$(read_remote_source "$source_relative" hash) || return 1
    actual=$(
      source_workspace=$workspace
      source_root=$remote_root
      source_context=$remote_root
      source_workspace_role=$workspace_role
      secret_owner_only=true
      read_remote_source "$destination_relative" hash
    ) || return 1
    [[ $expected == "$actual" ]]
    return
  else
    expected=$(local_hash "$source")
  fi
  remote_result=$("${coder_command[@]}" --url "$coder_url" ssh --disable-autostart=true \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_ROOT=$remote_root")" \
    -e "$(coder_env_argument "REMOTE_DEV_SECRET_REL=$destination_relative")" \
    "$workspace" -- '
      set -euo pipefail
      root=$REMOTE_DEV_SECRET_ROOT
      destination="$root/$REMOTE_DEV_SECRET_REL"
      parent=$(dirname -- "$destination")
      [[ -d "$root" && ! -L "$root" && $(realpath -e "$root") == "$root" ]]
      [[ -d "$parent" && $(realpath -e "$parent") == "$parent" ]]
      [[ -f "$destination" && ! -L "$destination" ]]
      mode=$(stat -c %a "$destination")
      owner=$(stat -c %U "$destination")
      [[ "$mode" == 600 && "$owner" == coder && -s "$destination" ]]
      hash=$(sha256sum "$destination" | cut -d " " -f 1)
      printf "%s:%s:%s" "$mode" "$owner" "$hash"
    ')
  metadata=${remote_result%:*}
  actual=${remote_result##*:}
  [[ "$expected" == "$actual" ]] || return 1
  [[ "$metadata" == '600:coder' ]] || return 1
}

run_verify() {
  local failures=0 i
  verify_version_2_identity
  ensure_workspace_role
  for ((i = 0; i < ${#source_paths[@]}; i++)); do
    if check_local_source "${source_paths[$i]}" >/dev/null && \
       verify_one "${source_paths[$i]}" "${destination_paths[$i]}"; then
      printf 'OK       remote:%s matches source and is mode 600\n' "${destination_paths[$i]}"
    else
      printf 'BLOCKED  remote:%s failed integrity or metadata verification\n' "${destination_paths[$i]}" >&2
      failures=$((failures + 1))
    fi
  done
  (( failures == 0 )) || return 1
  printf 'VERIFIED workspace=%s entries=%d; no values or hashes were printed\n' "$workspace" "${#source_paths[@]}"
}

subcommand=${1:-}
manifest=${2:-}
[[ -n "$subcommand" && -n "$manifest" ]] || { usage >&2; exit 2; }
shift 2
load_manifest "$manifest"

case "$subcommand" in
  plan)
    (( $# == 0 )) || { usage >&2; exit 2; }
    run_plan
    ;;
  apply|verify)
    if [[ $subcommand == verify && $manifest_version != 3 ]]; then
      (( $# == 0 )) || { usage >&2; exit 2; }
      run_verify
      exit
    fi
    confirmation=''
    source_confirmation=''
    profile_confirmation=''
    origin_confirmation=''
    replace=false
    while (( $# > 0 )); do
      case "$1" in
        --confirm)
          (( $# >= 2 )) || fail '--confirm requires the exact workspace name'
          confirmation=$2
          shift 2
          ;;
        --replace)
          [[ $subcommand == apply ]] || fail '--replace is apply-only'
          replace=true
          shift
          ;;
        --confirm-profile)
          (( $# >= 2 )) || fail '--confirm-profile requires the exact selected profile'
          profile_confirmation=$2
          shift 2
          ;;
        --confirm-origin)
          (( $# >= 2 )) || fail '--confirm-origin requires the exact Coder origin'
          origin_confirmation=$2
          shift 2
          ;;
        --confirm-source)
          (( $# >= 2 )) || fail '--confirm-source requires the exact source workspace'
          source_confirmation=$2
          shift 2
          ;;
        *) fail "unknown apply option: $1" ;;
      esac
    done
    [[ "$confirmation" == "$workspace" ]] || fail "apply requires --confirm $workspace"
    [[ "$profile_confirmation" == "$REMOTE_DEV_PROFILE" ]] || \
      fail "apply requires --confirm-profile $REMOTE_DEV_PROFILE"
    [[ "$origin_confirmation" == "$coder_url" ]] || \
      fail "apply requires --confirm-origin $coder_url"
    if [[ $manifest_version == 3 ]]; then
      [[ $source_confirmation == "$source_workspace" ]] || fail "requires --confirm-source $source_workspace"
    else
      [[ -z $source_confirmation ]] || fail '--confirm-source requires manifest version 3'
    fi
    if [[ $subcommand == verify ]]; then
      run_verify
      exit
    fi
    run_plan
    printf 'APPLY    workspace=%s entries=%d replace=%s\n' "$workspace" "${#source_paths[@]}" "$replace"
    for ((i = 0; i < ${#source_paths[@]}; i++)); do
      upload_one "${source_paths[$i]}" "${destination_paths[$i]}" "$replace"
      if ! verify_one "${source_paths[$i]}" "${destination_paths[$i]}"; then
        fail "remote:${destination_paths[$i]} upload did not pass integrity and metadata verification"
      fi
      printf 'COPIED   remote:%s\n' "${destination_paths[$i]}"
    done
    run_verify
    ;;
  *) usage >&2; exit 2 ;;
esac
