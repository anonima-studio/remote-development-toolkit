#!/usr/bin/env bash
set -euo pipefail

ssh_options=(-o ControlMaster=no -o ControlPath=none -o ClearAllForwardings=yes)
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
helper="$repo_root/bin/remote-dev-credential-helper.py"

# shellcheck disable=SC1091
. "$repo_root/deploy/host-profiles/load.sh"
remote_dev_load_profile "$repo_root" "${REMOTE_DEV_PROFILE:-}"
host=$REMOTE_DEV_SSH_HOST

usage() {
  cat <<'EOF'
Usage: remote-dev [--profile <name>] credentials <command>

Commands:
  status
      Report bootstrap-file and application-account state separately.
  reveal <coder|coolify> [--consumer browser|app]
      Verify the bootstrap credential and expose it through a one-time local
      handoff. The protected server copy remains in place.
  provision coolify [--consumer browser|app]
      Create the first Coolify owner through the public onboarding route and
      expose its generated credential through a one-time local handoff.
  verify <coder|coolify>
      Verify the protected bootstrap credential against the public service.
  finalize <coder|coolify> --confirm-stored --receipt <sha256:...>
      Verify the exact revealed credential and login again, then remove only
      the matching bootstrap copy.

reveal/provision/verify/finalize require
  --confirm-profile <selected-profile>

The browser consumer is the operator fallback. The app consumer prints a
single-use loopback-session descriptor as JSON; the credential itself is
returned only once from that local endpoint with Accept: application/json.
EOF
}

remote_python() {
  local code=$1 command argument quoted
  shift
  printf -v command 'sudo python3 -c %q' "$code"
  for argument in "$@"; do
    printf -v quoted '%q' "$argument"
    command+=" $quoted"
  done
  ssh "${ssh_options[@]}" "$host" "$command"
}

configure_service() {
  service=$1
  case "$service" in
    coder)
      bootstrap_owner=dev
      bootstrap_path=/opt/remote-dev/coder/bootstrap-owner.env
      account_key=CODER_EMAIL
      password_key=CODER_PASSWORD
      access_url=$REMOTE_DEV_CODER_ACCESS_URL
      display_service="Coder — $REMOTE_DEV_PROFILE"
      ;;
    coolify)
      bootstrap_owner=root
      bootstrap_path=/root/.coolify-bootstrap-credentials
      account_key=ROOT_USER_EMAIL
      password_key=ROOT_USER_PASSWORD
      access_url=${REMOTE_DEV_COOLIFY_ACCESS_URL:-}
      [[ -n "$access_url" ]] || {
        printf 'ERROR    profile %s has no Coolify access URL\n' "$REMOTE_DEV_PROFILE" >&2
        exit 1
      }
      display_service="Coolify — $REMOTE_DEV_PROFILE"
      ;;
    *)
      echo 'ERROR    service must be coder or coolify' >&2
      exit 2
      ;;
  esac
}

extract_value() {
  local bundle=$1 key=$2 matches value
  matches=$(grep -c "^${key}=" <<<"$bundle" || true)
  [[ "$matches" == 1 ]] || {
    printf 'ERROR    credential bundle must contain exactly one %s\n' "$key" >&2
    exit 1
  }
  value=$(sed -n "s/^${key}=//p" <<<"$bundle")
  [[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\r'* ]] || {
    printf 'ERROR    credential bundle has an invalid %s\n' "$key" >&2
    exit 1
  }
  printf '%s' "$value"
}

bootstrap_state() {
  local code
  code=$(cat <<'PY'
# remote-dev-bootstrap-state
import os, pwd, stat, sys
owner, path = sys.argv[1:]
try:
    info = os.lstat(path)
except FileNotFoundError:
    print("absent")
    raise SystemExit(0)
valid = (
    stat.S_ISREG(info.st_mode)
    and not stat.S_ISLNK(info.st_mode)
    and info.st_uid == pwd.getpwnam(owner).pw_uid
    and stat.S_IMODE(info.st_mode) == 0o600
    and info.st_size > 0
)
print("present" if valid else "invalid")
PY
)
  remote_python "$code" "$bootstrap_owner" "$bootstrap_path"
}

bootstrap_read() {
  local code
  code=$(cat <<'PY'
# remote-dev-bootstrap-read
import os, pwd, stat, sys
owner, path = sys.argv[1:]
info = os.lstat(path)
if (
    not stat.S_ISREG(info.st_mode)
    or stat.S_ISLNK(info.st_mode)
    or info.st_uid != pwd.getpwnam(owner).pw_uid
    or stat.S_IMODE(info.st_mode) != 0o600
    or info.st_size == 0
):
    raise SystemExit("invalid protected bootstrap file")
with open(path, "rb") as source:
    sys.stdout.buffer.write(source.read())
PY
)
  remote_python "$code" "$bootstrap_owner" "$bootstrap_path"
}

bootstrap_write_exclusive() {
  local code
  code=$(cat <<'PY'
# remote-dev-bootstrap-write
import os, pwd, sys
owner, path = sys.argv[1:]
data = sys.stdin.buffer.read()
if not data:
    raise SystemExit("empty bootstrap input")
flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
fd = os.open(path, flags, 0o600)
try:
    os.fchmod(fd, 0o600)
    user = pwd.getpwnam(owner)
    os.fchown(fd, user.pw_uid, user.pw_gid)
    with os.fdopen(fd, "wb", closefd=False) as target:
        target.write(data)
        target.flush()
        os.fsync(target.fileno())
except BaseException:
    os.close(fd)
    os.unlink(path)
    raise
os.close(fd)
PY
)
  remote_python "$code" "$bootstrap_owner" "$bootstrap_path"
}

bootstrap_delete_if_equal() {
  local code
  code=$(cat <<'PY'
# remote-dev-bootstrap-delete-if-equal
import os, pwd, stat, sys
owner, path = sys.argv[1:]
expected = sys.stdin.buffer.read()
info = os.lstat(path)
if (
    not stat.S_ISREG(info.st_mode)
    or stat.S_ISLNK(info.st_mode)
    or info.st_uid != pwd.getpwnam(owner).pw_uid
    or stat.S_IMODE(info.st_mode) != 0o600
):
    raise SystemExit("invalid protected bootstrap file")
with open(path, "rb") as source:
    actual = source.read()
if actual != expected:
    raise SystemExit("bootstrap file changed after verification")
os.unlink(path)
PY
)
  remote_python "$code" "$bootstrap_owner" "$bootstrap_path"
}

application_state() {
  if [[ "$service" == coolify ]]; then
    if state=$(python3 "$helper" coolify-status --url "$access_url" 2>/dev/null); then
      printf '%s' "$state"
    else
      printf 'unknown'
    fi
  else
    printf 'unknown'
  fi
}

verify_login() {
  local account=$1 password=$2
  printf '%s\n%s\n' "$account" "$password" | \
    python3 "$helper" "$service-login" --url "$access_url"
}

reveal_secret() {
  local account=$1 password=$2 consumer=$3
  printf '%s\n%s\n' "$account" "$password" | \
    python3 "$helper" reveal \
      --profile "$REMOTE_DEV_PROFILE" \
      --service "$display_service" \
      --url "$access_url" \
      --consumer "$consumer"
}

credential_receipt() {
  local account=$1 password=$2
  printf '%s\n%s\n' "$account" "$password" | \
    python3 "$helper" receipt \
      --profile "$REMOTE_DEV_PROFILE" \
      --service "$display_service" \
      --url "$access_url"
}

parse_common_options() {
  consumer=browser
  confirmed_profile=''
  confirm_stored=false
  confirmed_receipt=''
  while (( $# > 0 )); do
    case "$1" in
      --consumer)
        [[ $# -ge 2 ]] || { usage >&2; exit 2; }
        consumer=$2
        shift 2
        ;;
      --confirm-profile)
        [[ $# -ge 2 ]] || { usage >&2; exit 2; }
        confirmed_profile=$2
        shift 2
        ;;
      --confirm-stored)
        confirm_stored=true
        shift
        ;;
      --receipt)
        [[ $# -ge 2 ]] || { usage >&2; exit 2; }
        confirmed_receipt=$2
        shift 2
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
  done
  [[ "$consumer" == browser || "$consumer" == app ]] || {
    echo 'ERROR    consumer must be browser or app' >&2
    exit 2
  }
}

require_profile_confirmation() {
  [[ "$confirmed_profile" == "$REMOTE_DEV_PROFILE" ]] || {
    printf 'ERROR    operation requires --confirm-profile %s\n' "$REMOTE_DEV_PROFILE" >&2
    exit 2
  }
}

load_bootstrap_credential() {
  bundle=$(bootstrap_read)
  account=$(extract_value "$bundle" "$account_key")
  password=$(extract_value "$bundle" "$password_key")
}

command=${1:-status}
shift || true
case "$command" in
  status)
    (( $# == 0 )) || { usage >&2; exit 2; }
    for selected_service in coder coolify; do
      if [[ "$selected_service" == coolify && -z "${REMOTE_DEV_COOLIFY_ACCESS_URL:-}" ]]; then
        printf 'coolify bootstrap=not-configured account=not-configured\n'
        continue
      fi
      configure_service "$selected_service"
      printf '%s bootstrap=%s account=%s\n' \
        "$service" "$(bootstrap_state)" "$(application_state)"
    done
    ;;
  reveal)
    [[ $# -ge 1 ]] || { usage >&2; exit 2; }
    configure_service "$1"
    shift
    parse_common_options "$@"
    require_profile_confirmation
    [[ "$confirm_stored" == false && -z "$confirmed_receipt" ]] || { usage >&2; exit 2; }
    load_bootstrap_credential
    verify_login "$account" "$password"
    reveal_secret "$account" "$password" "$consumer"
    unset account password bundle
    printf 'PENDING  bootstrap copy remains on %s until explicit finalize\n' "$host" >&2
    ;;
  provision)
    [[ ${1:-} == coolify ]] || { usage >&2; exit 2; }
    configure_service coolify
    shift
    parse_common_options "$@"
    require_profile_confirmation
    [[ "$confirm_stored" == false && -z "$confirmed_receipt" ]] || { usage >&2; exit 2; }
    current_bootstrap_state=$(bootstrap_state)
    current_account_state=$(application_state)
    case "$current_bootstrap_state:$current_account_state" in
      absent:absent)
        account=owner@remote-dev.local
        password=$(python3 - <<'PY'
import secrets
import string

symbols = "!@#$%^&*()-_=+"
groups = [string.ascii_lowercase, string.ascii_uppercase, string.digits, symbols]
value = [secrets.choice(group) for group in groups]
alphabet = "".join(groups)
value.extend(secrets.choice(alphabet) for _ in range(28))
secrets.SystemRandom().shuffle(value)
print("".join(value))
PY
)
        bundle=$(printf 'ROOT_USERNAME=Owner\nROOT_USER_EMAIL=%s\nROOT_USER_PASSWORD=%s\n' \
          "$account" "$password")
        printf '%s\n' "$bundle" | bootstrap_write_exclusive
        ;;
      present:absent)
        load_bootstrap_credential
        printf 'RESUME   retrying Coolify registration with the protected bootstrap credential\n' >&2
        ;;
      present:present)
        echo 'ERROR    Coolify owner already exists; use credentials reveal coolify' >&2
        exit 1
        ;;
      absent:present)
        echo 'ERROR    Coolify owner exists without a bootstrap copy; use account recovery' >&2
        exit 1
        ;;
      *)
        printf 'ERROR    cannot provision Coolify from bootstrap=%s account=%s\n' \
          "$current_bootstrap_state" "$current_account_state" >&2
        exit 1
        ;;
    esac
    printf '%s\n%s\n%s\n' Owner "$account" "$password" | \
      python3 "$helper" coolify-register --url "$access_url"
    verify_login "$account" "$password"
    reveal_secret "$account" "$password" "$consumer"
    unset account password bundle current_bootstrap_state current_account_state
    printf 'PENDING  Coolify owner works; save the revealed credential, then finalize\n' >&2
    ;;
  verify)
    [[ $# -ge 1 ]] || { usage >&2; exit 2; }
    configure_service "$1"
    shift
    parse_common_options "$@"
    require_profile_confirmation
    [[ "$consumer" == browser && "$confirm_stored" == false && -z "$confirmed_receipt" ]] || { usage >&2; exit 2; }
    load_bootstrap_credential
    verify_login "$account" "$password"
    unset account password bundle
    printf 'VERIFIED %s login\n' "$service"
    ;;
  finalize)
    [[ $# -ge 1 ]] || { usage >&2; exit 2; }
    configure_service "$1"
    shift
    parse_common_options "$@"
    require_profile_confirmation
    [[ "$consumer" == browser && "$confirm_stored" == true && -n "$confirmed_receipt" ]] || {
      printf 'ERROR    finalize requires --confirm-stored and --receipt\n' >&2
      exit 2
    }
    [[ "$confirmed_receipt" =~ ^sha256:[0-9a-f]{64}$ ]] || {
      printf 'ERROR    receipt must use sha256:<64-lowercase-hex>\n' >&2
      exit 2
    }
    load_bootstrap_credential
    actual_receipt=$(credential_receipt "$account" "$password")
    [[ "$confirmed_receipt" == "$actual_receipt" ]] || {
      printf 'ERROR    receipt does not match the current %s credential\n' "$service" >&2
      unset account password bundle actual_receipt
      exit 1
    }
    verify_login "$account" "$password"
    printf '%s\n' "$bundle" | bootstrap_delete_if_equal
    unset account password bundle actual_receipt
    printf 'FINALIZED %s bootstrap copy removed from %s\n' "$service" "$host"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
