# Synthetic test profile for the minimal topology: no public ingress (browser
# access through an SSH forward) and direct host egress.
REMOTE_DEV_PROFILE_NAME=example-direct
REMOTE_DEV_PROFILE_INGRESS=ssh-forward
REMOTE_DEV_PROFILE_EGRESS=host
REMOTE_DEV_PROFILE_SSH_HOST=example-direct
REMOTE_DEV_PROFILE_CODER_ACCESS_URL=http://127.0.0.1:3080
REMOTE_DEV_PROFILE_CODER_HOST_PORT=3080
REMOTE_DEV_PROFILE_EGRESS_SUBNET=10.232.10.0/24
REMOTE_DEV_PROFILE_EGRESS_GATEWAY=10.232.10.1
REMOTE_DEV_PROFILE_EGRESS_MTU=1500
REMOTE_DEV_PROFILE_CONTROL_SUBNET=10.232.11.0/24
