running_workspaces=$(docker ps --filter label=remote-dev.managed=true --format '{{.Names}}')
if [[ $egress == host ]]; then
  echo 'SKIP workspace VPN egress (host egress by profile)'
elif [[ -n "$running_workspaces" ]]; then
  ipv4_pattern='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
  host_ip=$(curl -4 -fsS --max-time 15 https://api.ipify.org || true)
  probe_workspace_egress() {
    printf '%s %s\n' "$1" \
      "$(docker exec "$1" curl -4 -fsS --max-time 8 https://api.ipify.org 2>/dev/null || true)"
  }
  export -f probe_workspace_egress
  workspace_egress=$(printf '%s\n' "$running_workspaces" |
    xargs -P 8 -I{} bash -c 'probe_workspace_egress "$1"' _ {})
  failed_workspaces=()
  exit_ips=()
  while read -r running_workspace workspace_ip; do
    if [[ $workspace_ip =~ $ipv4_pattern && $workspace_ip != "$host_ip" ]]; then
      exit_ips+=("$workspace_ip")
    else
      failed_workspaces+=("$running_workspace")
    fi
  done <<<"$workspace_egress"
  if [[ ! $host_ip =~ $ipv4_pattern ]]; then
    echo 'FAIL workspace VPN egress cannot be judged: the host address probe failed'
    failures=$((failures + 1))
  elif ((${#failed_workspaces[@]} > 0)); then
    echo "FAIL workspace VPN egress is unavailable or leaks through host: ${failed_workspaces[*]}"
    failures=$((failures + 1))
  else
    echo "OK   all ${#exit_ips[@]} running workspaces use a VPN egress distinct from the host ($(printf '%s\n' "${exit_ips[@]}" | sort -u | paste -sd, -))"
  fi
else
  echo 'SKIP workspace VPN egress (no running managed workspace)'
fi

sshd_effective=$(sudo sshd -T)
sshd_expected=(
  'permitrootlogin no'
  'passwordauthentication no'
  'kbdinteractiveauthentication no'
  'pubkeyauthentication yes'
  'allowusers dev'
  'maxauthtries 3'
)
sshd_failures=0
for expected in "${sshd_expected[@]}"; do
  if ! grep -qx "$expected" <<<"$sshd_effective"; then
    echo "FAIL effective sshd policy missing: $expected"
    sshd_failures=$((sshd_failures + 1))
  fi
done
if (( sshd_failures == 0 )); then
  echo 'OK   effective sshd authentication policy hardened'
else
  failures=$((failures + sshd_failures))
fi

ufw_status=$(sudo ufw status verbose)
if grep -qx 'Status: active' <<<"$ufw_status"; then
  echo 'OK   UFW active'
else
  echo 'FAIL UFW is not active'
  failures=$((failures + 1))
fi
if grep -q '^Default: deny (incoming),' <<<"$ufw_status"; then
  echo 'OK   UFW default denies inbound'
else
  echo 'FAIL UFW default inbound policy is not deny'
  failures=$((failures + 1))
fi
ufw_allows=$(awk '$2 == "ALLOW" || $3 == "ALLOW" {print $1}' <<<"$ufw_status" | sort -u)
if [[ "$ufw_allows" == '22/tcp' ]]; then
  echo 'OK   UFW allows only SSH inbound'
else
  echo "FAIL unexpected UFW allow rules: $ufw_allows"
  failures=$((failures + 1))
fi

classify_public_endpoints() {
  python3 -c '
import ipaddress
import sys

for endpoint in sys.stdin:
    endpoint = endpoint.strip()
    host, _, port = endpoint.rpartition(":")
    host = host.strip("[]").split("%", 1)[0]
    try:
        address = ipaddress.ip_address(host)
    except ValueError:
        continue
    if address.is_unspecified:
        print(f"{host}:{port}")
        continue
    if address.is_loopback or address.is_private:
        continue
    print(f"{host}:{port}")
' 
}

coolify_proxy_verified=$({
  sudo docker inspect coolify-proxy 2>/dev/null || printf '%s\n' '[]'
} | python3 -c '
import json, sys
try:
    containers = json.load(sys.stdin)
    container = containers[0]
    labels = container["Config"]["Labels"]
    bindings = container["HostConfig"]["PortBindings"]
    networks = container["NetworkSettings"]["Networks"]
    expected = {"80/tcp": "80", "443/tcp": "443", "443/udp": "443"}
    actual = {
        port: entries[0].get("HostPort")
        for port, entries in bindings.items()
        if isinstance(entries, list) and len(entries) == 1
    }
    valid = (
        len(containers) == 1
        and container["State"]["Running"] is True
        and container["State"].get("Health", {}).get("Status") == "healthy"
        and labels.get("coolify.managed") == "true"
        and labels.get("coolify.proxy") == "true"
        and labels.get("com.docker.compose.project") == "coolify-proxy"
        and labels.get("com.docker.compose.service") == "traefik"
        and "coolify" in networks
        and not ({"remote-dev-control", "remote-dev-egress"} & set(networks))
        and not any(name.startswith("coder-") or name.startswith("remote-dev-") for name in networks)
        and actual == expected
    )
    print("true" if valid else "false")
except (KeyError, IndexError, TypeError, json.JSONDecodeError):
    print("false")
')
public_listeners=$(sudo ss -H -lnt | awk '{print $4}' | classify_public_endpoints | sort -u)
if [[ "$coolify_proxy_verified" == 'true' ]]; then
  expected_public_tcp=$(printf '%s\n' \
    '0.0.0.0:22' '0.0.0.0:80' '0.0.0.0:443' \
    ':::22' ':::80' ':::443' | sort -u)
  expected_public_tcp_message='SSH and the Coolify proxy own wildcard TCP listeners'
else
  expected_public_tcp=$(printf '%s\n' '0.0.0.0:22' ':::22' | sort -u)
  expected_public_tcp_message='only SSH listens on wildcard addresses'
fi
if [[ "$public_listeners" == "$expected_public_tcp" ]]; then
  echo "OK   $expected_public_tcp_message"
else
  echo "FAIL unexpected public TCP listeners: $public_listeners"
  failures=$((failures + 1))
fi

public_udp=$(sudo ss -H -lnu | awk '{print $4}' | classify_public_endpoints | sort -u)
wireguard_port=$(sudo wg show "$wireguard_interface" listen-port 2>/dev/null || true)
expected_public_udp=()
if [[ -n "$wireguard_port" ]]; then
  expected_public_udp+=("0.0.0.0:$wireguard_port" ":::$wireguard_port")
fi
if [[ "$coolify_proxy_verified" == 'true' ]]; then
  expected_public_udp+=('0.0.0.0:443' ':::443')
fi
expected_public_udp_value=$(printf '%s\n' "${expected_public_udp[@]}" | sed '/^$/d' | sort -u)
if [[ "$public_udp" == "$expected_public_udp_value" ]]; then
  if [[ "$coolify_proxy_verified" == 'true' ]]; then
    echo 'OK   only Coolify HTTP/3 and WireGuard use wildcard UDP'
  elif [[ -n "$wireguard_port" ]]; then
    echo 'OK   only WireGuard client socket uses wildcard UDP'
  else
    echo 'OK   no public UDP listeners'
  fi
else
  echo "FAIL unexpected public UDP listeners: $public_udp"
  failures=$((failures + 1))
fi

exit "$failures"
