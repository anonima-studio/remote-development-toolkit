REMOTE_DEV_PROFILE_CLOUDFLARE_CREDENTIALS="$HOME/.config/remote-dev/example-profile/cloudflared.json"
REMOTE_DEV_PROFILE_WIREGUARD_ADDRESS=10.231.0.2/32
