    ;;
  codex)
    shift
    run_workspace_codex "$@"
    ;;
  codex-desktop)
    shift
    exec "$repo_root/bin/remote-dev-codex-desktop" \
      --profile "$REMOTE_DEV_PROFILE" \
      --coder-url "$REMOTE_DEV_CODER_ACCESS_URL" \
      "$@"
    ;;
  codex-update)
    shift
    exec python3 -B "$repo_root/bin/remote-dev-codex-update.py" --profile "$REMOTE_DEV_PROFILE" "$@"
    ;;
  pids-rollout)
    shift
    workspace=${1:-}
    [[ $workspace =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
      echo 'pids-rollout requires one workspace name' >&2
      exit 2
    }
    shift
    printf -v rollout_command '%q ' sudo python3 - --workspace "$workspace" \
      --coder-url "$REMOTE_DEV_CODER_ACCESS_URL" --port "$REMOTE_DEV_CODER_HOST_PORT" "$@"
    exec ssh "${ssh_options[@]}" "$host" "$rollout_command" < "$repo_root/deploy/pids-rollout.py"
    ;;
  workspace)
    shift
    exec "$repo_root/bin/remote-dev-workspace" \
      --profile "$REMOTE_DEV_PROFILE" \
      --coder-url "$REMOTE_DEV_CODER_ACCESS_URL" \
      "$@"
    ;;
  local-agent)
    shift
    case "${1:-}" in
      install)
        shift
        run_local_agent_install "$@"
        ;;
      uninstall)
        shift
        run_local_agent_uninstall "$@"
        ;;
      '')
        "$repo_root/bin/remote-dev-local-agent" --help >&2
        exit 2
        ;;
      *)
        local_agent_context_bound=false
        for local_agent_argument in "$@"; do
          case "$local_agent_argument" in
            --for-context|--for-root) local_agent_context_bound=true ;;
          esac
        done
        if [[ $profile_explicit == true || $local_agent_context_bound == false ]]; then
          [[ -n $profile ]] || remote_dev_load_profile "$repo_root" ''
          exec "$repo_root/bin/remote-dev-local-agent" \
            --profile "$REMOTE_DEV_PROFILE" \
            --coder-url "$REMOTE_DEV_CODER_ACCESS_URL" \
            "$@"
        fi
        exec "$repo_root/bin/remote-dev-local-agent" "$@"
        ;;
    esac
    ;;
  mode)
    shift
    if [[ $profile_explicit == true ]]; then
      exec python3 "$repo_root/bin/remote-dev-mode" \
        --profile "$REMOTE_DEV_PROFILE" --coder-url "$REMOTE_DEV_CODER_ACCESS_URL" "$@"
    fi
    exec python3 "$repo_root/bin/remote-dev-mode" "$@"
    ;;
  project-setup)
    shift
    run_project_setup "$@"
    ;;
  worktree-vars)
    shift
    run_worktree_vars "$@"
    ;;
  preview)
    shift
    run_workspace_preview "$@"
    ;;
  debug-forward)
    shift
    run_workspace_debug_forward "$@"
    ;;
  credentials)
    shift
    exec "$repo_root/bin/remote-dev-credentials" "$@"
    ;;
  token-update)
    token=$(tr -d '\r\n')
    if [[ -z "$token" ]]; then
      echo 'token-update requires a Coder session token on stdin' >&2
      exit 2
    fi
    printf '%s\n' "$token" | remote 'umask 077; temp=$(mktemp); trap '\''rm -f "$temp"'\'' EXIT; cat > "$temp"; install -m 0600 "$temp" /opt/remote-dev/coder/operator.session'
    echo 'operator session updated'
    ;;
  forward)
    if [[ $REMOTE_DEV_INGRESS == ssh-forward ]]; then
      local_port=${REMOTE_DEV_CODER_ACCESS_URL##*:}
      printf 'Forwarding %s to Coder on %s; keep this command running.\n' \
        "$REMOTE_DEV_CODER_ACCESS_URL" "$REMOTE_DEV_PROFILE"
      exec ssh -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -N \
        -L "127.0.0.1:$local_port:127.0.0.1:$REMOTE_DEV_CODER_HOST_PORT" "$host"
    fi
    exec ssh -N "$host"
    ;;
  init|quickstart)
    exec "$repo_root/bin/remote-dev-quickstart" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
