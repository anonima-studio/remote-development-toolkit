# Synthetic test profile for the Cloudflare Tunnel + WireGuard topology.
# Every value is fictional; none identifies a real host.
REMOTE_DEV_PROFILE_NAME=example-profile
REMOTE_DEV_PROFILE_INGRESS=cloudflare-tunnel
